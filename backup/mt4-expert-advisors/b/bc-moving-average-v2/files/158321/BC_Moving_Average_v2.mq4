#property copyright "Copyright © 2025, Gehtsoft USA LLC"
#property link      "http://fxcodebase.com"
#property version "1.0"

#property indicator_chart_window
#property indicator_buffers 1
#property indicator_color1 Red

enum ENUM_UPDATE_MODE { UPDATE_TICK };

extern int                MA_Period = 13;
extern int                MA_Shift  = 0;
extern ENUM_APPLIED_PRICE ApplyTo   = PRICE_CLOSE;

double EmaBuffer[];
int    ExtCountedBars = 0;

class CNewCandle
{
 private:
  int    _initialCandles;
  string _symbol;
  int    _tf;

 public:
  CNewCandle(string symbol, int tf) : _symbol(symbol), _tf(tf), _initialCandles(iBars(symbol, tf)) {}
  CNewCandle()
  {
    // toma los valores del chart actual
    _initialCandles = iBars(Symbol(), Period());
    _symbol         = Symbol();
    _tf             = Period();
  }
  ~CNewCandle() { ; }

  bool IsNewCandle()
  {
    int _currentCandles = iBars(_symbol, _tf);
    if (_currentCandles > _initialCandles)
    {
      _initialCandles = _currentCandles;
      return true;
    }

    return false;
  }
};
CNewCandle newCandle();

int init()
{
    SetIndexStyle(0, DRAW_LINE);
    SetIndexShift(0, MA_Shift);
    IndicatorDigits(MarketInfo(Symbol(), MODE_DIGITS));
    if (MA_Period < 1) MA_Period = 1;
    IndicatorShortName("EMA(" + MA_Period + ")");
    SetIndexDrawBegin(0, MA_Period);
    SetIndexBuffer(0, EmaBuffer);
    ArrayInitialize(EmaBuffer, EMPTY_VALUE);
    return (0);
}



int OnCalculate(const int rates_total, const int prev_calculated, const datetime &time[], const double &open[], const double &high[], const double &low[], const double &close[],
    const long &tick_volume[], const long &volume[], const int &spread[])
{
int start, i;
  if (prev_calculated == 0)
  {
    start = rates_total - MA_Period;
  } else
  {
    start = rates_total - (prev_calculated - 1);
  }
  
  for (i = start; i >= 0; i--)
  {
        if(i > 0) EmaBuffer[i] = iMA(NULL, 0, MA_Period, 0, MODE_EMA, ApplyTo, i);
        
        if(i == 0)
        if(newCandle.IsNewCandle())
        {
            EmaBuffer[i] = iMA(NULL, 0, MA_Period, 0, MODE_EMA, ApplyTo, i);
        }

  }
}
