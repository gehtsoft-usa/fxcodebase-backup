#ifndef FloatStream_IMPL
#define FloatStream_IMPL


// Float stream v2.3

class FloatStream : public AStreamBase
{
   string _symbol;
   ENUM_TIMEFRAMES _timeframe;
   double _stream[];
public:
   FloatStream(const string symbol, const ENUM_TIMEFRAMES timeframe)
   {
      _symbol = symbol;
      _timeframe = timeframe;
   }

   void Init()
   {
      ArrayInitialize(_stream, EMPTY_VALUE);
   }

   virtual int Size()
   {
      return iBars(_symbol, _timeframe);
   }

   void SetValue(const int period, double value)
   {
      int totalBars = Size();
      int index = totalBars - period - 1;
      if (index < 0 || totalBars <= index)
      {
         return;
      }
      EnsureStreamHasProperSize(totalBars);
      _stream[index] = value;
   }

   bool GetValue(const int period, double &val)
   {
      int totalBars = Size();
      int index = totalBars - period - 1;
      if (index < 0 || totalBars <= index)
      {
         return false;
      }
      EnsureStreamHasProperSize(totalBars);
      
      val = _stream[index];
      return _stream[index] != EMPTY_VALUE;
   }
private:
   void EnsureStreamHasProperSize(int size)
   {
      int currentSize = ArrayRange(_stream, 0);
      if (currentSize != size) 
      {
         ArrayResize(_stream, size);
         for (int i = currentSize; i < size; ++i)
         {
            _stream[i] = EMPTY_VALUE;
         }
      }
   }
};

#endif
// Change stream v1.1

#ifndef ChangeStream_IMP
#define ChangeStream_IMP


//Base implementation of stream based on another stream 
//v1.1

class AOnStream : public IStream
{
protected:
   IStream *_source;
   int _references;
public:
   AOnStream(IStream *source)
   {
      _references = 1;
      _source = source;
      if (_source != NULL)
      {
         _source.AddRef();
      }
   }

   ~AOnStream()
   {
      _source.Release();
   }
   
   void AddRef()
   {
      ++_references;
   }

   void Release()
   {
      --_references;
      if (_references == 0)
         delete &this;
   }

   virtual int Size()
   {
      return _source.Size();
   }
};
// v1.0
// Wraps IIntStream and provides IStream

#ifndef IntToFloatStreamWrapper_IMPL
#define IntToFloatStreamWrapper_IMPL
// Abstract float stream v1.0

#ifndef AFloatStream_IMPL
#define AFloatStream_IMPL


class AFloatStream : public IStream
{
   int _refs;   
public:
   AFloatStream()
   {
      _refs = 1;
   }

   void AddRef()
   {
      _refs++;
   }
   void Release()
   {
      if (--_refs == 0)
      {
         delete &this;
      }
   }
};

#endif
// Integer Stream v.1.0

#ifndef IIntStream_IMPL
#define IIntStream_IMPL

interface IIntStream
{
public:
   virtual void AddRef() = 0;
   virtual void Release() = 0;
   virtual int Size() = 0;

   virtual bool GetValue(const int period, int &val) = 0;
};

#endif

class IntToFloatStreamWrapper : public AFloatStream
{
   IIntStream* _source;
public:
   IntToFloatStreamWrapper(IIntStream* source)
   {
      _source = source;
      _source.AddRef();
   }
   ~IntToFloatStreamWrapper()
   {
      _source.Release();
   }

   int Size()
   {
      return _source.Size();
   }
   bool GetValue(const int period, double &val)
   {
      int intVal;
      if (!_source.GetValue(period, intVal))
      {
         return false;
      }
      val = intVal;
      return true;
   }
};
#endif

class ChangeStream : public AOnStream
{
   int _period;
public:
   ChangeStream(IStream* stream, int period = 1)
      :AOnStream(stream)
   {
      _period = period;
   }
   ChangeStream(IIntStream* stream, int period = 1)
      :AOnStream(new IntToFloatStreamWrapper(stream))
   {
      _source.Release();
      _period = period;
   }
   
   virtual bool GetValue(const int period, double &val)
   {
      double src1, src2;
      if (!_source.GetValue(period, src1) || !_source.GetValue(period + _period, src2))
      {
         return false;
      }
      val = src1 - src2;
      return true;
   }
};

#endif


// True range stream v2.2

#ifndef TrueRangeStream_IMP
#define TrueRangeStream_IMP

class TrueRangeStream : public AStream
{
   bool _handleNa;
public:
   TrueRangeStream(const string symbol, ENUM_TIMEFRAMES timeframe, bool handleNa = false)
      :AStream(symbol, timeframe)
   {
      _handleNa = handleNa;
   }

   bool GetValue(const int period, double &val)
   {
      int pos = Size() - period - 1;
      if (pos < 1)
      {
         if (_handleNa)
         {
            val = CalcFirst(pos);
            return true;
         }
         return false;
      }
      double h = iHigh(_symbol, _timeframe, period);
      double l = iLow(_symbol, _timeframe, period);
      double c1 = iClose(_symbol, _timeframe, period + 1);
      double hl = MathAbs(h - l);
      double hc = MathAbs(h - c1);
      double lc = MathAbs(l - c1);

      val = MathMax(lc, MathMax(hl, hc));
      return true;
   }
private:
   double CalcFirst(int pos)
   {
      double hl = MathAbs(iHigh(_symbol, _timeframe, pos) - iLow(_symbol, _timeframe, pos));
      double hc = MathAbs(iHigh(_symbol, _timeframe, pos) - iOpen(_symbol, _timeframe, pos));
      double lc = MathAbs(iLow(_symbol, _timeframe, pos) - iOpen(_symbol, _timeframe, pos));

      return MathMax(lc, MathMax(hl, hc));
   }
};
#endif


//RmaOnStream v1.0

#ifndef RmaOnStream_IMP
#define RmaOnStream_IMP

class RmaOnStream : public AOnStream
{
   double _length;
   double _buffer[];
public:
   RmaOnStream(IStream *source, const int length)
      :AOnStream(source)
   {
      _length = length;
   }

   bool GetValue(const int period, double &val)
   {
      int size = Size();
      double price;
      if (!_source.GetValue(period, price))
         return false;

      int currentSize = ArrayRange(_buffer, 0);
      if (currentSize < size)
      {
         ArrayResize(_buffer, size);
         for (int i = currentSize; i < size; ++i)
         {
            _buffer[i] = EMPTY_VALUE;
         }
      }

      double alpha = 1.0 / _length;
      int index = size - 1 - period;
      if (index == 0 || _buffer[index - 1] == EMPTY_VALUE)
      {
         _buffer[index] = price;
      }
      else
      {
         _buffer[index] =  alpha * price + (1 - alpha) * _buffer[index - 1];
      }
      val = _buffer[index];
      return true;
   }
};

#endif
input bool param1 = true; // range bound %
input bool param2 = false; // show True RSI (Works Only in range bound mode)
input bool param3 = false; // show volume weighted True RSI (works only in range bound mode)
input PriceType param4 = PriceClose; // RSIs' source
input int param5 = 14; // length
input double param6 = 0.0; // A/D weight (at 1 all volume is included)
input bool param7 = false; // factor price (money flow)
input int bars_limit = 100000; // Bars limit
int range;
int RSI_enabe;
int VW_RSI_enable;
IStream* param4Stream;
IStream* src;
int len;
double AD_weight;
int price_enable;
FloatStream* change1Source;
ChangeStream* change1;
TrueRangeStream* tr1;
FloatStream* rma1Source;
RmaOnStream* rma1;
FloatStream* rma2Source;
RmaOnStream* rma2;
FloatStream* change2Source;
ChangeStream* change2;
FloatStream* rma3Source;
RmaOnStream* rma3;
FloatStream* rma4Source;
RmaOnStream* rma4;
FloatStream* rma5Source;
RmaOnStream* rma5;
FloatStream* rma6Source;
RmaOnStream* rma6;
double plot1[];
double plot2[];
double plot3[];
double plot4[];
double plot5[];
double plot6[];

string IndicatorObjPrefix;

bool NamesCollision(const string name)
{
   for (int k = ObjectsTotal(); k >= 0; k--)
   {
      if (StringFind(ObjectName(0, k), name) == 0)
      {
         return true;
      }
   }
   return false;
}

string GenerateIndicatorPrefix(const string target)
{
   for (int i = 0; i < 1000; ++i)
   {
      string prefix = target + "_" + IntegerToString(i);
      if (!NamesCollision(prefix))
      {
         return prefix;
      }
   }
   return target;
}

int init()
{
   IndicatorBuffers(6);
   int id = 0;
   range = param1;
   RSI_enabe = param2;
   VW_RSI_enable = param3;
   param4Stream = PriceStreamFactory::Create(_Symbol, (ENUM_TIMEFRAMES)_Period, param4);
   src = param4Stream;
   len = param5;
   AD_weight = param6;
   price_enable = param7;
   change1Source = new FloatStream(_Symbol, (ENUM_TIMEFRAMES)_Period);
   change1 = new ChangeStream(change1Source, 1);
   tr1 = new TrueRangeStream(_Symbol, (ENUM_TIMEFRAMES)_Period, true);
   rma1Source = new FloatStream(_Symbol, (ENUM_TIMEFRAMES)_Period);
   rma1 = new RmaOnStream(rma1Source, len);
   rma2Source = new FloatStream(_Symbol, (ENUM_TIMEFRAMES)_Period);
   rma2 = new RmaOnStream(rma2Source, len);
   change2Source = new FloatStream(_Symbol, (ENUM_TIMEFRAMES)_Period);
   change2 = new ChangeStream(change2Source, 1);
   rma3Source = new FloatStream(_Symbol, (ENUM_TIMEFRAMES)_Period);
   rma3 = new RmaOnStream(rma3Source, len);
   rma4Source = new FloatStream(_Symbol, (ENUM_TIMEFRAMES)_Period);
   rma4 = new RmaOnStream(rma4Source, len);
   rma5Source = new FloatStream(_Symbol, (ENUM_TIMEFRAMES)_Period);
   rma5 = new RmaOnStream(rma5Source, len);
   rma6Source = new FloatStream(_Symbol, (ENUM_TIMEFRAMES)_Period);
   rma6 = new RmaOnStream(rma6Source, len);
   SetIndexBuffer(id++, plot1);
   SetIndexBuffer(id++, plot2);
   SetIndexBuffer(id++, plot3);
   SetIndexBuffer(id++, plot4);
   SetIndexBuffer(id++, plot5);
   SetIndexBuffer(id++, plot6);
   IndicatorObjPrefix = GenerateIndicatorPrefix("ADP [cI8DH]");
   IndicatorShortName("Accumulation/Distribution Percentage (ADP) [cI8DH]");
   return INIT_SUCCEEDED;
}

int deinit()
{
   ObjectsDeleteAll(ChartID(), IndicatorObjPrefix);
   param4Stream.Release();
   change1Source.Release();
   change1.Release();
   tr1.Release();
   rma1Source.Release();
   rma1.Release();
   rma2Source.Release();
   rma2.Release();
   change2Source.Release();
   change2.Release();
   rma3Source.Release();
   rma3.Release();
   rma4Source.Release();
   rma4.Release();
   rma5Source.Release();
   rma5.Release();
   rma6Source.Release();
   rma6.Release();
   return 0;
}

int OnCalculate(const int rates_total,
                const int prev_calculated,
                const datetime &time[],
                const double &open[],
                const double &high[],
                const double &low[],
                const double &close[],
                const long &tick_volume[],
                const long &volume[],
                const int &spread[])
{
   if (prev_calculated <= 0 || prev_calculated > rates_total)
   {
      change1Source.Init();
      rma1Source.Init();
      rma2Source.Init();
      change2Source.Init();
      rma3Source.Init();
      rma4Source.Init();
      rma5Source.Init();
      rma6Source.Init();
      ArrayInitialize(plot1, EMPTY_VALUE);
      ArrayInitialize(plot2, EMPTY_VALUE);
      ArrayInitialize(plot3, EMPTY_VALUE);
      ArrayInitialize(plot4, EMPTY_VALUE);
      ArrayInitialize(plot5, EMPTY_VALUE);
      ArrayInitialize(plot6, EMPTY_VALUE);
   }
   bool timeSeries = ArrayGetAsSeries(time);
   bool openSeries = ArrayGetAsSeries(open);
   bool highSeries = ArrayGetAsSeries(high);
   bool lowSeries = ArrayGetAsSeries(low);
   bool closeSeries = ArrayGetAsSeries(close);
   bool tickVolumeSeries = ArrayGetAsSeries(tick_volume);
   ArraySetAsSeries(time, true);
   ArraySetAsSeries(open, true);
   ArraySetAsSeries(high, true);
   ArraySetAsSeries(low, true);
   ArraySetAsSeries(close, true);
   ArraySetAsSeries(tick_volume, true);

   int toSkip = 0;
   for (int pos = MathMin(bars_limit, rates_total - 1 - MathMax(prev_calculated - 1, toSkip)); pos >= 0 && !IsStopped(); --pos)
   {
      change1Source.SetValue(pos, close[pos]);
      double change1Value;
      if (!change1.GetValue(pos, change1Value)) { change1Value = EMPTY_VALUE; }
      double tr1Value;
      if (!tr1.GetValue(pos, tr1Value)) { tr1Value = EMPTY_VALUE; }
      double AD_ratio = Nz(SafeDivide(change1Value, tr1Value));
      AD_ratio = SafePlus(SafeMultiply((1 - AD_weight), AD_ratio), SafeMultiply(SafeSign(AD_ratio), AD_weight));
      if (pos + 1 > (rates_total - 1)) { continue; }
      double trl = SafeMathMin(low[pos], close[pos + 1]);
      if (pos + 1 > (rates_total - 1)) { continue; }
      double trh = SafeMathMax(high[pos], close[pos + 1]);
      double vol = EMPTY_VALUE;
      if (price_enable)
      {
         vol = tick_volume[pos] * SafeDivide((high[pos] + low[pos] + close[pos]), 3);
      }
      else
      {
         vol = tick_volume[pos];
      }
      double AD = SafeMultiply(vol, AD_ratio);
      rma1Source.SetValue(pos, AD);
      double rma1Value;
      if (!rma1.GetValue(pos, rma1Value)) { rma1Value = EMPTY_VALUE; }
      double AD_MA = rma1Value;
      double ADP = EMPTY_VALUE;
      if (range)
      {
         rma2Source.SetValue(pos, SafeMathAbs(AD));
         double rma2Value;
         if (!rma2.GetValue(pos, rma2Value)) { rma2Value = EMPTY_VALUE; }
         ADP = SafeMultiply(50, (SafePlus(1, SafeDivide(AD_MA, rma2Value))));
      }
      else
      {
         ADP = AD_MA;
      }
      double gain_loss = EMPTY_VALUE;
      if (range && ((RSI_enabe || VW_RSI_enable)))
      {
         double srcValue;
         if (!src.GetValue(pos, srcValue)) { srcValue = EMPTY_VALUE; }
         change2Source.SetValue(pos, srcValue);
         double change2Value;
         if (!change2.GetValue(pos, change2Value)) { change2Value = EMPTY_VALUE; }
         double srcValue_1;
         if (!src.GetValue(pos + 1, srcValue_1)) { srcValue_1 = EMPTY_VALUE; }
         gain_loss = SafeDivide(change2Value, SafeDivide((SafePlus(srcValue, srcValue_1)), 2));
      }
      double RSI = EMPTY_VALUE;
      if (RSI_enabe && range)
      {
         rma3Source.SetValue(pos, gain_loss);
         double rma3Value;
         if (!rma3.GetValue(pos, rma3Value)) { rma3Value = EMPTY_VALUE; }
         rma4Source.SetValue(pos, SafeMathAbs(gain_loss));
         double rma4Value;
         if (!rma4.GetValue(pos, rma4Value)) { rma4Value = EMPTY_VALUE; }
         RSI = SafeMultiply(50, (SafePlus(1, SafeDivide(rma3Value, rma4Value))));
      }
      double VW_RSI = EMPTY_VALUE;
      if (range && VW_RSI_enable)
      {
         double AD_gl = SafeMultiply(SafeMathAbs(AD), gain_loss);
         rma5Source.SetValue(pos, AD_gl);
         double rma5Value;
         if (!rma5.GetValue(pos, rma5Value)) { rma5Value = EMPTY_VALUE; }
         rma6Source.SetValue(pos, SafeMathAbs(AD_gl));
         double rma6Value;
         if (!rma6.GetValue(pos, rma6Value)) { rma6Value = EMPTY_VALUE; }
         VW_RSI = SafeMultiply(50, (SafePlus(1, SafeDivide(rma5Value, rma6Value))));
      }
      plot1[pos] = ADP;
      plot2[pos] = VW_RSI;
      plot3[pos] = RSI;
      plot4[pos] = (range ? 50 : 0);
      plot5[pos] = (range ? 30 : INT_MIN);
      double b1 = plot5[pos];
      plot6[pos] = (range ? 70 : INT_MIN);
      double b2 = plot6[pos];
   }

   ArraySetAsSeries(time, timeSeries);
   ArraySetAsSeries(open, openSeries);
   ArraySetAsSeries(high, highSeries);
   ArraySetAsSeries(low, lowSeries);
   ArraySetAsSeries(close, closeSeries);
   ArraySetAsSeries(tick_volume, tickVolumeSeries);
   return rates_total;
}
