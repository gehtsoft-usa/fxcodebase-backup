   string IndicatorObjPrefix;
public:
   Mode_1Stream(string modeSwitch, int len, string indicatorObjPrefix)
   {
      _initialized = false;
      IndicatorObjPrefix = indicatorObjPrefix;
      this.modeSwitch = modeSwitch;
      this.len = len;
   }
   ~Mode_1Stream()
   {
      delete HMA_11;
      delete EHMA_12;
      delete THMA_13;
   }
   int Init(int id)
   {
      HMA_11 = new HMA_1Stream(len, IndicatorObjPrefix + "_1");
      id = HMA_11.Init(id);
      EHMA_12 = new EHMA_1Stream(len, IndicatorObjPrefix + "_2");
      id = EHMA_12.Init(id);
      THMA_13 = new THMA_1Stream(SafeDivide(len, 2), IndicatorObjPrefix + "_3");
      id = THMA_13.Init(id);
      return id;
   }
   void Clear()
   {
      _initialized = false;
   }
   bool GetValue(const int pos, double __src, double &__out1)
   {
      if (!_initialized)
      {
         HMA_11.Clear();
         EHMA_12.Clear();
         THMA_13.Clear();
         _initialized = true;
      }
      double src = __src;
      double HMA_11Value;
      if (!HMA_11.GetValue(pos, src, HMA_11Value)) { HMA_11Value = EMPTY_VALUE; }
      double EHMA_12Value;
      if (!EHMA_12.GetValue(pos, src, EHMA_12Value)) { EHMA_12Value = EMPTY_VALUE; }
      double THMA_13Value;
      if (!THMA_13.GetValue(pos, src, THMA_13Value)) { THMA_13Value = EMPTY_VALUE; }
      __out1 = ((modeSwitch == "Hma") ? HMA_11Value : ((modeSwitch == "Ehma") ? EHMA_12Value : ((modeSwitch == "Thma") ? THMA_13Value : EMPTY_VALUE)));
      return true;
   }
};
Mode_1Stream* Mode_14;
double HULL[];
double HULL_DEFAULT_VALUE;
ColoredStream* plot1;
ColoredStream* plot4;
CandleStreams* barcolor1;

string IndicatorObjPrefix;

bool NamesCollision(const string name)
{
   for (int k = ObjectsTotal(); k >= 0; k--)
   {
      if (StringFind(ObjectName(0, k), name) == 0)
      {
         return true;
      }
   }
   return false;
}

string GenerateIndicatorPrefix(string target)
{
   if (StringLen(target) > 20)
   {
      target = StringSubstr(target, 0, 20);
   }
   for (int i = 0; i < 1000; ++i)
   {
      string prefix = target + "_" + IntegerToString(i);
      if (!NamesCollision(prefix))
      {
         return prefix;
      }
   }
   return target;
}

int init()
{
   IndicatorBuffers(21);
   param1Stream = PriceStreamFactory::Create(_Symbol, (ENUM_TIMEFRAMES)_Period, param1);
   src = param1Stream;
   modeSwitch = Get_param2();
   length = param3;
   switchColor = param4;
   candleCol = param5;
   visualSwitch = param6;
   thicknesSwitch = param7;
   transpSwitch = param8;
   int id = 0;
   plot1 = new ColoredStream(_Symbol, (ENUM_TIMEFRAMES)_Period);
   id = plot1.RegisterStream(id, 0x00ff00, "MHULL", DRAW_LINE, STYLE_SOLID, thicknesSwitch);
   id = plot1.RegisterStream(id, 0x0000ff, "MHULL", DRAW_LINE, STYLE_SOLID, thicknesSwitch);
   id = plot1.RegisterStream(id, 0x0098ff, "MHULL", DRAW_LINE, STYLE_SOLID, thicknesSwitch);
   plot4 = new ColoredStream(_Symbol, (ENUM_TIMEFRAMES)_Period);
   id = plot4.RegisterStream(id, 0x00ff00, "SHULL", DRAW_LINE, STYLE_SOLID, thicknesSwitch);
   id = plot4.RegisterStream(id, 0x0000ff, "SHULL", DRAW_LINE, STYLE_SOLID, thicknesSwitch);
   id = plot4.RegisterStream(id, 0x0098ff, "SHULL", DRAW_LINE, STYLE_SOLID, thicknesSwitch);
   barcolor1 = new CandleStreams();
   barcolor1.SetOffset(0);
   id = barcolor1.RegisterStreams(id, 0x00ff00);
   id = barcolor1.RegisterStreams(id, 0x0000ff);
   id = barcolor1.RegisterStreams(id, 0x0098ff);
   IndicatorObjPrefix = GenerateIndicatorPrefix("");
   IndicatorShortName("Belkhayate Iceberg 2.0");
   Mode_14 = new Mode_1Stream(modeSwitch, length, IndicatorObjPrefix + "_4");
   id = Mode_14.Init(id);
   SetIndexBuffer(id++, HULL);
   id = plot1.RegisterInternalStream(id);
   id = plot4.RegisterInternalStream(id);
   return INIT_SUCCEEDED;
}

int deinit()
{
   ObjectsDeleteAll(ChartID(), IndicatorObjPrefix);
   param1Stream.Release();
   delete Mode_14;
   delete plot1;
   delete plot4;
   delete barcolor1;
   return 0;
}

int OnCalculate(const int rates_total,
                const int prev_calculated,
                const datetime &time[],
                const double &open[],
                const double &high[],
                const double &low[],
                const double &close[],
                const long &tick_volume[],
                const long &volume[],
                const int &spread[])
{
   if (prev_calculated <= 0 || prev_calculated > rates_total)
   {
      Mode_14.Clear();
      HULL_DEFAULT_VALUE = EMPTY_VALUE;
      ArrayInitialize(HULL, HULL_DEFAULT_VALUE);
      plot1.Init(EMPTY_VALUE);
      plot4.Init(EMPTY_VALUE);
      barcolor1.Init();
   }
   bool timeSeries = ArrayGetAsSeries(time);
   bool openSeries = ArrayGetAsSeries(open);
   bool highSeries = ArrayGetAsSeries(high);
   bool lowSeries = ArrayGetAsSeries(low);
   bool closeSeries = ArrayGetAsSeries(close);
   bool tickVolumeSeries = ArrayGetAsSeries(tick_volume);
   ArraySetAsSeries(time, true);
   ArraySetAsSeries(open, true);
   ArraySetAsSeries(high, true);
   ArraySetAsSeries(low, true);
   ArraySetAsSeries(close, true);
   ArraySetAsSeries(tick_volume, true);

   int toSkip = 0;
   for (int pos = MathMin(bars_limit, rates_total - 1 - MathMax(prev_calculated - 1, toSkip)); pos >= 0 && !IsStopped(); --pos)
   {
      double srcValue;
      if (!src.GetValue(pos, srcValue)) { srcValue = EMPTY_VALUE; }
      double Mode_14Value;
      if (!Mode_14.GetValue(pos, srcValue, Mode_14Value)) { Mode_14Value = EMPTY_VALUE; }
      SetStream(HULL, pos, Mode_14Value, HULL_DEFAULT_VALUE);
      if (pos + 0 > (rates_total - 1)) { continue; }
      double MHULL = HULL[pos + 0];
      if (pos + 2 > (rates_total - 1)) { continue; }
      double SHULL = HULL[pos + 2];
      if (pos + 2 > (rates_total - 1)) { continue; }
      uint hullColor = (switchColor ? ((SafeGreater(HULL[pos], HULL[pos + 2]) ? 0x00ff00 : 0x0000ff)) : 0x0098ff);
      double plot1Value = plot1.SetByColor(MHULL, pos, hullColor);
      double Fi1 = plot1Value;
      double plot4Value = plot4.SetByColor((visualSwitch ? SHULL : EMPTY_VALUE), pos, hullColor);
      double Fi2 = plot4Value;
      uint barcolor1_color = (candleCol ? ((switchColor ? hullColor : INT_MAX)) : INT_MAX);
      if (barcolor1_color != INT_MAX)
      {
         barcolor1.Set(pos, open[pos], high[pos], low[pos], close[pos], barcolor1_color);
      }
      else
      {
         barcolor1.Clear(pos);
      }
   }

   ArraySetAsSeries(time, timeSeries);
   ArraySetAsSeries(open, openSeries);
   ArraySetAsSeries(high, highSeries);
   ArraySetAsSeries(low, lowSeries);
   ArraySetAsSeries(close, closeSeries);
   ArraySetAsSeries(tick_volume, tickVolumeSeries);
   return rates_total;
}
