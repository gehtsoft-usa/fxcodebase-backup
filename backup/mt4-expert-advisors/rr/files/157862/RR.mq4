}
input int param1 = 12;
input int bars_limit = 100000; // Bars limit
int FilterCandle;
double plot1[];
double plot2[];

string IndicatorObjPrefix;

bool NamesCollision(const string name)
{
   for (int k = ObjectsTotal(); k >= 0; k--)
   {
      if (StringFind(ObjectName(0, k), name) == 0)
      {
         return true;
      }
   }
   return false;
}

string GenerateIndicatorPrefix(const string target)
{
   for (int i = 0; i < 1000; ++i)
   {
      string prefix = target + "_" + IntegerToString(i);
      if (!NamesCollision(prefix))
      {
         return prefix;
      }
   }
   return target;
}

int init()
{
   IndicatorBuffers(2);
   int id = 0;
   FilterCandle = param1;
   SetIndexBuffer(id, plot1);
   SetIndexShift(id, 1);
   SetIndexArrow(id++, 233);
   SetIndexBuffer(id, plot2);
   SetIndexShift(id, 1);
   SetIndexArrow(id++, 234);
   IndicatorObjPrefix = GenerateIndicatorPrefix("");
   IndicatorShortName("RR");
   return INIT_SUCCEEDED;
}

int deinit()
{
   ObjectsDeleteAll(ChartID(), IndicatorObjPrefix);
   return 0;
}

int OnCalculate(const int rates_total,
                const int prev_calculated,
                const datetime &time[],
                const double &open[],
                const double &high[],
                const double &low[],
                const double &close[],
                const long &tick_volume[],
                const long &volume[],
                const int &spread[])
{
   if (prev_calculated <= 0 || prev_calculated > rates_total)
   {
      ArrayInitialize(plot1, EMPTY_VALUE);
      ArrayInitialize(plot2, EMPTY_VALUE);
   }
   bool timeSeries = ArrayGetAsSeries(time);
   bool openSeries = ArrayGetAsSeries(open);
   bool highSeries = ArrayGetAsSeries(high);
   bool lowSeries = ArrayGetAsSeries(low);
   bool closeSeries = ArrayGetAsSeries(close);
   bool tickVolumeSeries = ArrayGetAsSeries(tick_volume);
   ArraySetAsSeries(time, true);
   ArraySetAsSeries(open, true);
   ArraySetAsSeries(high, true);
   ArraySetAsSeries(low, true);
   ArraySetAsSeries(close, true);
   ArraySetAsSeries(tick_volume, true);

   int toSkip = 0;
   for (int pos = MathMin(bars_limit, rates_total - 1 - MathMax(prev_calculated - 1, toSkip)); pos >= 0 && !IsStopped(); --pos)
   {
      if (pos + 1 > (rates_total - 1)) { continue; }
      if (pos + 1 > (rates_total - 1)) { continue; }
      if (pos + 1 > (rates_total - 1)) { continue; }
      int isUp = SafeGreater(low[pos], low[pos + 1]) && SafeGreater(high[pos], high[pos + 1]) && SafeGreater(close[pos], close[pos + 1]);
      if (pos + 1 > (rates_total - 1)) { continue; }
      if (pos + 1 > (rates_total - 1)) { continue; }
      if (pos + 1 > (rates_total - 1)) { continue; }
      int isDown = SafeLess(low[pos], low[pos + 1]) && SafeLess(high[pos], high[pos + 1]) && SafeLess(close[pos], close[pos + 1]);
      int for1_from = 1;
      int for1_to = FilterCandle;
      bool for1_forward = for1_from <= for1_to;
      int for1_step = 1 * (for1_forward ? 1 : -1);
      if (for1_from == EMPTY_VALUE || for1_to == EMPTY_VALUE) { continue; }
      for (int i = for1_from; (for1_forward ? i <= for1_to : i >= for1_to); i += for1_step)
      {
         if (pos + i + 1 > (rates_total - 1)) { continue; }
         if (pos + 1 > (rates_total - 1)) { continue; }
         if (SafeLess(low[pos + i + 1], low[pos + 1]))
         {
            isUp = false;
         }
         if (pos + i + 1 > (rates_total - 1)) { continue; }
         if (pos + 1 > (rates_total - 1)) { continue; }
         if (SafeGreater(high[pos + i + 1], high[pos + 1]))
         {
            isDown = false;
         }
      }
      int plotshape1_condition = isUp;
      if (plotshape1_condition == true) { if (pos - (-1) < 0) { continue; } plot1[pos] = low[pos + (-1)]; }
      int plotshape2_condition = isDown;
      if (plotshape2_condition == true) { if (pos - (-1) < 0) { continue; } plot2[pos] = high[pos + (-1)]; }
   }

   ArraySetAsSeries(time, timeSeries);
   ArraySetAsSeries(open, openSeries);
   ArraySetAsSeries(high, highSeries);
   ArraySetAsSeries(low, lowSeries);
   ArraySetAsSeries(close, closeSeries);
   ArraySetAsSeries(tick_volume, tickVolumeSeries);
   return rates_total;
}
