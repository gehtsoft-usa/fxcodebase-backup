input int param1 = 33; // Body Lengt
input bool param2 = true; // Left Eye Check
input int param3 = 33; // Body Position
input int param4 = 33; // Nose Lengt
input bool param5 = true; // Use Filter
input int param6 = 8; // Alligator Teeth smoothing periods
input int param7 = 5; // Alligator Teeth shifting periods
input int bars_limit = 100000; // Bars limit
int Body;
int Left;
int Position;
int Nose;
int Filter;
int TeethN;
int TeethS;
FloatStream* sma1Source;
SmaOnStream* sma1;
double methodReturnedValue1[];
double methodReturnedValue1_DEFAULT_VALUE;
double plot1[];
double plot2[];

string IndicatorObjPrefix;

bool NamesCollision(const string name)
{
   for (int k = ObjectsTotal(); k >= 0; k--)
   {
      if (StringFind(ObjectName(0, k), name) == 0)
      {
         return true;
      }
   }
   return false;
}

string GenerateIndicatorPrefix(const string target)
{
   for (int i = 0; i < 1000; ++i)
   {
      string prefix = target + "_" + IntegerToString(i);
      if (!NamesCollision(prefix))
      {
         return prefix;
      }
   }
   return target;
}

int init()
{
   IndicatorBuffers(3);
   int id = 0;
   Body = param1;
   Left = param2;
   Position = param3;
   Nose = param4;
   Filter = param5;
   TeethN = param6;
   TeethS = param7;
   sma1Source = new FloatStream(_Symbol, (ENUM_TIMEFRAMES)_Period);
   sma1 = new SmaOnStream(sma1Source, TeethN);
   SetIndexBuffer(id, plot1);
   SetIndexArrow(id++, 217);
   SetIndexBuffer(id, plot2);
   SetIndexArrow(id++, 218);
   IndicatorObjPrefix = GenerateIndicatorPrefix("");
   IndicatorShortName("Pinocchio Bar");
   SetIndexBuffer(id++, methodReturnedValue1);
   return INIT_SUCCEEDED;
}

int deinit()
{
   ObjectsDeleteAll(ChartID(), IndicatorObjPrefix);
   sma1Source.Release();
   sma1.Release();
   return 0;
}

int OnCalculate(const int rates_total,
                const int prev_calculated,
                const datetime &time[],
                const double &open[],
                const double &high[],
                const double &low[],
                const double &close[],
                const long &tick_volume[],
                const long &volume[],
                const int &spread[])
{
   if (prev_calculated <= 0 || prev_calculated > rates_total)
   {
      sma1Source.Init();
      methodReturnedValue1_DEFAULT_VALUE = EMPTY_VALUE;
      ArrayInitialize(methodReturnedValue1, methodReturnedValue1_DEFAULT_VALUE);
      ArrayInitialize(plot1, EMPTY_VALUE);
      ArrayInitialize(plot2, EMPTY_VALUE);
   }
   bool timeSeries = ArrayGetAsSeries(time);
   bool openSeries = ArrayGetAsSeries(open);
   bool highSeries = ArrayGetAsSeries(high);
   bool lowSeries = ArrayGetAsSeries(low);
   bool closeSeries = ArrayGetAsSeries(close);
   bool tickVolumeSeries = ArrayGetAsSeries(tick_volume);
   ArraySetAsSeries(time, true);
   ArraySetAsSeries(open, true);
   ArraySetAsSeries(high, true);
   ArraySetAsSeries(low, true);
   ArraySetAsSeries(close, true);
   ArraySetAsSeries(tick_volume, true);

   int toSkip = 0;
   for (int pos = MathMin(bars_limit, rates_total - 1 - MathMax(prev_calculated - 1, toSkip)); pos >= 0 && !IsStopped(); --pos)
   {
      double Bar = SafeDivide((high[pos] - low[pos]), 100);
      sma1Source.SetValue(pos, SafeDivide((high[pos] + low[pos]), 2));
      double sma1Value;
      if (!sma1.GetValue(pos, sma1Value)) { sma1Value = EMPTY_VALUE; }
      SetStream(methodReturnedValue1, pos, sma1Value, methodReturnedValue1_DEFAULT_VALUE);
      if (pos + TeethS > (rates_total - 1)) { continue; }
      double alligator_Teeth = methodReturnedValue1[pos + TeethS];
      int signal = 0;
      if (Left)
      {
         if (SafeLE(MathAbs(close[pos] - open[pos]), Bar * Body))
         {
            if (SafeLE(MathMax(close[pos], open[pos]), low[pos] + Bar * Position))
            {
               if (pos + 1 > (rates_total - 1)) { continue; }
               if (SafeGE(SafeMinus(high[pos], high[pos + 1]), Nose * Bar))
               {
                  if (pos + 1 > (rates_total - 1)) { continue; }
                  if (pos + 1 > (rates_total - 1)) { continue; }
                  if (SafeLess(low[pos + 1], MathMin(open[pos], close[pos])) && SafeGreater(high[pos + 1], MathMax(open[pos], close[pos])) && ((!Filter || (Filter && SafeGreater(close[pos], alligator_Teeth)))))
                  {
                     signal = (-1);
                  }
               }
            }
            if (SafeGE(MathMin(close[pos], open[pos]), high[pos] - Bar * Position))
            {
               if (pos + 1 > (rates_total - 1)) { continue; }
               if (SafeGE(SafeMinus(low[pos + 1], low[pos]), Nose * Bar))
               {
                  if (pos + 1 > (rates_total - 1)) { continue; }
                  if (pos + 1 > (rates_total - 1)) { continue; }
                  if (SafeGreater(high[pos + 1], MathMax(open[pos], close[pos])) && SafeLess(low[pos + 1], MathMax(open[pos], close[pos])) && ((!Filter || (Filter && SafeLess(close[pos], alligator_Teeth)))))
                  {
                     signal = 1;
                  }
               }
            }
         }
      }
      else
      {
         if (SafeLE(MathAbs(close[pos] - open[pos]), Bar * Body))
         {
            if (SafeLE(MathMax(close[pos], open[pos]), low[pos] + Bar * Position))
            {
               if (pos + 1 > (rates_total - 1)) { continue; }
               if (SafeGE(SafeMinus(high[pos], high[pos + 1]), Nose * Bar) && ((!Filter || (Filter && SafeGreater(close[pos], alligator_Teeth)))))
               {
                  signal = (-1);
               }
            }
            if (SafeGE(MathMin(close[pos], open[pos]), high[pos] - Bar * Position))
            {
               if (pos + 1 > (rates_total - 1)) { continue; }
               if (SafeGE(SafeMinus(low[pos + 1], low[pos]), Nose * Bar) && ((!Filter || (Filter && SafeLess(close[pos], alligator_Teeth)))))
               {
                  signal = 1;
               }
            }
         }
      }
      plot1[pos] = ((signal == 1) ? low[pos] : EMPTY_VALUE);
      plot2[pos] = ((signal == (-1)) ? high[pos] : EMPTY_VALUE);
   }

   ArraySetAsSeries(time, timeSeries);
   ArraySetAsSeries(open, openSeries);
   ArraySetAsSeries(high, highSeries);
   ArraySetAsSeries(low, lowSeries);
   ArraySetAsSeries(close, closeSeries);
   ArraySetAsSeries(tick_volume, tickVolumeSeries);
   return rates_total;
}
