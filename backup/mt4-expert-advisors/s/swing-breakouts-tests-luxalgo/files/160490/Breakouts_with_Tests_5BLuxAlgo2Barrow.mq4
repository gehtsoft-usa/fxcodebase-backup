      if ((showReTest == "Last") && SafeGreater(Array::Size<int, ICustomTypeArray<Label*>*>(aLabValue, INT_MIN), 1))
      {
         __out1 = Array::Pop<Label*, ICustomTypeArray<Label*>*>(aLabValue, NULL);
      }
      return true;
   }
