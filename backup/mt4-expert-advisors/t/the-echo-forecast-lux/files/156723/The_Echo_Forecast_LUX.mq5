input int param1 = 50; // Evaluation Window
input int param2 = 50; // Forecast Window
input string param3 = "Similarity"; // Forecast Mode
input string param4 = "Cumulative"; // Forecast Construction
input PriceType param5 = PriceClose;
input color param6 = 0xf35721; // Forecast Style
input string param7 = "? ? ?"; // 
input bool param8 = true; // Show Area
input color param9 = AddTransparency(0x005dff, 50); // 
input color param10 = AddTransparency(0x1ab50c, 50); // 
input color param11 = AddTransparency(Gray, 50); // 
input int bars_limit = 1000; // Bars limit
int length;
int fcast;
string fmode;
string cmode;
IStream* param5Stream;
IStream* src;
uint fcast_col;
string fcast_style;
bool show_area;
uint fcast_area;
uint corr_area;
uint eval_area;
ILineArray* lines;
ILineArray* __array1;
FirstBarState* isFirst1;
FloatStream* change1Source;
ChangeStream* change1;
FloatStream* highest1Source;
FloatStream* lowest1Source;
IFloatArray* __array2;
IIntArray* __array3;
double n[];
double n_DEFAULT_VALUE;
double d[];
double d_DEFAULT_VALUE;

string IndicatorObjPrefix;

bool NamesCollision(const string name)
{
   for (int k = ObjectsTotal(0); k >= 0; k--)
   {
      if (StringFind(ObjectName(0, k), name) == 0)
      {
         return true;
      }
   }
   return false;
}

string GenerateIndicatorPrefix(const string target)
{
   for (int i = 0; i < 1000; ++i)
   {
      string prefix = target + "_" + IntegerToString(i);
      if (!NamesCollision(prefix))
      {
         return prefix;
      }
   }
   return target;
}

void OnInit()
{
   int id = 0;
   length = param1;
   fcast = param2;
   fmode = param3;
   cmode = param4;
   param5Stream = PriceStreamFactory::Create(_Symbol, (ENUM_TIMEFRAMES)_Period, param5);
   src = param5Stream;
   fcast_col = param6;
   fcast_style = param7;
   show_area = param8;
   fcast_area = param9;
   corr_area = param10;
   eval_area = param11;
   change1Source = new FloatStream(_Symbol, (ENUM_TIMEFRAMES)_Period);
   change1 = new ChangeStream(change1Source, 1);
   highest1Source = new FloatStream(_Symbol, (ENUM_TIMEFRAMES)_Period);
   lowest1Source = new FloatStream(_Symbol, (ENUM_TIMEFRAMES)_Period);
   LinesCollection::SetMaxLines(200);
   BoxesCollection::SetMaxBoxes(50);
   IndicatorObjPrefix = GenerateIndicatorPrefix("ECHO [LuxAlgo]");
   IndicatorSetString(INDICATOR_SHORTNAME, "The Echo Forecast [LUX]");
   IndicatorSetInteger(INDICATOR_DIGITS, Digits());
   __array1 = new LineArray(0, NULL);
   isFirst1 = new FirstBarState();
   __array2 = new FloatArray(0, NULL);
   __array3 = new IntArray(0, NULL);
   SetIndexBuffer(id++, n, INDICATOR_CALCULATIONS);
   SetIndexBuffer(id++, d, INDICATOR_CALCULATIONS);
}

void OnDeinit(const int reason)
{
   ObjectsDeleteAll(0, IndicatorObjPrefix);
   param5Stream.Release();
   delete __array1;
   delete isFirst1;
   change1Source.Release();
   change1.Release();
   highest1Source.Release();
   lowest1Source.Release();
   delete __array2;
   delete __array3;
   LinesCollection::Clear(true);
   BoxesCollection::Clear(true);
}

int OnCalculate(const int rates_total,
                const int prev_calculated,
                const datetime &time[],
                const double &open[],
                const double &high[],
                const double &low[],
                const double &close[],
                const long &tick_volume[],
                const long &volume[],
                const int &spread[])
{
   if (prev_calculated <= 0 || prev_calculated > rates_total)
   {
      LinesCollection::Clear();
      BoxesCollection::Clear();
      lines = __array1.Clear();
      isFirst1.Clear();
      change1Source.Init();
      highest1Source.Init();
      lowest1Source.Init();
      n_DEFAULT_VALUE = EMPTY_VALUE;
      ArrayInitialize(n, n_DEFAULT_VALUE);
      d_DEFAULT_VALUE = EMPTY_VALUE;
      ArrayInitialize(d, d_DEFAULT_VALUE);
   }
   int first = 0;
   for (int pos = MathMax(rates_total - 1 - bars_limit, MathMax(first, prev_calculated - 1)); pos < rates_total; ++pos)
   {
      int oldPos = rates_total - pos - 1;
      if (isFirst1.IsFirst())
      {
         int for1_from = 0;
         int for1_to = fcast - 1;
         bool for1_forward = for1_from <= for1_to;
         int for1_step = 1 * (for1_forward ? 1 : -1);
         if (for1_from == EMPTY_VALUE || for1_to == EMPTY_VALUE) { continue; }
         for (int i = for1_from; (for1_forward ? i <= for1_to : i >= for1_to); i += for1_step)
         {
            Array::Push(lines, LinesCollection::Create(IndicatorObjPrefix + "line_1_id" + "_" + IntegerToString(i), EMPTY_VALUE, EMPTY_VALUE, EMPTY_VALUE, EMPTY_VALUE, time[pos]).SetWidth(1).SetStyle("solid"));
         }
      }
      SetStream(n, pos, pos, n_DEFAULT_VALUE);
      double srcValue[1];
      if (!src.GetValues(pos, 1, srcValue)) { srcValue[0] = EMPTY_VALUE; }
      change1Source.SetValue(pos, srcValue[0]);
      double change1Value[1];
      if (!change1.GetValues(pos, 1, change1Value)) { change1Value[0] = EMPTY_VALUE; }
      SetStream(d, pos, change1Value[0], d_DEFAULT_VALUE);
      highest1Source.SetValue(pos, srcValue[0]);
      double highest1Value[1];
      if (!HighestHighStream::GetValues(pos, 1, highest1Value, highest1Source, length + fcast * 2)) { highest1Value[0] = EMPTY_VALUE; }
      double top = highest1Value[0];
      lowest1Source.SetValue(pos, srcValue[0]);
      double lowest1Value[1];
      if (!LowestLowStream::GetValues(pos, 1, lowest1Value, lowest1Source, length + fcast * 2)) { lowest1Value[0] = EMPTY_VALUE; }
      double btm = lowest1Value[0];
      if ((pos == rates_total - 1))
      {
         double val = EMPTY_VALUE;
         int k = 0;
         IFloatArray* A = __array2.Clear();
         IIntArray* X = __array3.Clear();
         int for2_from = 0;
         int for2_to = fcast * 2 + length;
         bool for2_forward = for2_from <= for2_to;
         int for2_step = 1 * (for2_forward ? 1 : -1);
         if (for2_from == EMPTY_VALUE || for2_to == EMPTY_VALUE) { continue; }
         for (int i = for2_from; (for2_forward ? i <= for2_to : i >= for2_to); i += for2_step)
         {
            double srcValue_i[1];
            if (!src.GetValues(pos - i, 1, srcValue_i)) { srcValue_i[0] = EMPTY_VALUE; }
            Array::Push(A, srcValue_i[0]);
            if ((cmode == "Linreg"))
            {
               if (pos - i < 0) { continue; }
               Array::Push(X, n[pos - i]);
            }
         }
         IFloatArray* a = Array::Slice(A, 0, fcast - 1);
         int for3_from = 0;
         int for3_to = length - 1;
         bool for3_forward = for3_from <= for3_to;
         int for3_step = 1 * (for3_forward ? 1 : -1);
         if (for3_from == EMPTY_VALUE || for3_to == EMPTY_VALUE) { continue; }
         for (int i = for3_from; (for3_forward ? i <= for3_to : i >= for3_to); i += for3_step)
         {
            IFloatArray* b = Array::Slice(A, fcast + i, fcast * 2 + i - 1);
            double r = SafeDivide(Array::Covariance(a, b), (SafeMultiply(Array::Stdev(a), Array::Stdev(b))));
            if ((fmode == "Similarity"))
            {
               val = (SafeGE(r, Nz(val, r)) ? r : val);
            }
            else
            {
               val = (SafeLE(r, Nz(val, r)) ? r : val);
            }
            k = ((val == r) ? i : k);
         }
         double prev = srcValue[0];
         double current = srcValue[0];
         int for4_from = 0;
         int for4_to = fcast - 1;
         bool for4_forward = for4_from <= for4_to;
         int for4_step = 1 * (for4_forward ? 1 : -1);
         if (for4_from == EMPTY_VALUE || for4_to == EMPTY_VALUE) { continue; }
         for (int i = for4_from; (for4_forward ? i <= for4_to : i >= for4_to); i += for4_step)
         {
            if (pos - fcast + k + (fcast - i - 1) < 0) { continue; }
            double e = d[pos - (fcast + k + (fcast - i - 1))];
            if ((cmode == "Mean"))
            {
               current = SafePlus(Array::Avg(a), e);
            }
            else if ((cmode == "Linreg"))
            {
               a = Array::Slice(A, 0, fcast);
               IIntArray* x = Array::Slice(X, 0, fcast);
               double alpha = SafeDivide(Array::Covariance(a, x), Array::Variance(x, true));
               double beta = SafeMinus(Array::Avg(a), SafeMultiply(alpha, Array::Avg(x)));
               current = SafePlus(SafePlus(SafeMultiply(alpha, (n[pos] + i + 1)), beta), e);
            }
            else
            {
               current = SafePlus(current, e);
            }
            Line* l = Array::Get(lines, i);
            Line::SetXY1(l, n[pos] + i, prev);
            Line::SetXY2(l, n[pos] + i + 1, current);
            Line::SetColor(l, fcast_col);
            if ((fcast_style == "- - -"))
            {
               Line::SetStyle(l, "dashed");
            }
            else if ((fcast_style == "? ? ?"))
            {
               Line::SetStyle(l, "dotted");
            }
            prev = current;
         }
         if (show_area)
         {
            Box* methodReturnedValue1 = BoxesCollection::Create(IndicatorObjPrefix + "box_1_id", n[pos] - length - fcast * 2 + 1, top, n[pos] - fcast + 1, btm, time[pos])
               .SetBgColor(eval_area)
               .SetBorderColor(EMPTY_VALUE)
               .SetExtend("none");
            BoxesCollection::Delete(BoxesCollection::Get(methodReturnedValue1, 1));
            Box* methodReturnedValue2 = BoxesCollection::Create(IndicatorObjPrefix + "box_2_id", n[pos] - fcast + 1, top, n[pos], btm, time[pos])
               .SetBgColor(fcast_area)
               .SetBorderColor(EMPTY_VALUE)
               .SetExtend("none");
            BoxesCollection::Delete(BoxesCollection::Get(methodReturnedValue2, 1));
            Box* methodReturnedValue3 = BoxesCollection::Create(IndicatorObjPrefix + "box_3_id", n[pos] - k - fcast * 2 + 1, btm, n[pos] - k - fcast, top, time[pos])
               .SetBgColor(corr_area)
               .SetBorderColor(EMPTY_VALUE)
               .SetExtend("none");
            BoxesCollection::Delete(BoxesCollection::Get(methodReturnedValue3, 1));
         }
      }
   }
   LinesCollection::Redraw();
   BoxesCollection::Redraw();
   return rates_total;
}
