   crossunder1X = new FloatStream(_Symbol, (ENUM_TIMEFRAMES)_Period);
   crossunder1Y = new FloatStream(_Symbol, (ENUM_TIMEFRAMES)_Period);
   crossunder1 = CrossStreamFactory::CreateCrossunder(crossunder1X, crossunder1Y);
   crossunder2X = new FloatStream(_Symbol, (ENUM_TIMEFRAMES)_Period);
   crossunder2Y = new FloatStream(_Symbol, (ENUM_TIMEFRAMES)_Period);
   crossunder2 = CrossStreamFactory::CreateCrossunder(crossunder2X, crossunder2Y);
   crossover2X = new FloatStream(_Symbol, (ENUM_TIMEFRAMES)_Period);
   crossover2Y = new FloatStream(_Symbol, (ENUM_TIMEFRAMES)_Period);
   crossover2 = CrossStreamFactory::CreateCrossover(crossover2X, crossover2Y);
   SetIndexBuffer(id, plot1);
   SetIndexShift(id, (-1));
   SetIndexArrow(id, 161);
   SetIndexStyle(id++, DRAW_ARROW, STYLE_SOLID, 1, buy_col2);
   SetIndexBuffer(id, plot2);
   SetIndexShift(id, (-1));
   SetIndexArrow(id, 161);
   SetIndexStyle(id++, DRAW_ARROW, STYLE_SOLID, 1, buy_col1);
   SetIndexBuffer(id, plot3);
   SetIndexShift(id, (-1));
   SetIndexArrow(id, 161);
   SetIndexStyle(id++, DRAW_ARROW, STYLE_SOLID, 1, sell_col2);
   SetIndexBuffer(id, plot4);
   SetIndexShift(id, (-1));
   SetIndexArrow(id, 161);
   SetIndexStyle(id++, DRAW_ARROW, STYLE_SOLID, 1, sell_col1);
   SetIndexBuffer(id, plot5);
   SetIndexStyle(id++, DRAW_LINE, STYLE_SOLID, 1, AddTransparency(ChartGetInteger(0, CHART_COLOR_FOREGROUND), 80));
   SetIndexBuffer(id, plot6);
   SetIndexStyle(id++, DRAW_LINE, STYLE_SOLID, 1, AddTransparency(ChartGetInteger(0, CHART_COLOR_FOREGROUND), 50));
   plot7 = new ColoredStream(_Symbol, (ENUM_TIMEFRAMES)_Period);
   id = plot7.RegisterStream(id, AddTransparency(ChartGetInteger(0, CHART_COLOR_FOREGROUND), 0));
   id = plot7.RegisterStream(id, AddTransparency(INT_MAX, 0));
   SetIndexBuffer(id, plot9);
   SetIndexStyle(id++, DRAW_LINE, STYLE_SOLID, 1, AddTransparency(ChartGetInteger(0, CHART_COLOR_FOREGROUND), 50));
   SetIndexBuffer(id, plot10);
   SetIndexStyle(id++, DRAW_LINE, STYLE_SOLID, 1, AddTransparency(ChartGetInteger(0, CHART_COLOR_FOREGROUND), 80));
   plot11 = new ColoredStream(_Symbol, (ENUM_TIMEFRAMES)_Period);
   id = plot11.RegisterStream(id, up_color);
   id = plot11.RegisterStream(id, AddTransparency(up_color, 0));
   id = plot11.RegisterStream(id, AddTransparency(dn_color, 0));
   SetIndexBuffer(id++, plot14);
   LinesCollection::SetMaxLines(500);
   LabelsCollection::SetMaxLabels(500);
   IndicatorObjPrefix = GenerateIndicatorPrefix("");
   IndicatorShortName("Two-Pole Oscillator [BigBeluga]");
   f_two_pole_filter_fS_i1_param1 = new FloatStream(_Symbol, (ENUM_TIMEFRAMES)_Period);
   f_two_pole_filter_fS_i1 = new f_two_pole_filter_fS_iStream(f_two_pole_filter_fS_i1_param1, length);
   id = f_two_pole_filter_fS_i1.Init(id);
   SetIndexBuffer(id++, two_p);
   id = plot7.RegisterInternalStream(id);
   id = plot11.RegisterInternalStream(id);
   return INIT_SUCCEEDED;
}

int deinit()
{
   ObjectsDeleteAll(ChartID(), IndicatorObjPrefix);
   sma1Source.Release();
   sma1.Release();
   sma2Source.Release();
