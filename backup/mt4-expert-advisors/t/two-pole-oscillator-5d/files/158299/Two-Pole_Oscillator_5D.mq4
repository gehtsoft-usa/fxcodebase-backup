class f_two_pole_filter_fS_iStream
{
   IStream* source;
   int length;
   double smooth1[];
   double smooth1_DEFAULT_VALUE;
   double smooth2[];
   double smooth2_DEFAULT_VALUE;
   bool _initialized;
public:
   f_two_pole_filter_fS_iStream(IStream* source, int length)
   {
      _initialized = false;
      this.source = source;
      source.AddRef();
      this.length = length;
   }
   ~f_two_pole_filter_fS_iStream()
   {
      source.Release();
   }
   int Init(int id)
   {
      SetIndexBuffer(id++, smooth1);
      SetIndexBuffer(id++, smooth2);
      return id;
   }
   void Clear()
   {
      _initialized = false;
   }
   bool GetValue(const int pos, double &__out1)
   {
      if (!_initialized)
      {
         smooth1_DEFAULT_VALUE = EMPTY_VALUE;
         ArrayInitialize(smooth1, smooth1_DEFAULT_VALUE);
         smooth2_DEFAULT_VALUE = EMPTY_VALUE;
         ArrayInitialize(smooth2, smooth2_DEFAULT_VALUE);
         _initialized = true;
      }
      smooth1[pos] = pos < (iBars(_Symbol, (ENUM_TIMEFRAMES)_Period) - 1) ? smooth1[pos + 1] : EMPTY_VALUE;
      smooth2[pos] = pos < (iBars(_Symbol, (ENUM_TIMEFRAMES)_Period) - 1) ? smooth2[pos + 1] : EMPTY_VALUE;
      double alpha = SafeDivide(2.0, (length + 1));
      if (((smooth1[pos]) == EMPTY_VALUE))
      {
         double sourceValue;
         if (!source.GetValue(pos, sourceValue)) { sourceValue = EMPTY_VALUE; }
         SetStream(smooth1, pos, sourceValue, smooth1_DEFAULT_VALUE);
      }
      else
      {
         double sourceValue;
         if (!source.GetValue(pos, sourceValue)) { sourceValue = EMPTY_VALUE; }
         SetStream(smooth1, pos, SafePlus(SafeMultiply((1 - alpha), smooth1[pos]), alpha * sourceValue), smooth1_DEFAULT_VALUE);
      }
      if (((smooth2[pos]) == EMPTY_VALUE))
      {
         SetStream(smooth2, pos, smooth1[pos], smooth2_DEFAULT_VALUE);
         __out1 = smooth2[pos];
      }
      else
      {
         SetStream(smooth2, pos, SafePlus(SafeMultiply((1 - alpha), smooth2[pos]), SafeMultiply(alpha, smooth1[pos])), smooth2_DEFAULT_VALUE);
         __out1 = smooth2[pos];
      }
      return true;
   }
};
