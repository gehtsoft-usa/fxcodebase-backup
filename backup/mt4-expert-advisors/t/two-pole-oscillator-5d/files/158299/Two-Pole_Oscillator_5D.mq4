                const int prev_calculated,
                const datetime &time[],
                const double &open[],
                const double &high[],
                const double &low[],
                const double &close[],
                const long &tick_volume[],
                const long &volume[],
                const int &spread[])
{
   if (prev_calculated <= 0 || prev_calculated > rates_total)
   {
      LinesCollection::Clear();
      LabelsCollection::Clear();
      buy_line = (Line*)(NULL);
      sell_line = (Line*)(NULL);
      sma1Source.Init();
      sma2Source.Init();
      stdev1Source.Init();
      sma3Source.Init();
      f_two_pole_filter_fS_i1_param1.Init();
      f_two_pole_filter_fS_i1.Clear();
      two_p_DEFAULT_VALUE = EMPTY_VALUE;
      ArrayInitialize(two_p, two_p_DEFAULT_VALUE);
      crossover1X.Init();
      crossover1Y.Init();
      crossunder1X.Init();
      crossunder1Y.Init();
      crossunder2X.Init();
      crossunder2Y.Init();
      crossover2X.Init();
      crossover2Y.Init();
      ArrayInitialize(plot1, EMPTY_VALUE);
      ArrayInitialize(plot2, EMPTY_VALUE);
      ArrayInitialize(plot3, EMPTY_VALUE);
      ArrayInitialize(plot4, EMPTY_VALUE);
      ArrayInitialize(plot5, EMPTY_VALUE);
      ArrayInitialize(plot6, EMPTY_VALUE);
      plot7.Init(EMPTY_VALUE);
      ArrayInitialize(plot9, EMPTY_VALUE);
      ArrayInitialize(plot10, EMPTY_VALUE);
      plot11.Init(EMPTY_VALUE);
      ArrayInitialize(plot14, EMPTY_VALUE);
   }
   bool timeSeries = ArrayGetAsSeries(time);
   bool openSeries = ArrayGetAsSeries(open);
   bool highSeries = ArrayGetAsSeries(high);
   bool lowSeries = ArrayGetAsSeries(low);
   bool closeSeries = ArrayGetAsSeries(close);
   bool tickVolumeSeries = ArrayGetAsSeries(tick_volume);
   ArraySetAsSeries(time, true);
   ArraySetAsSeries(open, true);
   ArraySetAsSeries(high, true);
   ArraySetAsSeries(low, true);
   ArraySetAsSeries(close, true);
   ArraySetAsSeries(tick_volume, true);

   int toSkip = 0;
   for (int pos = MathMin(bars_limit, rates_total - 1 - MathMax(prev_calculated - 1, toSkip)); pos >= 0 && !IsStopped(); --pos)
   {
      sma1Source.SetValue(pos, close[pos]);
      double sma1Value;
      if (!sma1.GetValue(pos, sma1Value)) { sma1Value = EMPTY_VALUE; }
      double sma1 = sma1Value;
      sma2Source.SetValue(pos, SafeMinus(close[pos], sma1));
      double sma2Value;
      if (!sma2.GetValue(pos, sma2Value)) { sma2Value = EMPTY_VALUE; }
      stdev1Source.SetValue(pos, SafeMinus(close[pos], sma1));
      double stdev1Value;
      if (!stdev1.GetValue(pos, stdev1Value)) { stdev1Value = EMPTY_VALUE; }
      double sma_n1 = SafeDivide((SafeMinus((SafeMinus(close[pos], sma1)), sma2Value)), stdev1Value);
      sma3Source.SetValue(pos, high[pos] - low[pos]);
      double sma3Value;
      if (!sma3.GetValue(pos, sma3Value)) { sma3Value = EMPTY_VALUE; }
      double area = sma3Value;
      f_two_pole_filter_fS_i1_param1.SetValue(pos, sma_n1);
      double f_two_pole_filter_fS_i1Value;
      if (!f_two_pole_filter_fS_i1.GetValue(pos, f_two_pole_filter_fS_i1Value)) { f_two_pole_filter_fS_i1Value = EMPTY_VALUE; }
      SetStream(two_p, pos, f_two_pole_filter_fS_i1Value, two_p_DEFAULT_VALUE);
      if (pos + 4 > (rates_total - 1)) { continue; }
      double two_pp = two_p[pos + 4];
      buy_col1 = FromGradient(two_p[pos], (-1), 0.5, up_color, NULL);
      buy_col2 = FromGradient(two_p[pos], (-1), 0.5, AddTransparency(up_color, 50), NULL);
      sell_col1 = FromGradient(two_p[pos], (-0.5), 1, NULL, dn_color);
      sell_col2 = FromGradient(two_p[pos], (-0.5), 1, NULL, AddTransparency(dn_color, 50));
      uint _color = (SafeGreater(two_p[pos], two_pp) ? FromGradient(two_p[pos], (-1), 1, up_color, AddTransparency(up_color, 0)) : FromGradient(two_p[pos], (-1), 1, AddTransparency(dn_color, 0), dn_color));
      crossover1X.SetValue(pos, two_p[pos]);
      crossover1Y.SetValue(pos, two_pp);
      int crossover1Value;
      if (!crossover1.GetValue(pos, crossover1Value)) { crossover1Value = (-1); }
      int buy = crossover1Value && SafeLess(two_p[pos], 0) && (pos > 0);
      crossunder1X.SetValue(pos, two_p[pos]);
      crossunder1Y.SetValue(pos, two_pp);
      int crossunder1Value;
      if (!crossunder1.GetValue(pos, crossunder1Value)) { crossunder1Value = (-1); }
      int sell = crossunder1Value && SafeGreater(two_p[pos], 0) && (pos > 0);
      if (buy)
      {
         sell_line = (Line*)(NULL);
         if (disp_lvl)
         {
            if (pos + 1 > (rates_total - 1)) { continue; }
            if (pos + 1 > (rates_total - 1)) { continue; }
            buy_line = LinesCollection::Create(IndicatorObjPrefix + "line_1_id", ((rates_total - 1) - pos) - 1, SafeMinus(low[pos + 1], area), ((rates_total - 1) - pos), SafeMinus(low[pos + 1], area), time[pos]).SetColor(buy_col1).SetWidth(1).SetStyle("dashed");
         }
         if (pos + 1 > (rates_total - 1)) { continue; }
         LabelsCollection::Create(IndicatorObjPrefix + "label_1_id", ((rates_total - 1) - pos) - 1, SafeMinus(low[pos + 1], area), time[pos]).SetColor(buy_col1).SetText("").SetStyle("up").SetSize("tiny").SetYLoc("price").SetTextAlign("center");
      }
      crossunder2X.SetValue(pos, low[pos]);
      crossunder2Y.SetValue(pos, Line::GetY1(buy_line));
      int crossunder2Value;
      if (!crossunder2.GetValue(pos, crossunder2Value)) { crossunder2Value = (-1); }
      if (crossunder2Value && (pos > 0))
      {
         LabelsCollection::Create(IndicatorObjPrefix + "label_2_id", ((rates_total - 1) - pos) - 1, Line::GetY1(buy_line), time[pos]).SetColor(AddTransparency(up_color, 100)).SetText("?").SetTextColor(up_color).SetStyle("center").SetSize("large").SetYLoc("price").SetTextAlign("center");
         buy_line = (Line*)(NULL);
      }
      if (sell)
      {
         buy_line = (Line*)(NULL);
         if (disp_lvl)
         {
            if (pos + 1 > (rates_total - 1)) { continue; }
            if (pos + 1 > (rates_total - 1)) { continue; }
            sell_line = LinesCollection::Create(IndicatorObjPrefix + "line_2_id", ((rates_total - 1) - pos) - 1, SafePlus(high[pos + 1], area), ((rates_total - 1) - pos), SafePlus(high[pos + 1], area), time[pos]).SetColor(sell_col1).SetWidth(1).SetStyle("dashed");
         }
         if (pos + 1 > (rates_total - 1)) { continue; }
         LabelsCollection::Create(IndicatorObjPrefix + "label_3_id", ((rates_total - 1) - pos) - 1, SafePlus(high[pos + 1], area), time[pos]).SetColor(sell_col1).SetText("").SetStyle("down").SetSize("tiny").SetYLoc("price").SetTextAlign("center");
      }
      crossover2X.SetValue(pos, high[pos]);
      crossover2Y.SetValue(pos, Line::GetY1(sell_line));
      int crossover2Value;
      if (!crossover2.GetValue(pos, crossover2Value)) { crossover2Value = (-1); }
      if (crossover2Value && (pos > 0))
      {
         LabelsCollection::Create(IndicatorObjPrefix + "label_4_id", ((rates_total - 1) - pos) - 1, Line::GetY1(sell_line), time[pos]).SetColor(AddTransparency(dn_color, 100)).SetText("?").SetTextColor(dn_color).SetStyle("center").SetSize("large").SetYLoc("price").SetTextAlign("center");
         sell_line = (Line*)(NULL);
      }
      if (!((buy_line) == NULL))
      {
         Line::SetX2(buy_line, ((rates_total - 1) - pos));
      }
      else
      {
         Line::SetX2(sell_line, ((rates_total - 1) - pos));
      }
      if (pos + 1 > (rates_total - 1)) { continue; }
      plot1[pos] = (buy ? two_p[pos + 1] : EMPTY_VALUE);
      if (pos + 1 > (rates_total - 1)) { continue; }
      plot2[pos] = (buy ? two_p[pos + 1] : EMPTY_VALUE);
      if (pos + 1 > (rates_total - 1)) { continue; }
      plot3[pos] = (sell ? two_p[pos + 1] : EMPTY_VALUE);
      if (pos + 1 > (rates_total - 1)) { continue; }
      plot4[pos] = (sell ? two_p[pos + 1] : EMPTY_VALUE);
      uint plot5_color = AddTransparency(ChartGetInteger(0, CHART_COLOR_FOREGROUND), 80);
      if (plot5_color != INT_MAX) { plot5[pos] = 1; }
      else { plot5[pos] = EMPTY_VALUE; }
      double p11 = plot5[pos];
      uint plot6_color = AddTransparency(ChartGetInteger(0, CHART_COLOR_FOREGROUND), 50);
      if (plot6_color != INT_MAX) { plot6[pos] = 0.5; }
      else { plot6[pos] = EMPTY_VALUE; }
      double plot7Value = plot7.SetByColor(0, pos, AddTransparency(((((rates_total - 1) - pos) % 2 == 0) ? ChartGetInteger(0, CHART_COLOR_FOREGROUND) : INT_MAX), 0));
      double p00 = plot7Value;
      uint plot9_color = AddTransparency(ChartGetInteger(0, CHART_COLOR_FOREGROUND), 50);
      if (plot9_color != INT_MAX) { plot9[pos] = (-0.5); }
      else { plot9[pos] = EMPTY_VALUE; }
      uint plot10_color = AddTransparency(ChartGetInteger(0, CHART_COLOR_FOREGROUND), 80);
      if (plot10_color != INT_MAX) { plot10[pos] = (-1); }
      else { plot10[pos] = EMPTY_VALUE; }
      double p_1 = plot10[pos];
      double plot11Value = plot11.SetByColor(two_p[pos], pos, _color);
      double p1 = plot11Value;
      plot14[pos] = two_pp;
      double p2 = plot14[pos];
   }

   ArraySetAsSeries(time, timeSeries);
   ArraySetAsSeries(open, openSeries);
   ArraySetAsSeries(high, highSeries);
   ArraySetAsSeries(low, lowSeries);
   ArraySetAsSeries(close, closeSeries);
   ArraySetAsSeries(tick_volume, tickVolumeSeries);
   LinesCollection::Redraw();
   LabelsCollection::Redraw();
   return rates_total;
}
