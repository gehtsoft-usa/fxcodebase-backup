#property copyright "Copyright © 2019, Gehtsoft USA LLC"
#property link      "http://fxcodebase.com"
#property version   "1.0"
#property strict

#property indicator_separate_window
#property indicator_buffers 1
#property indicator_color1 Red

string IndicatorName;
string IndicatorObjPrefix;

string GenerateIndicatorName(const string target)
{
   string name = target;
   int try = 2;
   while (WindowFind(name) != -1)
   {
      name = target + " #" + IntegerToString(try++);
   }
   return name;
}

double nvi[];

int init()
{
   IndicatorName = GenerateIndicatorName("Negative volume index");
   IndicatorObjPrefix = "__" + IndicatorName + "__";
   IndicatorShortName(IndicatorName);

   IndicatorBuffers(1);

   SetIndexStyle(0, DRAW_LINE);
   SetIndexBuffer(0, nvi);
   SetIndexLabel(0, "NVI");

   return 0;
}

int deinit()
{
   ObjectsDeleteAll(ChartID(), IndicatorObjPrefix);
   return 0;
}

int start()
{
   int counted_bars = IndicatorCounted();
   int limit = Bars - counted_bars - 2;
   for (int i = limit; i >= 0; i--)
   {
      if (i == Bars - 2)
      {
         nvi[i] = (Close[i] - Close[i + 1]) / Close[i + 1];
      }
      else
      {
         if (Volume[i] < Volume[i + 1] || Close[i + 1] * nvi[i + 1] == 0)
         {
            nvi[i] = nvi[i + 1] + (Close[i] - Close[i + 1]) / (Close[i + 1] * nvi[i + 1]);
         }
         else
         {
            nvi[i] = nvi[i + 1];
         }
      }
   }
   return 0;
}
