R_MA_P_HIGH=Maximum
R_MA_P_LOW=Minimum
R_MA_P_CLOSE=Zavírací cena
R_MA_P_MEDIAN=Medián
R_MA_P_TYPICAL=Typická cena
R_MA_P_WEIGHTED=Vážená cena
