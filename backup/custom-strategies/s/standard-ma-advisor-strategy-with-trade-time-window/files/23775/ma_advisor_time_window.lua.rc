R_NAME=Vzor strategie klouzavého pr_m_ru
R_DESCRIPTION=Vstupuje do dlouhých pozic, když rychlý klouzavý pr_m_r p_ekro_í zespodu pomalý klouzavý pr_m_r a vstupuje do krátkých pozic, když rychlý klouzavý pr_m_r p_ekro_í zeshora pomalý klouzavý pr_m_r.
