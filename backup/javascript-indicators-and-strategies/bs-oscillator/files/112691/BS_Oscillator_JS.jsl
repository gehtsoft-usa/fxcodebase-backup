function Init()
{
    indicator.name("BS Oscillator");
    indicator.description("BS Oscillator");
    indicator.requiredSource(core.Bar);
    indicator.type(core.Oscillator);

    indicator.parameters.addGroup("Calculation");
    indicator.parameters.addInteger("Period", "Period", "", 200);

    indicator.parameters.addGroup("Style");
    indicator.parameters.addColor("clr", "Color", "Color", core.rgb(0, 255, 0));
}

var first;
var source = null;
var Period;
var CO;
var BS=null;

function Prepare()
{
    source = instance.source;
    Period=instance.parameters.Period;
    first = source.first()+2;
    CO = instance.addInternalStream(first, 0);
    var name = profile.id() + "(" + source.name() + ", " + instance.parameters.Period + ")";
    instance.name(name);
    BS = instance.addStream("BS", core.Bar, name + ".BS", "BS", instance.parameters.clr, first);
    BS.addLevel(0);
}

function CalcStdDev(Arr, ArrCount)
{
  var i;
  var Sum, Avg;
  Sum=0;
  for (i=0; i<=ArrCount-1; i++) 
  {
    Sum=Sum+Arr[i];
  }
  Avg=Sum/ArrCount;

  Sum=0;
  for (i=0; i<=ArrCount-1; i++) 
  {
    Sum=Sum+Math.pow(Arr[i]-Avg, 2);
  }
  return (Math.sqrt(Sum/ArrCount));
}

function Update(period, mode)
{
   if (period>first) 
   {
    CO[period]=source.close[period]-source.open[period];
    if (period>first+Period) 
    {
      var PA = {};
      var NA = {};
      var NCount=0;
      var PCount=0;
      var i;
      for (i=0; i<=Period-1; i++) 
      {
        if (CO[period-i]>0) 
        {
          PA[PCount]=CO[period-i];
          PCount=PCount+1;
        } 
        else
        {
          if (CO[period-i]<0) 
          {
           NA[NCount]=CO[period-i];
           NCount=NCount+1;
          } 
        }
      }
      if (PCount>0 && NCount>0) 
      {
        var PStdDev=CalcStdDev(PA, PCount);
        var NStdDev=CalcStdDev(NA, NCount);
        if (NStdDev!=0) 
        {
          BS[period]=PStdDev/NStdDev;
        }
      }
    }
   } 
}

