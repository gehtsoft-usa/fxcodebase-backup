// Indicator profile initialization routine
// Defines indicator profile properties && indicator parameters
function Init()
{
    indicator.name("Detrend Price Oscillator");
    indicator.description("Oscillator eliminates the trend effect of price movement.");
    indicator.requiredSource(core.Tick);
    indicator.type(core.Oscillator);

    indicator.parameters.addInteger("N", "Number of periods", "", 12);
    indicator.parameters.addColor("L_color", "Color of oscillator", "Color of oscillator", core.rgb(255, 0, 0));
}

// Indicator instance initialization routine
// Processes indicator parameters && creates output streams
// TODO. Refine the first period calculation for each of the output streams.
// TODO. Calculate all constants, create instances all subsequent indicators && load all required libraries
// Parameters block
var N;

var first;
var source = null;

// Streams block
var L = null;

// Routine
function Prepare()
{
    N = instance.parameters.N;
    source = instance.source;
    var name = profile.id() + "(" + source.name() + ", " + N + ")";
    instance.name(name);
    N = N / 2 + 1;
    first = source.first() + N;
    L = instance.addStream("L", core.Line, name, "L", instance.parameters.L_color, first);
    L.addLevel(0);
}

// Indicator calculation routine
// TODO. Add your code for calculation output values
function Update(period)
{
    if (period >= first) 
    {
        var range;
        range = core.rangeTo(period, N);
        L[period] = source[period] - Math.avg(source, range);
    }
}

