function Init()
{
    indicator.name("FoM");
    indicator.description("FoM");
    indicator.requiredSource(core.Bar);
    indicator.type(core.Oscillator);

    indicator.parameters.addGroup("Calculation");

    indicator.parameters.addInteger("Period", "Period", "", 10);
    indicator.parameters.addString("Method" , "Type of Moving Average", "", "EMA");
    indicator.parameters.addStringAlternative("Method" , "Exponential Moving Average", "", "EMA");
    indicator.parameters.addStringAlternative("Method" , "Simple Moving Average", "", "MVA");
    indicator.parameters.addStringAlternative("Method", "Smoothed Moving Average", "", "SMMA");
    indicator.parameters.addStringAlternative("Method" , "Linear Weighted Moving Average", "", "LWMA");
    
    indicator.parameters.addGroup("Style");

    indicator.parameters.addColor("clr", "FoM Color", "", core.rgb(72, 159, 83));
    indicator.parameters.addString("Kind_of_Line" , "Kind of FoM Line", "", "Solid");
    indicator.parameters.addStringAlternative("Kind_of_Line" , "Solid line", "", "Solid");
    indicator.parameters.addStringAlternative("Kind_of_Line" , "Dot line", "", "Dot");
    indicator.parameters.addStringAlternative("Kind_of_Line", "Dash line", "", "Dash");
    indicator.parameters.addStringAlternative("Kind_of_Line" , "Dash-dot line", "", "Dash-dot");
    indicator.parameters.addInteger("Width", "FoM Width", "", 2);
    
}

var first;
var source = null;
var Period, Method;
var av, sd, RV, aMove, MaxM, MinM, demonM, Move, MaxV, MinV, demonV, Vol, vByM, avF, sdF;
var FoM;
var clr, Kind_of_Line, Width;

function Prepare()
{
    source = instance.source;
    Period=instance.parameters.Period;
    Method=instance.parameters.Method;
   
    first = source.first();
    clr=instance.parameters.clr;
    Kind_of_Line=instance.parameters.Kind_of_Line;
    Width=instance.parameters.Width;

    var name = profile.id() + "(" + source.name()+ ")";
    instance.name(name);

    FoM = instance.addStream("FoM", core.Line, name + ".FoM", "FoM", instance.parameters.clr, first);
        
        if (Kind_of_Line=="Solid") 
        {
            FoM.setStyle (core.LINE_SOLID);
        }
        else if (Kind_of_Line=="Dot") 
        {
            FoM.setStyle (core.LINE_DOT);
        }
        else if (Kind_of_Line=="Dash") 
        {
            FoM.setStyle (core.LINE_DASH);
        }
        else if (Kind_of_Line=="Dash-dot") 
        {
            FoM.setStyle (core.LINE_DASHDOT);
        }   
        FoM.setWidth (Width);
    aMove = instance.addInternalStream(first);
    RV = instance.addInternalStream(first);
    vByM = instance.addInternalStream(first);

    av=core.indicators.create(Method, source.volume, Period);
    sd=core.indicators.create("STDDEV", source.volume, Period);  
    avF=core.indicators.create(Method, vByM, Period);
    sdF=core.indicators.create("STDDEV", vByM, Period);  


}

function Update(period, mode)
{    
    if (period>first+Period) 
    {
        av.update(mode);
        sd.update(mode);
        if (sd.DATA[period]!=0 && source.close[period-1]!=0) 
        {
            RV[period]=(source.volume[period]-av.DATA[period])/sd.DATA[period];
            aMove[period]=Math.abs(source.close[period]-source.close[period-1])/source.close[period-1];
            var  j;
            MaxM=0;
            MinM=1000000000000;
            MaxV=0;
            MinV=1000000000000;
            for (j=period-Period+1; j<=period; j++) 
            {
                MaxM=Math.max(MaxM, aMove[j]);
                MinM=Math.min(MinM, aMove[j]);
                MaxV=Math.max(MaxV, RV[j]);
                MinV=Math.min(MinV, RV[j]);
            }
            demonM = MaxM-MinM;
            if (demonM!=0 && demonV!=0) 
            {
                Move = 1+9*(aMove[period]-MinM)/Math.abs(demonM);
                demonV = MaxV-MinV;
                Vol = 1+9*(RV[period]-MinV)/Math.abs(demonV);
                if (Move!=0) 
                {
                    vByM[period] = Vol/Move;
                    avF.update(mode);
                    sdF.update(mode);
                    if (sdF.DATA[period]!=0) 
                    {
                        FoM[period] = (vByM[period]-avF.DATA[period])/sdF.DATA[period];
                    }
                }
            }
        }
    }
}

