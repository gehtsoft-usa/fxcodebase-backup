function Init()
{
    indicator.name("Side Winder indicator");
    indicator.description("Side Winder indicator");
    indicator.requiredSource(core.Bar);
    indicator.type(core.Oscillator);
    
    indicator.parameters.addColor("clr1", "Color 1", "Color 1", core.rgb(0, 255, 0));
    indicator.parameters.addColor("clr2", "Color 2", "Color 2", core.rgb(255, 255, 0));
    indicator.parameters.addColor("clr3", "Color 3", "Color 3", core.rgb(255, 0, 0));
}

var first;
var source = null;
var MA;
var buff4;
var buff5;
var buff6;
var buff1={};
var buff2={};
var buff3={};

function Prepare()
{
    source = instance.source;
    buff4 = instance.addInternalStream(0, 0);
    buff5 = instance.addInternalStream(0, 0);
    buff6 = instance.addInternalStream(0, 0);
    MA = core.indicators.create("EMA", source.close, 34);
    first = MA.DATA.first()+2;
    var name = profile.id() + "(" + source.name() + ")";
    instance.name(name);
    buff1 = instance.createTextOutput ("buff1", "buff1", "Wingdings", 10, core.H_Center, core.V_Center, instance.parameters.clr1, 0);
    buff2 = instance.createTextOutput ("buff2", "buff2", "Wingdings", 10, core.H_Center, core.V_Center, instance.parameters.clr2, 0);
    buff3 = instance.createTextOutput ("buff3", "buff3", "Wingdings", 10, core.H_Center, core.V_Center, instance.parameters.clr3, 0);
}

function Update(period, mode)
{
    MA.update(mode);
    if (period>first+30) 
    {
     var var3=0;
     var var2;
     for (i=1; i<=25; i++) 
     {
      var2=26-i;
      var3=var3+(var2-8)*source.close[period-i+1];
     }
     buff6[period]=6.*var3/650.;
     buff4[period]=MA.DATA[period];
     buff5[period]=buff6[period];
     var var4=(source.close[period-1]+source.high[period-1]+source.low[period-1])/3.;
     var tmp=Math.minmax(source, period-29, period);
     var var5=25./(tmp[1]-tmp[0])*tmp[0];
     var var6=(buff4[period-1]-buff4[period])/var4*var5;
     var var7=Math.sqrt(1.+var6*var6);
     var var8=Math.ceil(180.*Math.acos(1./var7)/3.1415916);
     if (var6>0.) 
     {
      var8=-1.*var8;
     }
     var var9=(buff5[period-1]-buff5[period])/var4*var5;
     var var10=Math.sqrt(1.+var9*var9);
     var var11=Math.ceil(180.*Math.acos(1./var10)/3.1415926);
     if (var9>0.) 
     {
      var11=-1.*var11;
     }
     var var1=0;
     if ((var8<10. && var8>=0. && var11+var8>=10.) || (var11<10. && var11>=0. && var11+var8>=10.))
     {
      var1=1;
     } 
     else if ((var8>-10. && var8<=0. && var11+var8<=-10.) || (var11>-10. && var11<=0. && var11+var8<=-10.))
     {
      var1=1;
     } 
     else if (var8<=-10. && var11<=-10.) 
     {
      var1=2;
     } 
     else if (var8>=10. && var11>=10.) 
     {
      var1=2;
     }
     if (var1==2) 
     {
      buff1.set(period, 50, "\110");
     } 
     else if (var1==1) 
     {
      buff2.set(period, 50, "\110");
     } 
     else
     {
      buff3.set(period, 50, "\110");
     }
    } 
}

