function Init()
{
    indicator.name("TD Lines indicator");
    indicator.description("TD Lines indicator");
    indicator.requiredSource(core.Bar);
    indicator.type(core.Indicator);

    indicator.parameters.addGroup("Calculation");
    indicator.parameters.addBoolean("FractalAsTD", "FractalAsTD", "", false);

    indicator.parameters.addGroup("Style");
    indicator.parameters.addColor("clrUP", "Color UP", "Color UP", core.rgb(0, 255, 0));
    indicator.parameters.addColor("clrDN", "Color DN", "Color DN", core.rgb(255, 0, 0));
    indicator.parameters.addColor("clrL1", "Color L1", "Color L1", core.rgb(0, 255, 0));
    indicator.parameters.addColor("clrL2", "Color L2", "Color L2", core.rgb(255, 0, 0));
    indicator.parameters.addInteger("widthLinReg", "Line width", "Line width", 1, 1, 5);
    indicator.parameters.addInteger("styleLinReg", "Line style", "Line style", core.LINE_SOLID);
    indicator.parameters.setFlag("styleLinReg", core.FLAG_LINE_STYLE);
}

var first;
var source = null;
var FractalAsTD;
var buffUp;
var buffDn;
var up=null;
var down=null;

function Prepare()
{
    source = instance.source;
    FractalAsTD=instance.parameters.FractalAsTD;
    first = source.first()+6;
    up = instance.addInternalStream(first, 0);
    down = instance.addInternalStream(first, 0);
    var name = profile.id() + "(" + source.name() + ")";
    instance.name(name);
    buffUp = instance.createTextOutput ("Up", "Up", "Wingdings", 10, core.H_Center, core.V_Center, instance.parameters.clrUP, first);
    buffDn = instance.createTextOutput ("Dn", "Dn", "Wingdings", 10, core.H_Center, core.V_Center, instance.parameters.clrDN, first);
}

function Update(period, mode)
{
   if (period>first) 
   {
    if (!FractalAsTD) 
    {
     if (source.high[period-3]<source.high[period-2] && source.high[period-1]<source.high[period-2]) 
     {
      up[period-2]=source.high[period-2];
      buffUp.set(period-2, source.high[period-2], "\159", "");
     }
     if (source.high[period-4]<source.high[period-2] && source.high[period-3]==source.high[period-2] && source.high[period-1]<source.high[period-2]) 
     {
      up[period-2]=source.high[period-2];
      buffUp.set(period-2, source.high[period-2], "\159", "");
     }
     if (source.high[period-5]<source.high[period-2] && source.high[period-4]==source.high[period-2] && source.high[period-3]==source.high[period-2] && source.high[period-1]<source.high[period-2]) 
     {
      up[period-2]=source.high[period-2];
      buffUp.set(period-2, source.high[period-2], "\159", "");
     }
     if (source.high[period-6]<source.high[period-2] && source.high[period-5]==source.high[period-2] && source.high[period-4]==source.high[period-2] && source.high[period-3]==source.high[period-2] && source.high[period-1]<source.high[period-2]) 
     {
      up[period-2]=source.high[period-2];
      buffUp.set(period-2, source.high[period-2], "\159", "");
     }
     
     if (source.low[period-3]>source.low[period-2] && source.low[period-1]>source.low[period-2]) 
     {
      down[period-2]=source.low[period-2];
      buffDn.set(period-2, source.low[period-2], "\159", "");
     }
     if (source.low[period-4]>source.low[period-2] && source.low[period-3]==source.low[period-2] && source.low[period-1]>source.low[period-2]) 
     {
      down[period-2]=source.low[period-2];
      buffDn.set(period-2, source.low[period-2], "\159", "");
     }
     if (source.low[period-5]>source.low[period-2] && source.low[period-4]==source.low[period-2] && source.low[period-3]==source.low[period-2] && source.low[period-1]>source.low[period-2]) 
     {
      down[period-2]=source.low[period-2];
      buffDn.set(period-2, source.low[period-2], "\159", "");
     }
     if (source.low[period-6]>source.low[period-2] && source.low[period-5]==source.low[period-2] && source.low[period-4]==source.low[period-2] && source.low[period-3]==source.low[period-2] && source.low[period-1]>source.low[period-2]) 
     {
      down[period-2]=source.low[period-2];
      buffDn.set(period-2, source.low[period-2], "\159", "");
     }
    } 
    else
    {
     if (source.high[period-3]>source.high[period-2] && source.high[period-3]>source.high[period-1] && source.high[period-3]>source.high[period-4] && source.high[period-3]>source.high[period-5]) 
     {
      up[period-3]=source.high[period-3];
      buffUp.set(period-3, source.high[period-3], "\159", "");
     }
     if (source.low[period-3]<source.low[period-2] && source.low[period-3]<source.low[period-1] && source.low[period-3]<source.low[period-4] && source.low[period-3]<source.low[period-5]) 
     {
      down[period-3]=source.low[period-3];
      buffDn.set(period-3, source.low[period-3], "\159", "");
     }
    }
  }
    
    var H1=null;
    var H2=null;
    var L1=null;
    var L2=null;
  
    if (period==source.size()-1) 
    {
     var i=period;
     while ((H2==null || L2==null) && i>first) 
     {
    
     if (up[i]==source.high[i]) 
     {
      if (H1==null) 
      {
       H1=i;
      } 
      else if (up[i]>up[H1] && H2==null) 
      { 
       H2=i;
      }
     }
     
     if (down[i]==source.low[i]) 
     {
      if (L1==null) 
      {
       L1=i;
      } 
      else if (down[i]<down[L1] && L2==null) 
      { 
       L2=i;
      }
     }
     
     i=i-1;
    }

    if ((H1!=null && H2!=null) || (L1!=null && L2!=null)) 
    {
     core.host.execute("removeAll");
    }
    
    if (H1!=null && H2!=null) 
    {
     core.host.execute("drawLine", 1, source.date(H2), up[H2]-0.5*(up[H1]-up[H2])/(H1-H2), source.date(period), up[H2]+(period-H2-0.5)*(up[H1]-up[H2])/(H1-H2),instance.parameters.clrUP,instance.parameters.styleLinReg,instance.parameters.widthLinReg);
    }
    if (L1!=null && L2!=null) 
    {
     core.host.execute("drawLine", 2, source.date(L2), down[L2]-0.5*(down[L1]-down[L2])/(L1-L2), source.date(period), down[L2]+(period-L2-0.5)*(down[L1]-down[L2])/(L1-L2),instance.parameters.clrDN,instance.parameters.styleLinReg,instance.parameters.widthLinReg);
    }
    

   }
    
  
}

