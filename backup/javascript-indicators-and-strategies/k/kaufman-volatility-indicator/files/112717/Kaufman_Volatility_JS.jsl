function Init()
{
    indicator.name("Kaufman volatility indicator");
    indicator.description("Kaufman volatility indicator");
    indicator.requiredSource(core.Bar);
    indicator.type(core.Oscillator);

    indicator.parameters.addGroup("Calculation");
    indicator.parameters.addInteger("Period", "Period", "", 10);

    indicator.parameters.addGroup("Style");
    indicator.parameters.addColor("clr", "Color", "Color", core.rgb(0, 255, 0));
}

var first;
var source = null;
var Period;
var DiffPrice;
var KVol=null;

function Prepare()
{
    source = instance.source;
    Period=instance.parameters.Period;
    first = source.first()+2;
    DiffPrice = instance.addInternalStream(first, 0);
    var name = profile.id() + "(" + source.name() + ", " + instance.parameters.Period + ")";
    instance.name(name);
    KVol = instance.addStream("KVol", core.Bar, name + ".KVol", "KVol", instance.parameters.clr, first);
}

function Update(period, mode)
{
   if (period>first)
   {
    DiffPrice[period]=Math.abs(source.close[period]-source.close[period-1]);
   }
   if (period>first+Period)
   {
    KVol[period]=Math.avg(DiffPrice,core.rangeTo(period,Period));
   } 
}

