//initializes the indicator
function Init()
{
    indicator.name("Triangular Moving Average");
    indicator.description("Triangular Moving Average");
    indicator.requiredSource(core.Tick);
    indicator.type(core.Indicator);
    indicator.setTag("group", "Moving Averages");

    indicator.parameters.addGroup("Calculation");
    indicator.parameters.addInteger("N", "Number of periods", "The number of periods.", 14, 1, 10000);
    indicator.parameters.addGroup("Style");
    indicator.parameters.addColor("clr", "Line color", "The color of line", core.rgb(255, 83, 83));
    indicator.parameters.addInteger("width", "Line width", "The width of line", 1, 1, 5);
    indicator.parameters.addInteger("style", "Line style", "The style of line", core.LINE_SOLID);
    indicator.parameters.setFlag("style", core.FLAG_LEVEL_STYLE);
}

var first = 0;
var n = 0;
var source = null;
var TMA;
var wma = null;
var wmaFirst = null;

var len = 0;

//initializes the instance of the indicator
function Prepare(onlyName)
{
    source = instance.source;
    n = instance.parameters.N;
    var name = profile.id() + "(" + instance.source.name() + "," + n + ")";
    instance.name(name);
  
    if (onlyName == true)
        return ;
    len = Math.floor(n / 2);
    len = len + 1;
    wma = instance.addInternalStream(source.first() + len, 0);
    wmaFirst = wma.first();
    first = wmaFirst + len;

    TMA = instance.addStream("TMA", core.Line, name, "TMA", instance.parameters.clr,  first);
    TMA.setWidth(instance.parameters.width);
    TMA.setStyle(instance.parameters.style);
}

// calculate the value
function Update(period, mode)
{
    if (period >= wmaFirst)
    {
        wma[period] = Math.avg(source, period - len + 1, period);
    }
    
    if (period >= first)
    {
        TMA[period] = Math.avg(wma, period - len + 1, period);
    }
    
}