//initializes the indicator
function Init()
{
    indicator.name("ARSI");
    indicator.description("Adaptive Relative Strength Index");
    indicator.requiredSource(core.Tick);
    indicator.type(core.Indicator);
    indicator.setTag("group", "Trend");

    indicator.parameters.addGroup("Calculation");
    indicator.parameters.addInteger("N", "Number of periods", "The number of periods.", 14, 1, 10000);
    indicator.parameters.addGroup("Style");
    indicator.parameters.addColor("clr", "Line color", "Line color", core.rgb(219, 64, 0));
    indicator.parameters.addInteger("width", "Line width", "Line width", 1, 1, 5);
    indicator.parameters.addInteger("style", "Line style", "Line style", core.LINE_SOLID);
    indicator.parameters.setFlag("style", core.FLAG_LEVEL_STYLE);
}

var first = 0;
var n = 0;
var source = null;
var ARSI = null;
var RSI;

//initializes the instance of the indicator
function Prepare(onlyName)
{
    source = instance.source;
    n = instance.parameters.N;
    var name = profile.id() + "(" + instance.source.name() + "," + n + ")";
    instance.name(name);
  
    if (onlyName == true)
        return ;
    first = source.first() + 1;
    RSI = core.indicators.create("RSI", source, n);

    ARSI = instance.addStream("ARSI", core.Line, name, "ARSI", instance.parameters.clr,  first)
    ARSI.setWidth(instance.parameters.width);
    ARSI.setStyle(instance.parameters.style);
}

// calculate the value
function Update(period, mode)
{
    if (period > first)
    {
        RSI.update(mode);
        var sc = RSI.DATA[period] / 100;
        sc = Math.abs(sc - 0.5) * 2;
        var arsiPrev = ARSI[period - 1];
        ARSI[period] = arsiPrev + sc * (source[period] - arsiPrev);    
    }
    else
    {
       if (period == first)
       {
          ARSI[period] = source[period];
       }
    }
}