function Init()
{
    indicator.name("The River");
    indicator.description("Presented by ForPipSake");
    indicator.requiredSource(core.Tick);
    indicator.type(core.Indicator);

    indicator.parameters.addGroup("Calculation");
    indicator.parameters.addInteger("Period", "Period", "", 50);
    indicator.parameters.addInteger("Power", "Power", "", 2, 1, 9);
    indicator.parameters.addDouble("Deviation", "Deviation", "", 1);

    indicator.parameters.addGroup("Style");
    indicator.parameters.addColor("clrReg", "Color regression", "Color regression", core.rgb(255, 0, 0));
    indicator.parameters.addColor("clrBand", "Color band", "Color band", core.rgb(0, 0, 255));
    indicator.parameters.addInteger("width", "width", "width", 1, 1, 5);
    indicator.parameters.addInteger("style", "style", "style", core.LINE_SOLID);
    indicator.parameters.setFlag("style", core.FLAG_LEVEL_STYLE);
}

var first;
var source = null;
var Period;
var Power;
var Deviation;
var BuffReg=null;
var BuffBandUp=null;
var BuffBandDn=null;

function Prepare()
{
    source = instance.source;
    Period=instance.parameters.Period;
    Power=instance.parameters.Power;
    Deviation=instance.parameters.Deviation;
    first = source.first()+2;
    var name = profile.id() + "(" + source.name() + ", " + instance.parameters.Period + ", " + instance.parameters.Power + ", " + instance.parameters.Deviation + ")";
    instance.name(name);
    BuffReg = instance.addStream("BuffReg", core.Line, name + ".Regression", "Regression", instance.parameters.clrReg, first);
    BuffBandUp = instance.addStream("BuffBandUp", core.Line, name + ".BandUp", "BandUp", instance.parameters.clrBand, first);
    BuffBandDn = instance.addStream("BuffBandDn", core.Line, name + ".BandDn", "BandDn", instance.parameters.clrBand, first);
    BuffReg.setWidth(instance.parameters.width);
    BuffReg.setStyle(instance.parameters.style);
    BuffBandUp.setWidth(instance.parameters.width);
    BuffBandUp.setStyle(instance.parameters.style);
    BuffBandDn.setWidth(instance.parameters.width);
    BuffBandDn.setStyle(instance.parameters.style);
}

function Update(period, mode)
{
   if (period==source.size()-1) 
   {
    var i,ii;
    var sumxvalue={};
    var sumyvalue={};
    var constant={};
    var matrix={};
    var pos=period-Period+1;
    
    for (i=0; i<=Power+1; i++) 
    {
     sumyvalue[i]=0;
     constant[i]=0;
     matrix[i]={};
     for (ii=0; ii<=Power+1; ii++) 
     {
      matrix[i][ii]=0;
     }
    }
    for (i=0; i<=2*Power+1; i++) 
    {
     sumxvalue[i]=0;
    }
    sumxvalue[0]=Period;
    var exp;
    for (exp=1; exp<=2*Power; exp++) 
    {
     var sumx=0;
     var sumy=0;
     var k;
     for (k=1; k<=Period; k++) 
     {
      sumx=sumx+Math.pow(k,exp);
      if (exp==1) 
      {
       sumy=sumy+source[pos+k-1];
      } 
      else if (exp<=Power+1) 
      {
       sumy=sumy+source[pos+k-1]*Math.pow(k,exp-1);
      }
     }
     sumxvalue[exp]=sumx;
     if (sumy!=0) 
     {
      sumyvalue[exp-1]=sumy;
     }
    }

    var row;
    var col;
    for (row=0; row<=Power; row++) 
    {
     for (col=0; col<=Power; col++) 
     {
      matrix[row][col]=sumxvalue[row+col];
     }
    }  
    var initialRow=1;
    var initialCol=1;
    for (i=1; i<=Power; i++) 
    {
     for (row=initialRow; row<=Power; row++) 
     {
      sumyvalue[row]=sumyvalue[row]-(matrix[row][i-1]/matrix[i-1][i-1])*sumyvalue[i-1];
      for (col=initialCol; col<=Power; col++) 
      {
       matrix[row][col]=matrix[row][col]-(matrix[row][i-1]/matrix[i-1][i-1])*matrix[i-1][col];
      }
     }
     initialCol=initialCol+1;
     initialRow=initialRow+1;
    }
    var j=0;
    for (i=Power; i>=0; i--) 
    {
     if (j==0) 
     {
      constant[i]=sumyvalue[i]/matrix[i][i];
     } 
     else
     {
      var sum=0;
      var k;
      for (k=j; k>=1; k--) 
      {
       sum=sum+constant[i+k]*matrix[i][i+k];
      } 
      constant[i]=(sumyvalue[i]-sum)/matrix[i][i];
     }
     j=j+1;
    }
    k=1;
    for (i=period-Period+1; i<=period; i++) 
    {
     sum=0;
     for (j=0; j<=Power; j++) 
     {
      sum=sum+constant[j]*Math.pow(k,j);
     }
     BuffReg[i]=sum;
     k=k+1;
    }
    BuffReg[period-Period]=null;
    
    sum=0;
    for (i=period-Period+1; i<=period; i++) 
    {
     sum=sum+Math.pow(source[i]-BuffReg[i],2)
    }
    var variance=Math.sqrt(sum/Period);
    for (i=period-Period+1; i<=period; i++) 
    {
     BuffBandUp[i]=BuffReg[i]+Deviation*variance;
     BuffBandDn[i]=BuffReg[i]-Deviation*variance;
    }
    BuffBandUp[period-Period]=null;
    BuffBandDn[period-Period]=null;
   } 
}

