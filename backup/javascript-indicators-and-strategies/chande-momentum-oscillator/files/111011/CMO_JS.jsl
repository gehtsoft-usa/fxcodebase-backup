//initializes the indicator
function Init()
{
    indicator.name("Chande Momentum Oscillator");
    indicator.description("Chande Momentum Oscillator");
    indicator.requiredSource(core.Tick);
    indicator.type(core.Oscillator);
    indicator.setTag("group", "Classic Oscillators");

    indicator.parameters.addGroup("Calculation");
    indicator.parameters.addInteger("P", "Number of periods", "The number of periods.", 9, 1, 10000);
    indicator.parameters.addGroup("Style");
    indicator.parameters.addColor("clr", "Line color", "The color of line", core.rgb(0, 128, 255));
    indicator.parameters.addInteger("width", "Line width", "The width of line", 1, 1, 5);
    indicator.parameters.addInteger("style", "Line style", "The style of line", core.LINE_SOLID);
    indicator.parameters.setFlag("style", core.FLAG_LEVEL_STYLE);
}

var first = 0;
var first_cm=0;
var P = 0;
var source = null;
var CMO;
var cmo1, cmo2;

//initializes the instance of the indicator
function Prepare(onlyName)
{
    source = instance.source;
    P = instance.parameters.P;
    var name = profile.id() + "(" + instance.source.name() + "," + P + ")";
    instance.name(name);
  
    if (onlyName == true)
        return ;
    first_cm = source.first() + 1;
    first = first_cm + P;

    cmo1 = instance.addInternalStream(first_cm, 0);
    cmo2 = instance.addInternalStream(first_cm, 0);

    CMO = instance.addStream("CMO", core.Line, name, "CMO", instance.parameters.clr,  first)
    CMO.setWidth(instance.parameters.width);
    CMO.setStyle(instance.parameters.style);
    CMO.addLevel(100);
    CMO.addLevel(0);
    CMO.addLevel(-100);
}

// calculate the value
function Update(period, mode)
{
    cmo1[period] = 0;
    cmo2[period] = 0;

    if (period >= first_cm)
    {
        var diff;
        diff = source[period] - source[period - 1];
        if (diff > 0)
        {
            cmo1[period] = diff;
        }
        else
        {
            if (diff < 0)
            {
                cmo2[period] = -diff;
            }
        }
    }

    if (period >= first)
    {
        var p, cmo, s1, s2;
        p = period - P + 1;
        s1 = Math.sum(cmo1, p, period);
        s2 = Math.sum(cmo2, p, period);
        CMO[period] = (s1 - s2) / (s1 + s2) * 100;
    }
}