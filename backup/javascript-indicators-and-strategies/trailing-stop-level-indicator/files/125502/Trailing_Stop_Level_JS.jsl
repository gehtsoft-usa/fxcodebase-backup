function Init()
{
    indicator.name("Trailing Stop level indicator");
    indicator.description("Trailing Stop level indicator");
    indicator.requiredSource(core.Bar);
    indicator.type(core.Indicator);

    indicator.parameters.addGroup("Calculation");
    indicator.parameters.addDouble("Percent", "Percent", "", 1);

    indicator.parameters.addGroup("Style");
    indicator.parameters.addColor("UPclr", "UP color", "UP color", core.rgb(0, 255, 0));
    indicator.parameters.addColor("DNclr", "DN color", "DN color", core.rgb(255, 0, 0));
    indicator.parameters.addInteger("widthLinReg", "Line width", "Line width", 1, 1, 5);
    indicator.parameters.addInteger("styleLinReg", "Line style", "Line style", core.LINE_SOLID);
    indicator.parameters.setFlag("styleLinReg", core.FLAG_LINE_STYLE);
}

var first;
var source = null;
var Percent;
var TSL=null;

function Prepare()
{
    source = instance.source;
    Percent=instance.parameters.Percent/100;
    first = source.first()+2;
    var name = profile.id() + "(" + source.name() + ", " + instance.parameters.Percent + ")";
    instance.name(name);
    TSL = instance.addStream("TSL", core.Line, name + ".TSL", "TSL", instance.parameters.UPclr, first);
    TSL.setWidth(instance.parameters.widthLinReg);
    TSL.setStyle(instance.parameters.styleLinReg);
}

function Update(period, mode)
{
   if (period>first) 
   {
    var loss=source.close[period]*Percent;
    if (source.close[period]>TSL[period-1] && source.close[period-1]>TSL[period-1]) 
    {
     TSL[period]=Math.max(TSL[period-1], source.close[period]-loss);
     TSL.setColor(period, instance.parameters.DNclr);
    } 
    else if (source.close[period]<TSL[period-1] && source.close[period-1]<TSL[period-1]) 
    {
     TSL[period]=Math.min(TSL[period-1], source.close[period]+loss);
     TSL.setColor(period, instance.parameters.UPclr);
    } 
    else if (source.close[period]>TSL[period-1]) 
    {
     TSL[period]=source.close[period]-loss;
     TSL.setColor(period, instance.parameters.DNclr);
    } 
    else
    {
     TSL[period]=source.close[period]+loss;
     TSL.setColor(period, instance.parameters.UPclr);
    } 
   } 
}

