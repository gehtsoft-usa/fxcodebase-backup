function Init()
{
    indicator.name("Standard deviation of High/Low");
    indicator.description("Standard deviation of High/Low");
    indicator.requiredSource(core.Bar);
    indicator.type(core.Oscillator);

    indicator.parameters.addGroup("Calculation");
    indicator.parameters.addInteger("Period", "Period", "", 30);

    indicator.parameters.addGroup("Style");
    indicator.parameters.addColor("clr", "Color", "Color", core.rgb(255, 255, 0));
    indicator.parameters.addInteger("widthLinReg", "Line width", "Line width", 1, 1, 5);
    indicator.parameters.addInteger("styleLinReg", "Line style", "Line style", core.LINE_SOLID);
    indicator.parameters.setFlag("styleLinReg", core.FLAG_LINE_STYLE);
}

var first;
var source = null;
var Period;
var HL;
var StdDev;
var HL_StdDev=null;

function Prepare()
{
    source = instance.source;
    Period=instance.parameters.Period;
    first = source.first()+2;
    HL = instance.addInternalStream(first, 0);
    StdDev = core.indicators.create("STDDEV", HL, Period);
    var name = profile.id() + "(" + source.name() + ", " + instance.parameters.Period + ")";
    instance.name(name);
    HL_StdDev = instance.addStream("HL_StdDev", core.Line, name + ".HL_StdDev", "HL_StdDev", instance.parameters.clr, first);
    HL_StdDev.setWidth(instance.parameters.widthLinReg);
    HL_StdDev.setStyle(instance.parameters.styleLinReg);
}

function Update(period, mode)
{
   if (period>first+Period) 
   {
    HL[period]=source.high[period]-source.low[period];
    StdDev.update(mode);
    HL_StdDev[period]=StdDev.DATA[period];
   } 
}

