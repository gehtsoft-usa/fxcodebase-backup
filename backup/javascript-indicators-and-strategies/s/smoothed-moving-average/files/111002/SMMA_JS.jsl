//initializes the indicator
function Init()
{
    indicator.name("Smoothed Moving Average");
    indicator.description("Smoothed Moving Average");
    indicator.requiredSource(core.Tick);
    indicator.type(core.Indicator);
    indicator.setTag("group", "Moving Averages");

    indicator.parameters.addGroup("Calculation");
    indicator.parameters.addInteger("N", "Number of periods", "The number of periods.", 7, 1, 10000);
    indicator.parameters.addGroup("Style");
    indicator.parameters.addColor("clr", "Line color", "The color of line", core.rgb(192, 192, 131));
    indicator.parameters.addInteger("width", "Line width", "The width of line", 1, 1, 5);
    indicator.parameters.addInteger("style", "Line style", "The style of line", core.LINE_SOLID);
    indicator.parameters.setFlag("style", core.FLAG_LEVEL_STYLE);
}

var first = 0;
var N = 0;
var source = null;
var SMMA;

//initializes the instance of the indicator
function Prepare(onlyName)
{
    source = instance.source;
    N = instance.parameters.N;
    var name = profile.id() + "(" + instance.source.name() + "," + N + ")";
    instance.name(name);
  
    if (onlyName == true)
        return ;
    first = source.first() + N - 1;

    SMMA = instance.addStream("SMMA", core.Line, name, "SMMA", instance.parameters.clr,  first);
    SMMA.setWidth(instance.parameters.width);
    SMMA.setStyle(instance.parameters.style);
}

// calculate the value
function Update(period, mode)
{
    if (period == first)
    {
        SMMA[period] = Math.avg(source, period - N + 1, period);
    }
    else
    {
        if (period > first)
        {
            SMMA[period] = (SMMA[period - 1] * (N - 1) + source[period]) / N;
        }
    }
    
}