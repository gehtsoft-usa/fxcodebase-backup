function Init()
{
    indicator.name("Check power indicator");
    indicator.description("Check power indicator");
    indicator.requiredSource(core.Bar);
    indicator.type(core.Indicator);

    indicator.parameters.addGroup("Style");
    indicator.parameters.addColor("UPclr", "UP color", "UP color", core.rgb(0, 255, 0));
    indicator.parameters.addColor("DNclr", "DN color", "DN color", core.rgb(255, 0, 0));
    indicator.parameters.addInteger("ArrowSize", "Arrow size", "Arrow size", 10);
}

var first;
var source = null;
var UP=null;
var DN=null;

function Prepare()
{
    source = instance.source;
    first = source.first()+2;
    var name = profile.id() + "(" + source.name() + ")";
    instance.name(name);
    UP = instance.createTextOutput ("UP", "UP", "Wingdings", instance.parameters.ArrowSize, core.H_Center, core.V_Top, instance.parameters.UPclr, 0);
    DN = instance.createTextOutput ("DN", "DN", "Wingdings", instance.parameters.ArrowSize, core.H_Center, core.V_Bottom, instance.parameters.DNclr, 0);
}

function Update(period, mode)
{
   if (period>first) 
   {
    var Fl=null;
    var i=period;
    while (Fl==null && i>first) 
    {
     if (source.close[i]-source.low[i]>source.high[i]+source.high[i-1]-source.close[i]-source.close[i-1]) 
     {
      Fl=1;
     } 
     else
     {
      if (source.high[i]-source.close[i]>source.close[i]+source.close[i-1]-source.low[i]-source.low[i-1]) 
      {
       Fl=-1;
      }
     } 
     i=i-1;
    }
    if (Fl==1) 
    {
     if (source.close[period]<source.close[period-1] || source.close[period]<source.close[period-2]) 
     {
      UP.set(period, source.high[period], "\226");
     }
    } 
    else
    {
     if (Fl==-1) 
     {
      if (source.close[period]>source.close[period-1] || source.close[period]>source.close[period-2]) 
      {
      DN.set(period, source.low[period], "\225");
      }
     }
    } 
   } 
}

