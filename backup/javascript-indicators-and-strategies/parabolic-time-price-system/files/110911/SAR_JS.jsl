//initializes the indicator
function Init()
{
    indicator.name("SAR");
    indicator.description("Parabolic Time/Price System");
    indicator.requiredSource(core.Bar);
    indicator.type(core.Indicator);
    indicator.setTag("group", "Trend");

    indicator.parameters.addGroup("Calculation");
    indicator.parameters.addDouble("Step", "Step", "Step", 0.02);
    indicator.parameters.addDouble("Max", "Max", "Max", 0.2);
    indicator.parameters.addGroup("Style");
    indicator.parameters.addColor("Uclr", "Up color", "Up color", core.rgb(255, 0, 0));
    indicator.parameters.addInteger("Uwidth", "Up width", "Up width", 1, 1, 5);
    indicator.parameters.addColor("Dclr", "Down color", "Down color", core.rgb(0, 255, 0));
    indicator.parameters.addInteger("Dwidth", "Down width", "Down width", 1, 1, 5);
}

var first = 0;
var Step = 0;
var Max=0;
var source = null;
var UP = null;
var DOWN=null;
var tradeHigh, tradeLow, parOp, position, af, SAR;

//initializes the instance of the indicator
function Prepare(onlyName)
{
    source = instance.source;
    Step = instance.parameters.Step;
    Max = instance.parameters.Max;
    var name = profile.id() + "(" + instance.source.name() + "," + Step + ", " + Max + ")";
    instance.name(name);
  
    if (onlyName == true)
        return ;
    first = source.first() + 1;

    tradeHigh = instance.addInternalStream(0, 0);
    tradeLow = instance.addInternalStream(0, 0);
    parOp = instance.addInternalStream(0, 0);
    position = instance.addInternalStream(0, 0);
    af = instance.addInternalStream(0, 0);
    SAR = instance.addInternalStream(first, 0);

    UP = instance.addStream("UP", core.Dot, name, "UP", instance.parameters.Uclr,  first);
    UP.setWidth(instance.parameters.Uwidth);
    DOWN = instance.addStream("DOWN", core.Dot, name, "DOWN", instance.parameters.Dclr,  first);
    DOWN.setWidth(instance.parameters.Dwidth);
}

// calculate the value
function Update(period, mode)
{
    var init = Step;
    var quant = Step;
    var maxVal = Max;
    var lastHighest = 0;
    var lastLowest = 0;
    var high = 0;
    var low = 0;
    var prevHigh = 0;
    var prevLow = 0;
    if (period >= first)
    {
        high = source.high[period];
        low = source.low[period];
        prevHigh = source.high[period - 1];
        prevLow = source.low[period - 1];
        if (period == first)
        {
            tradeHigh[period] = prevHigh;
            tradeLow[period] = prevLow;
            position[period] = -1;
            parOp[period] = prevHigh;
            af[period] = 0;
        }
        else
        {
            parOp[period] = parOp[period - 1];
            position[period] = position[period - 1];
            tradeHigh[period] = tradeHigh[period - 1];
            tradeLow[period] = tradeLow[period - 1];
            af[period] = af[period - 1];
        }
        lastHighest = tradeHigh[period];
        lastLowest = tradeLow[period];
        if (high > lastHighest)
        {
            tradeHigh[period] = high;
        }
        if (low < lastLowest)
        {
            tradeLow[period] = low;
        }
        if (position[period] == 1)
        {
            if (low < parOp[period])
            {
                position[period] = -1;
                SAR[period] = lastHighest;
                if (SAR[period] < high)
                {
                    SAR[period] = high;
                }
                tradeHigh[period] = high;
                tradeLow[period] = low;
                af[period] = init;
                parOp[period] = SAR[period] + af[period] * (tradeLow[period] - SAR[period]);
                if (parOp[period] < high)
                {
                    parOp[period] = high;
                }
                if (parOp[period] < prevHigh)
                {
                    parOp[period] = prevHigh;
                }
            }
            else
            {
                SAR[period] = parOp[period];
                if (tradeHigh[period] > tradeHigh[period - 1] && af[period] < maxVal)
                {
                    af[period] = af[period] + quant;
                    if (af[period] > maxVal)
                    {
                        af[period] = maxVal;
                    }
                }

                parOp[period] = SAR[period] + af[period] * (tradeHigh[period] - SAR[period]);
                if (parOp[period] > low)
                {
                    parOp[period] = low;
                }
                if (parOp[period] > prevLow)
                {
                    parOp[period] = prevLow;
                }
            }
        }
        else
        {
            if (high > parOp[period])
            {
                position[period] = 1;
                SAR[period] = lastLowest;
                if (SAR[period] > low)
                {
                    SAR[period] = low;
                }
                tradeHigh[period] = high;
                tradeLow[period] = low;
                af[period] = init;
                parOp[period] = SAR[period] + af[period] * (tradeHigh[period] - SAR[period]);
                if (parOp[period] > low)
                {
                    parOp[period] = low;
                }
                if (parOp[period] > prevLow)
                {
                    parOp[period] = prevLow;
                }
            }
            else
            {
                SAR[period] = parOp[period];
                if (period > 1 && tradeLow[period] < tradeLow[period - 1] && af[period] < maxVal)
                {
                    af[period] = af[period] + quant;
                    if (af[period] > maxVal)
                    {
                        af[period] = maxVal;
                    }
                }

                parOp[period] = SAR[period] + af[period] * (tradeLow[period] - SAR[period]);
                if (parOp[period] < high)
                {
                    parOp[period] = high;
                }
                if (parOp[period] < prevHigh)
                {
                    parOp[period] = prevHigh;
                }
            }
        }

        if (position[period] == 1)
        {
            DOWN[period] = SAR[period];
        }
        else
        {
            UP[period] = SAR[period];
        }
    }
}