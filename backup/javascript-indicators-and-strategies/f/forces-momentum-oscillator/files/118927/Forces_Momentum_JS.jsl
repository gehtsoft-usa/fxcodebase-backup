function Init()
{
    indicator.name("Forces momentum oscillator");
    indicator.description("Forces momentum oscillator");
    indicator.requiredSource(core.Tick);
    indicator.type(core.Oscillator);

    indicator.parameters.addGroup("Calculation");
    indicator.parameters.addInteger("Period1", "Period1", "", 50);
    indicator.parameters.addInteger("Period2", "Period2", "", 14);
    indicator.parameters.addInteger("Period3", "Period3", "", 3);

    indicator.parameters.addGroup("Style");
    indicator.parameters.addColor("Hclr1", "Histogram color 1", "Histogram color 1", core.rgb(0, 255, 0));
    indicator.parameters.addColor("Hclr2", "Histogram color 2", "Histogram color 2", core.rgb(255, 0, 0));
    indicator.parameters.addColor("Hclr3", "Histogram color 3", "Histogram color 3", core.rgb(0, 0, 255));
    indicator.parameters.addColor("Lclr", "Line color", "Line color", core.rgb(225, 255, 0));
    indicator.parameters.addInteger("widthLinReg", "Line width", "Line width", 1, 1, 5);
    indicator.parameters.addInteger("styleLinReg", "Line style", "Line style", core.LINE_SOLID);
    indicator.parameters.setFlag("styleLinReg", core.FLAG_LINE_STYLE);
}

var first;
var source = null;
var Period1;
var Period2;
var Period3;
var H1=null;
var H2=null;
var H3=null;
var L=null;
var MA1, MA2, MA3;

function Prepare()
{
    source = instance.source;
    first = source.first()+2;
    Period1=instance.parameters.Period1;
    Period2=instance.parameters.Period2;
    Period3=instance.parameters.Period3;
    MA1 = core.indicators.create("SMMA", source, Period1);
    MA2 = core.indicators.create("MVA", source, Period2);
    MA3 = core.indicators.create("MVA", source, Period3);
    var name = profile.id() + "(" + source.name() + ", " + instance.parameters.Period1 + ", " + instance.parameters.Period2 + ", " + instance.parameters.Period3 + ")";
    instance.name(name);
    H1 = instance.addStream("H1", core.Bar, name + ".H1", "H1", instance.parameters.Hclr1, first);
    H2 = instance.addStream("H2", core.Bar, name + ".H2", "H2", instance.parameters.Hclr2, first);
    H3 = instance.addStream("H3", core.Bar, name + ".H3", "H3", instance.parameters.Hclr3, first);
    L = instance.addStream("L", core.Line, name + ".L", "L", instance.parameters.Lclr, first);
    L.setWidth(instance.parameters.widthLinReg);
    L.setStyle(instance.parameters.styleLinReg);
}

function Update(period, mode)
{
   if (period>first) 
   {
    MA1.update(mode);
    MA2.update(mode);
    MA3.update(mode);
    H1[period]=(MA1.DATA[period]-MA1.DATA[period-1])*Period1*3;
    H2[period]=(MA2.DATA[period]-MA2.DATA[period-1])*Period2*3;
    H3[period]=(MA3.DATA[period]-MA3.DATA[period-1])*Period3*3;
    L[period]=H1[period]+H2[period]+H3[period];
   } 
}

