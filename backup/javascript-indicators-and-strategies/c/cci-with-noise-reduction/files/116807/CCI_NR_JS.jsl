function Init()
{
    indicator.name("CCI with noise reduction indicator");
    indicator.description("CCI with noise reduction indicator");
    indicator.requiredSource(core.Tick);
    indicator.type(core.Oscillator);

    indicator.parameters.addGroup("Calculation");
    indicator.parameters.addInteger("Period", "Period", "", 14);
    indicator.parameters.addDouble("Sensitivity", "Sensitivity", "", 5);

    indicator.parameters.addGroup("Style");
    indicator.parameters.addColor("clr", "Color", "Color", core.rgb(0, 255, 0));
    indicator.parameters.addInteger("widthLinReg", "Line width", "Line width", 1, 1, 5);
    indicator.parameters.addInteger("styleLinReg", "Line style", "Line style", core.LINE_SOLID);
    indicator.parameters.setFlag("styleLinReg", core.FLAG_LINE_STYLE);
}

var first;
var source = null;
var Period;
var Sensitivity;
var MA;
var CCI_NR=null;
var SensitivityNorm;

function Prepare()
{
    source = instance.source;
    Period=instance.parameters.Period;
    Sensitivity=instance.parameters.Sensitivity;
    first = source.first()+2;
    MA = core.indicators.create("MVA", source, Period);
    var name = profile.id() + "(" + source.name() + ", " + instance.parameters.Period + ", " + instance.parameters.Sensitivity + ")";
    instance.name(name);
    CCI_NR = instance.addStream("CCI_NR", core.Line, name + ".CCI_NR", "CCI_NR", instance.parameters.clr, first);
    SensitivityNorm=Sensitivity*Period*source.pipSize();
    CCI_NR.setWidth(instance.parameters.widthLinReg);
    CCI_NR.setStyle(instance.parameters.styleLinReg);
}

function Update(period, mode)
{
   if (period>first) 
   {
    MA.update(mode);
    var div=0;
    var dif=0;
    var i;
    for (i=period-Period+1; i<=period; i++) 
    {
     div=div+Math.abs(source[i]-MA.DATA[i]);
    }
    div=0.015*Math.max(div,SensitivityNorm)/Period;
    dif=source[period]-MA.DATA[period];
    if (div==0) 
    {
     CCI_NR[period]=0;
    } 
    else
    {
     CCI_NR[period]=dif/div;
    }
   } 
}

