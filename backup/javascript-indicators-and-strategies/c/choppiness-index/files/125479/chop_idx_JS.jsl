function Init()
{
    indicator.name("Choppiness Index (Bar View)");
    indicator.description("The indicator measures the market's trendiness (below 38.20) versus the market's choppiness (values above 61.80)");
    indicator.requiredSource(core.Bar);
    indicator.type(core.Oscillator);

    indicator.parameters.addGroup("Calculation");
    indicator.parameters.addInteger("X", "Choppiness period (in bars)", "", 14, 2, 1000);
    indicator.parameters.addGroup("Style");
    indicator.parameters.addColor("C", "Choppy Color", "", core.rgb(255, 0, 0));
    indicator.parameters.addColor("T", "Trendy Color", "", core.rgb(0, 255, 0));
    indicator.parameters.addGroup("Levels");
    indicator.parameters.addDouble("LOT", "Trend", "", 38.2, 0, 150);
    indicator.parameters.addDouble("LOM", "Middle", "", 50, 0, 150);
    indicator.parameters.addDouble("LOC", "Choppy", "", 61.8, 0, 150);
    indicator.parameters.addDouble("LOC1", "Consolidation", "", 100, 0, 150);
    indicator.parameters.addBoolean("SLOC1", "Show Consolidation Level", "", false);
    indicator.parameters.addBoolean("SLOC0", "Show Zero Level", "", false);
    indicator.parameters.addColor("LC", "Color", "", core.COLOR_CUSTOMLEVEL);
    indicator.parameters.addInteger("LW", "Width", "", 1, 1, 5);
    indicator.parameters.addInteger("LS", "Style", "", 1, 1, core.LINE_DOT);
    indicator.parameters.setFlag("LS", core.FLAG_LEVEL_STYLE);
}

var source;
var atr;
var first;
var x, l10x;
var d, out, out1;
var C, T;

function Prepare(onlyName)
{
    var name = profile.id() + "(" + instance.source.name() + "," + instance.parameters.X + ")";
    instance.name(name);
    if (onlyName) 
    {
        return ;
    }

    source = instance.source;
    atr = core.indicators.create("ATR", source, 1);
    x = instance.parameters.X;
    C = instance.parameters.C;
    T = instance.parameters.T;
    l10x = Math.log10(x);
    first = Math.max(source.first() + x - 1, atr.DATA.first() + x - 1);
    d = instance.addStream("CHOP_IDX", core.Line, name + ".D", "D", C, first);
    out = instance.addInternalStream(first, 0);
    out.setWidth(100);
    out1 = instance.addInternalStream(first, 0);
    instance.createFromToBarGroup("CHOP_IDX", "CHOP_IDX", out, out1, C);

    if (instance.parameters.SLOC0) 
    {
        d.addLevel(0, core.LINE_NONE, 1, core.rgb(0, 0, 0));
    }
    d.addLevel(instance.parameters.LOT, instance.parameters.LS, instance.parameters.LW, instance.parameters.LC);
    d.addLevel(instance.parameters.LOM, instance.parameters.LS, instance.parameters.LW, instance.parameters.LC);
    d.addLevel(instance.parameters.LOC, instance.parameters.LS, instance.parameters.LW, instance.parameters.LC);
    if (instance.parameters.SLOC1) 
    {
        d.addLevel(instance.parameters.LOC1, instance.parameters.LS, instance.parameters.LW, instance.parameters.LC);
    }
}

function Update(period, mode)
{
    if (period >= first) 
    {
        atr.update(mode);
        var tmp=Math.minmax(source, period - x + 1, period);
        var ll=tmp[0];
        var hh=tmp[1];
        var s = Math.sum(atr.DATA, period - x + 1, period);
        out[period] = 100.0 * Math.log10(s / (hh - ll)) / l10x;
        out1[period] = 50.0;
        if (out[period] >= 50.0) 
        {
            out.setColor(period, C);
        }    
        else
        {
            out.setColor(period, T);
        }
    }
}

