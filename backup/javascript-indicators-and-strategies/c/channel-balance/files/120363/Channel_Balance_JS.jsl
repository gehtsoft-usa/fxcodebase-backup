function Init()
{
    indicator.name("ChannelBalance");
    indicator.description("ChannelBalance");
    indicator.requiredSource(core.Bar);
    indicator.type(core.Oscillator);

	
	indicator.parameters.addGroup("Calculation");
    indicator.parameters.addInteger("PERIOD", "PERIOD", "PERIOD", 20);
	
	indicator.parameters.addGroup("Line Style");
    indicator.parameters.addColor("CB_Color", " Channel Balance Line Color", "", core.rgb(255, 0, 0));	

	indicator.parameters.addInteger("width", "Line Width", "", 1, 1, 5);
    indicator.parameters.addInteger("style", "Line Style", "", core.LINE_SOLID);
	indicator.parameters.setFlag("style", core.FLAG_LINE_STYLE);
}

var PERIOD;

var first;
var source = null;

var ChannelBalance = null;
var TEMP;

function Prepare(nameOnly)
{
    PERIOD = instance.parameters.PERIOD;
    source = instance.source;
    first = source.first()+PERIOD;
	
	TEMP=instance.addInternalStream (0, 0)
	
    var name = profile.id() + "(" + source.name() + ", " + tostring(PERIOD) + ")";
    instance.name(name);

    if (!(nameOnly)) 
    {
        ChannelBalance = instance.addStream("ChannelBalance", core.Line, name, "ChannelBalance", instance.parameters.CB_Color, first);
		ChannelBalance.setWidth(instance.parameters.width);
	    ChannelBalance.setStyle(instance.parameters.style);
    }
}

function Update(period)
{
    if (period < first  || !source.hasData(period)) 
    {	
	 return;
	}
	
	var min, max;
	var tmp=Math.minmax (source, period-PERIOD, period);
	min=tmp[0];
	max=tmp[1];
    
    var Range = max - min;
    
	TEMP[period] = (source.median[period] - min) / Range;
	
	var  SUM = Math.sum (TEMP, period-PERIOD, period);

    ChannelBalance[period] = (SUM / PERIOD)*100;
    
}

