function Init()
{
    indicator.name("Clear Method Histogram");
    indicator.description("The indicator detects market direction changes using Ron Black's 'Getting Clear With Short-Term Swings' described in Sep 2010 issue of Stock & Commodities");
    indicator.requiredSource(core.Bar);
    indicator.type(core.Oscillator);

    indicator.parameters.addGroup("Style");
    indicator.parameters.addColor("Up", "Up Swing Line Color", "", core.rgb(0, 255, 255));
    indicator.parameters.addColor("Dn", "Down Swing Line Color", "", core.rgb(255, 0, 255)); 

}

var source;
var hh, hl, lh, ll, swing;
var Clear;

function Prepare()
{
    var name;

    source = instance.source;
    first = source.first();

    name = profile.id() + "(" + source.name() + ")";
    instance.name(name);

    hh = instance.addInternalStream(0, 0);
    ll = instance.addInternalStream(0, 0);
    lh = instance.addInternalStream(0, 0);
    hl = instance.addInternalStream(0, 0);
    swing = instance.addInternalStream(0, 0);

    
    Clear = instance.addStream("Clear", core.Bar, name + ".Clear", "Clear",  core.rgb(128, 128, 128), first);
 
}

function Update(period, mode)
{
    if (period < first) 
    {
        swing[period] = 0;
    }
    else if (period == first) 
    {
        swing[period] = 0;
        hh[period] = source.high[period];
        lh[period] = source.high[period];
        hl[period] = source.low[period];
        ll[period] = source.low[period];
    }
    else if (period > first) 
    {
        swing[period] = swing[period - 1];
        hh[period] = Math.max(source.high[period], hh[period - 1]);
        lh[period] = Math.min(source.high[period], lh[period - 1]);
        hl[period] = Math.max(source.low[period], hl[period - 1]);
        ll[period] = Math.min(source.low[period], ll[period - 1]);
    }

    if (swing[period] > 0) 
    {
        if (source.high[period] < hl[period]) 
        {
            swing[period] = -1;      // up swing
            ll[period] = source.low[period];
            lh[period] = source.high[period];
        }
    }
    else if (swing[period] < 0) 
    {
        if (source.low[period] > lh[period]) 
        {
            swing[period] = 1;     // down swing
            hh[period] = source.high[period];
            hl[period] = source.low[period];
        }
    }
    else
    {
        if (source.high[period] < hl[period]) 
        {
            swing[period] = -1;      // up swing
            ll[period] = source.low[period];
            lh[period] = source.high[period];
        }
        else if (source.low[period] > hl[period]) 
        {
            swing[period] = 1;     // down swing
            hh[period] = source.high[period];
            hl[period] = source.low[period];
        }
    }

    if (swing[period] > 0) 
    {
        Clear[period] = source.high[period] - hl[period];     
        Clear.setColor(period, instance.parameters.Up); 		
    }
    else if (swing[period] < 0) 
    {
       Clear[period] = lh[period]-source.low[period];
	   Clear.setColor(period, instance.parameters.Dn);
       
    }
}
