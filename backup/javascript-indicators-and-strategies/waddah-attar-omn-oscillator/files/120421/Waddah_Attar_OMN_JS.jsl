function Init()
{
    indicator.name("Waddah Attar OMN indicator");
    indicator.description("Waddah Attar OMN indicator");
    indicator.requiredSource(core.Tick);
    indicator.type(core.Oscillator);

    indicator.parameters.addGroup("Calculation");
    indicator.parameters.addInteger("FastPeriod", "FastPeriod", "", 60);
    indicator.parameters.addInteger("SlowPeriod", "SlowPeriod", "", 120);
    indicator.parameters.addInteger("BBPeriod", "BBPeriod", "", 20);
    indicator.parameters.addInteger("BBDeviation", "BBDeviation", "", 2);

    indicator.parameters.addGroup("Style");
    indicator.parameters.addColor("clrUP", "Color UP", "Color UP", core.rgb(0, 255, 0));
    indicator.parameters.addColor("clrDN", "Color DN", "Color DN", core.rgb(255, 0, 0));
}

var first;
var source = null;
var FastPeriod;
var SlowPeriod;
var BBPeriod;
var BBDeviation;
var MACD;
var BB;
var BuffUP=null;
var BuffDN=null;

function Prepare()
{
    source = instance.source;
    FastPeriod=instance.parameters.FastPeriod;
    SlowPeriod=instance.parameters.SlowPeriod;
    BBPeriod=instance.parameters.BBPeriod;
    BBDeviation=instance.parameters.BBDeviation;
    MACD = core.indicators.create("MACD", source, FastPeriod, SlowPeriod, 2);
    BB = core.indicators.create("BB", source, BBPeriod, BBDeviation);
    first = Math.max(MACD.DATA.first(),BB.DATA.first())+2;
    var name = profile.id() + "(" + source.name() + ", " + instance.parameters.FastPeriod + ", " + instance.parameters.SlowPeriod + ", " + instance.parameters.BBPeriod + ", " + instance.parameters.BBDeviation + ")";
    instance.name(name);
    BuffUP = instance.addStream("BuffUP", core.Bar, name + ".UP", "UP", instance.parameters.clrUP, first);
    BuffDN = instance.addStream("BuffDN", core.Bar, name + ".DN", "DN", instance.parameters.clrDN, first);
}

function Update(period, mode)
{
   if (period>first) 
   {
    MACD.update(mode);
    BB.update(mode);
    var Trend=(MACD.DATA[period]-MACD.DATA[period-1])/source.pipSize();
    var Explo=(BB.TL[period]-BB.BL[period])/source.pipSize();
    var val=Trend*Explo;
    if (val>=0) 
    {
     BuffUP[period]=val;
    } 
    else
    {
     BuffDN[period]=val;
    }
   } 
    
}

