function Init()
{
    indicator.name("Blau Ergodic Candlestick Index");
    indicator.description("Blau Ergodic Candlestick Index");
    indicator.requiredSource(core.Bar);
    indicator.type(core.Oscillator);

    indicator.parameters.addGroup("Calculation");

    indicator.parameters.addInteger("Period", "Period", "", 10);
    indicator.parameters.addInteger("Smooth_Period1", "Smooth Period 1", "", 10);
    indicator.parameters.addInteger("Smooth_Period2", "Smooth Period 2", "", 10);
    indicator.parameters.addInteger("Smooth_Period3", "Smooth Period 3", "", 10);
    indicator.parameters.addInteger("Signal_Period", "Signal Period", "", 10);

    indicator.parameters.addString("Price1", "Price 1", "", "close");
    indicator.parameters.addStringAlternative("Price1", "close", "", "close");
    indicator.parameters.addStringAlternative("Price1", "open", "", "open");
    indicator.parameters.addStringAlternative("Price1", "high", "", "high");
    indicator.parameters.addStringAlternative("Price1", "low", "", "low");
    indicator.parameters.addStringAlternative("Price1", "median", "", "median");
    indicator.parameters.addStringAlternative("Price1", "typical", "", "typical");
    indicator.parameters.addStringAlternative("Price1", "weighted", "", "weighted");

    indicator.parameters.addString("Price2", "Price 2", "", "close");
    indicator.parameters.addStringAlternative("Price2", "close", "", "close");
    indicator.parameters.addStringAlternative("Price2", "open", "", "open");
    indicator.parameters.addStringAlternative("Price2", "high", "", "high");
    indicator.parameters.addStringAlternative("Price2", "low", "", "low");
    indicator.parameters.addStringAlternative("Price2", "median", "", "median");
    indicator.parameters.addStringAlternative("Price2", "typical", "", "typical");
    indicator.parameters.addStringAlternative("Price2", "weighted", "", "weighted");


   
    indicator.parameters.addGroup("Style");

    indicator.parameters.addColor("clr", "Blau_CSI Line Color", "", core.rgb(188, 1, 209));
    indicator.parameters.addColor("clr1", "Signal Line Color", "", core.rgb(188, 1, 0));
    indicator.parameters.addInteger("line_width", "Line width", "", 3);
    indicator.parameters.addString("line_style" , "Blau_CSI Line Style", "", "Solid");
    indicator.parameters.addStringAlternative("line_style" , "Solid line", "", "Solid");
    indicator.parameters.addStringAlternative("line_style" , "Dot line", "", "Dot");
    indicator.parameters.addStringAlternative("line_style", "Dash line", "", "Dash");
    indicator.parameters.addStringAlternative("line_style" , "Dash-dot line", "", "Dash-dot");
    indicator.parameters.addString("line_style1" , "Signal Line Style", "", "Solid");
    indicator.parameters.addStringAlternative("line_style1" , "Solid line", "", "Solid");
    indicator.parameters.addStringAlternative("line_style1" , "Dot line", "", "Dot");
    indicator.parameters.addStringAlternative("line_style1", "Dash line", "", "Dash");
    indicator.parameters.addStringAlternative("line_style1" , "Dash-dot line", "", "Dash-dot");


}

var first;
var source = null;
var Period, Smooth_Period1, Smooth_Period2, Smooth_Period3, Signal_Period;
var  clr, clr1, line_style, line_style1, line_width;
var Price1, Price2;
var  Blau_CSI, Signal;
var CM, HH, CM_EMA3, HH_EMA3;
var Ind, Ind1, Ind2, Ind3, Signal1;

function Prepare()
{
    source = instance.source;
    first = source.first()+2;
    var name = profile.id() + "(" + source.name()+ ")";
    instance.name(name);
    
    clr=instance.parameters.clr;
    clr1=instance.parameters.clr1;
    line_width=instance.parameters.line_width;
    line_style=instance.parameters.line_style; 
    line_style1=instance.parameters.line_style1; 
    Period=instance.parameters.Period;
    Smooth_Period1=instance.parameters.Smooth_Period1;
    Smooth_Period2=instance.parameters.Smooth_Period2;
    Smooth_Period3=instance.parameters.Smooth_Period3;
    Signal_Period=instance.parameters.Signal_Period;
    Price1=instance.parameters.Price1;
    Price2=instance.parameters.Price2;



    Blau_CSI = instance.addStream("Blau_CSI", core.Line, name + ".Blau_CSI", "Blau_CSI", instance.parameters.clr, first);

    if (line_style =="Solid") 
    {
        Blau_CSI.setStyle (core.LINE_SOLID);
    }
    else if (line_style=="Dot") 
    {
        Blau_CSI.setStyle (core.LINE_DOT);
    }
    else if (line_style=="Dash") 
    {
        Blau_CSI.setStyle (core.LINE_DASH);
    }
    else if (line_style=="Dash-dot") 
    {
        Blau_CSI.setStyle (core.LINE_DASHDOT);
    }  

    Blau_CSI.setWidth (line_width);

    Signal = instance.addStream("Signal", core.Line, name + ".Signal", "Signal", instance.parameters.clr1, first);

    if (line_style1 =="Solid") 
    {
        Signal.setStyle (core.LINE_SOLID);
    }
    else if (line_style1=="Dot") 
    {
        Signal.setStyle (core.LINE_DOT);
    }
    else if (line_style1=="Dash") 
    {
        Signal.setStyle (core.LINE_DASH);
    }
    else if (line_style1=="Dash-dot") 
    {
        Signal.setStyle (core.LINE_DASHDOT);
    }  

    Signal.setWidth (line_width);

    CM = instance.addInternalStream(first);
    HH = instance.addInternalStream(first);

    Ind=core.indicators.create("EMA", CM, Smooth_Period1);
    Ind1=core.indicators.create("EMA", Ind.DATA, Smooth_Period2);
    CM_EMA3=core.indicators.create("EMA", Ind1.DATA, Smooth_Period3);

    Ind2=core.indicators.create("EMA", HH, Smooth_Period1);
    Ind3=core.indicators.create("EMA", Ind2.DATA, Smooth_Period2);
    HH_EMA3=core.indicators.create("EMA", Ind3.DATA, Smooth_Period3);

    Signal1=core.indicators.create("EMA", Blau_CSI, Signal_Period);

}

function Update(period, mode)
{    

    if (period>first+Period+Signal_Period+Smooth_Period1+Smooth_Period2+Smooth_Period3) 
    {
        var i;
        var max = 0;
        var min = 10000000;
        for (i=period-Period+1; i<=period; i++) 
        {
            max=Math.max(max, source.high[i]);
            min=Math.min(min, source.low[i]);
        }
        HH[period]=max-min;
        CM[period]=source[Price1][period]-source[Price2][period-Period+1];
        Ind.update(mode);
        Ind1.update(mode);
        CM_EMA3.update(mode);
        Ind2.update(mode);
        Ind3.update(mode);
        HH_EMA3.update(mode);
        if (HH_EMA3.DATA[period]!=0) 
        {
            Blau_CSI[period] = 100*CM_EMA3.DATA[period]/HH_EMA3.DATA[period];
        }
        Signal1.update(mode);
        Signal[period]=Signal1.DATA[period];
    }
}

