function Init()
{
    indicator.name("William Blau Stochastic");
    indicator.description("William Blau Stochastic");
    indicator.requiredSource(core.Bar);
    indicator.type(core.Oscillator);

    indicator.parameters.addGroup("Calculation");
    indicator.parameters.addInteger("Period", "Period", "", 5);
    indicator.parameters.addInteger("Smooth_Period1", "Smooth period 1", "", 20);
    indicator.parameters.addInteger("Smooth_Period2", "Smooth period 2", "", 5);
    indicator.parameters.addInteger("Smooth_Period3", "Smooth period 3", "", 3);
    indicator.parameters.addString("Price", "Price", "", "close");
    indicator.parameters.addStringAlternative("Price", "close", "", "close");
    indicator.parameters.addStringAlternative("Price", "open", "", "open");
    indicator.parameters.addStringAlternative("Price", "high", "", "high");
    indicator.parameters.addStringAlternative("Price", "low", "", "low");
    indicator.parameters.addStringAlternative("Price", "median", "", "median");
    indicator.parameters.addStringAlternative("Price", "typical", "", "typical");
    indicator.parameters.addStringAlternative("Price", "weighted", "", "weighted");

    indicator.parameters.addGroup("Style");
    indicator.parameters.addColor("clr", "Color", "Color", core.rgb(255, 255, 0));
    indicator.parameters.addInteger("widthLinReg", "Line width", "Line width", 1, 1, 5);
    indicator.parameters.addInteger("styleLinReg", "Line style", "Line style", core.LINE_SOLID);
    indicator.parameters.setFlag("styleLinReg", core.FLAG_LINE_STYLE);
}

var first;
var source = null;
var Period;
var Smooth_Period1;
var Smooth_Period2;
var Smooth_Period3;
var Price;
var Stoch;
var EMA1, EMA2, EMA3;
var Blau_TStoch=null;

function Prepare()
{
    source = instance.source;
    Period=instance.parameters.Period;
    Smooth_Period1=instance.parameters.Smooth_Period1;
    Smooth_Period2=instance.parameters.Smooth_Period2;
    Smooth_Period3=instance.parameters.Smooth_Period3;
    Price=instance.parameters.Price;
    first = source.first()+2;
    Stoch = instance.addInternalStream(first, 0);
    EMA1 = core.indicators.create("EMA", Stoch, Smooth_Period1);
    EMA2 = core.indicators.create("EMA", EMA1.DATA, Smooth_Period2);
    EMA3 = core.indicators.create("EMA", EMA2.DATA, Smooth_Period3);
    var name = profile.id() + "(" + source.name() + ", " + instance.parameters.Period + ", " + instance.parameters.Smooth_Period1 + ", " + instance.parameters.Smooth_Period2 + ", " + instance.parameters.Smooth_Period3 + ")";
    instance.name(name);
    Blau_TStoch = instance.addStream("Blau_TStoch", core.Line, name + ".Blau_TStoch", "Blau_TStoch", instance.parameters.clr, first);
    Blau_TStoch.setWidth(instance.parameters.widthLinReg);
    Blau_TStoch.setStyle(instance.parameters.styleLinReg);
}

function Update(period, mode)
{
   if (period>first+Period) 
   {
    var tmp=Math.minmax(source.low, period-Period+1, period);
    var Min=tmp[0];
    Stoch[period]=source[Price][period]-Min;
    EMA1.update(mode);
    EMA2.update(mode);
    EMA3.update(mode);
    Blau_TStoch[period]=EMA3.DATA[period];
   } 
}

