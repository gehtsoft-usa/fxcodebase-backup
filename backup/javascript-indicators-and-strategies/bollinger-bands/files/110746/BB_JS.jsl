//initializes the indicator
function Init()
{
    indicator.name("Bollinger bands");
    indicator.description("Bollinger bands");
    indicator.requiredSource(core.Tick);
    indicator.type(core.Indicator);
    indicator.setTag("group", "Bollinger");

    indicator.parameters.addGroup("Calculation");
    indicator.parameters.addInteger("N", "Number of periods", "Number of periods.", 20);
    indicator.parameters.addDouble("Dev", "Deviation", "Deviation", 2);
    indicator.parameters.addGroup("Style");
    indicator.parameters.addColor("Bclr", "Band color", "The color of Band", core.rgb(0, 255, 0));
    indicator.parameters.addInteger("Bwidth", "Band width", "The width of Band", 1, 1, 5);
    indicator.parameters.addInteger("Bstyle", "Band style", "The style of Band", core.LINE_SOLID);
    indicator.parameters.setFlag("Bstyle", core.FLAG_LEVEL_STYLE);
    indicator.parameters.addBoolean("Hide", "Hide average line", "Hide average line", false);
    indicator.parameters.addColor("Aclr", "Average line color", "The color of Average line", core.rgb(255, 0, 0));
    indicator.parameters.addInteger("Awidth", "Average line width", "The width of Average line", 1, 1, 5);
    indicator.parameters.addInteger("Astyle", "Average line style", "The style of Average line", core.LINE_SOLID);
    indicator.parameters.setFlag("Astyle", core.FLAG_LEVEL_STYLE);
}

var first = 0;
var N, Dev, Hide;
var source = null;
var TL = null;
var BL = null;
var AL = null;

//initializes the instance of the indicator
function Prepare(onlyName)
{
    source = instance.source;
    N = instance.parameters.N;
    Dev = instance.parameters.Dev;
    Hide = instance.parameters.Hide;
    var name = profile.id() + "(" + instance.source.name() + "," + N + ", " + Dev + ")";
    instance.name(name);
  
    if (onlyName == true)
        return ;

    first = source.first();

    TL = instance.addStream("TL", core.Line, name, "TL", instance.parameters.Bclr,  first)
    TL.setWidth(instance.parameters.Bwidth);
    TL.setStyle(instance.parameters.Bstyle);
    BL = instance.addStream("BL", core.Line, name, "BL", instance.parameters.Bclr,  first)
    BL.setWidth(instance.parameters.Bwidth);
    BL.setStyle(instance.parameters.Bstyle);
    if (!Hide)
    {
        AL = instance.addStream("AL", core.Line, name, "AL", instance.parameters.Aclr,  first)
        AL.setWidth(instance.parameters.Awidth);
        AL.setStyle(instance.parameters.Astyle);
    }
}

// calculate the value
function Update(period, mode)
{
    if (period >= first+N)
    {
        var ml = Math.avg(source, period - N + 1, period);
        var d = Math.stdev(source, period - N + 1, period);
        var Dd = Dev * d;
        TL[period] = ml + Dd;
        BL[period] = ml - Dd;
        if (AL != nil)
        {
            AL[period] = ml;
        }
    }
}