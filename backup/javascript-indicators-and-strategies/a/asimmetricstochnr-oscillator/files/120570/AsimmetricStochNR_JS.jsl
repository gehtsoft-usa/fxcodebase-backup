function Init()
{
    indicator.name("AsimmetricStochNR indicator");
    indicator.description("AsimmetricStochNR indicator");
    indicator.requiredSource(core.Bar);
    indicator.type(core.Oscillator);

    indicator.parameters.addGroup("Calculation");
    indicator.parameters.addInteger("KPeriodShort", "%K short", "", 5);
    indicator.parameters.addInteger("KPeriodLong", "%K long", "", 12);
    indicator.parameters.addInteger("DPeriod", "%D", "", 1);
    indicator.parameters.addInteger("Slowing", "Slowing", "", 3);
    indicator.parameters.addString("DMethod", "DMethod", "", "MVA");
    indicator.parameters.addStringAlternative("DMethod", "MVA", "", "MVA");
    indicator.parameters.addStringAlternative("DMethod", "EMA", "", "EMA");
    indicator.parameters.addString("PriceField", "PriceField", "", "High/Low");
    indicator.parameters.addStringAlternative("PriceField", "High/Low", "", "High/Low");
    indicator.parameters.addStringAlternative("PriceField", "Close", "", "Close");
    indicator.parameters.addInteger("Sensitivity", "Sensitivity", "", 7);
    indicator.parameters.addInteger("OverSold", "OverSold", "", 20);
    indicator.parameters.addInteger("OverBought", "OverBought", "", 80);

    indicator.parameters.addGroup("Style");
    indicator.parameters.addColor("MainClr", "Main Color", "Main Color", core.rgb(0, 255, 0));
    indicator.parameters.addColor("SignalClr", "Signal Color", "Signal Color", core.rgb(255, 0, 0));
    indicator.parameters.addInteger("widthLinReg", "Line width", "Line width", 1, 1, 5);
    indicator.parameters.addInteger("styleLinReg", "Line style", "Line style", core.LINE_SOLID);
    indicator.parameters.setFlag("styleLinReg", core.FLAG_LINE_STYLE);
}

var first;
var source = null;
var KPeriodShort;
var KPeriodLong;
var DPeriod;
var Slowing;
var DMethod;
var PriceField;
var Sensitivity;
var OverSold;
var OverBought;
var BuffMain=null;
var BuffSignal=null;
var MinPeriod;
var MinStream,MaxStream;
var Trend;
var kd;

function Prepare()
{
    source = instance.source;
    KPeriodShort=instance.parameters.KPeriodShort;
    KPeriodLong=instance.parameters.KPeriodLong;
    DPeriod=instance.parameters.DPeriod;
    Slowing=instance.parameters.Slowing;
    DMethod=instance.parameters.DMethod;
    PriceField=instance.parameters.PriceField;
    Sensitivity=instance.parameters.Sensitivity;
    OverSold=instance.parameters.OverSold;
    OverBought=instance.parameters.OverBought;
    first = source.first()+2;
    var name = profile.id() + "(" + source.name() + ", " + instance.parameters.KPeriodShort + ", " + instance.parameters.KPeriodLong + ", " + instance.parameters.DPeriod + ", " + instance.parameters.Slowing + ", " + instance.parameters.DMethod + ", " + instance.parameters.PriceField + ", " + instance.parameters.Sensitivity + ", " + instance.parameters.OverSold + ", " + instance.parameters.OverBought + ")";
    instance.name(name);
    Trend = instance.addInternalStream(first, 0);
    BuffMain = instance.addStream("BuffMain", core.Line, name + ".Main", "Main", instance.parameters.MainClr, first);
    BuffSignal = instance.addStream("BuffSignal", core.Line, name + ".Signal", "Signal", instance.parameters.SignalClr, first);
    BuffMain.setWidth(instance.parameters.widthLinReg);
    BuffMain.setStyle(instance.parameters.styleLinReg);
    BuffSignal.setWidth(instance.parameters.widthLinReg);
    BuffSignal.setStyle(instance.parameters.styleLinReg);
    MinPeriod=Math.max(KPeriodShort,KPeriodLong)+Slowing;
    if (PriceField=="High/Low") 
    {
     MinStream=source.low;
     MaxStream=source.high;
    } 
    else
    {
     MinStream=source.close;
     MaxStream=source.close;
    }
    kd=2/(1+DPeriod);
    BuffMain.addLevel(OverSold);    
    BuffMain.addLevel(OverBought);    
}

function Update(period, mode)
{
   if (period>first+MinPeriod) 
   {
    var max=0;
    var min=0;
    var c=0;
    var i;
    var Period1,Period2;
    if (Trend[period-1]==0) 
    {
     Period1=KPeriodLong;
     Period2=KPeriodShort;
    } 
    else
    {
     Period1=KPeriodShort;
     Period2=KPeriodLong;
    }
    for (i=period; i>=period-Slowing+1; i--) 
    {
     var tmp=Math.minmax(MaxStream, i-Period1+1, i);
     max=max+tmp[1];
     min=min+tmp[0];
     c=c+source.close[i];
    }
    var delta=max-min;
    var diff=Sensitivity*Slowing*source.pipSize()-delta;
    if (diff>0) 
    {
     delta=Sensitivity*Slowing*source.pipSize();
     min=min-diff/2;
    }
    if (delta==0) 
    {
     BuffMain[period]=0;
    } 
    else
    {
     BuffMain[period]=100*(c-min)/delta;
    }
    if (DMethod=="MVA") 
    {
     BuffSignal[period]=kd*BuffMain[period]+(1-kd)*BuffSignal[period-1];
    } 
    else
    {
     BuffSignal[period]=(BuffSignal[period-1]*DPeriod-BuffMain[period-DPeriod]+BuffMain[period])/DPeriod;
    }
    if (BuffSignal[period-1]>OverBought) 
    {
     Trend[period]=1; 
    } 
    else if (BuffSignal[period-1]<OverSold) 
    {
     Trend[period]=0;
    } 
    else
    {
     Trend[period]=Trend[period-1];
    }
   } 
   else if (period>=first) 
   {
    Trend[period]=0;
    BuffMain[period]=50;
    BuffSignal[period]=50; 
   } 
}

