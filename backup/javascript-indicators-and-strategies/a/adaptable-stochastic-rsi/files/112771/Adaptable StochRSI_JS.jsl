// Indicator profile initialization routine
// Defines indicator profile properties && indicator parameters
function Init()
{
    indicator.name("Adaptable Stochastic RSI");
    indicator.description("");
    indicator.requiredSource(core.Tick);
    indicator.type(core.Oscillator);
 
    indicator.parameters.addGroup("Calculation");
    indicator.parameters.addInteger("N", "Number of periods for RSI", "", 14, 1, 200);
    indicator.parameters.addInteger("K", "%K Stochastic Periods", "", 14, 1, 200);
	
    indicator.parameters.addGroup("K Line Smoothing  Calculation");
    indicator.parameters.addInteger("N1", "Number of periods to smooth", "", 8, 1, 10000);
    indicator.parameters.addString("Method1" , "Method for avegage", "", "EMA");
	indicator.parameters.addStringAlternative("Method1", "EMA", "", "EMA");
    indicator.parameters.addStringAlternative("Method1" , "MVA", "", "MVA");  
    indicator.parameters.addStringAlternative("Method1" , "LWMA", "", "LWMA");	
	indicator.parameters.addStringAlternative("Method1" , "KAMA", "", "KAMA");	
	indicator.parameters.addStringAlternative("Method1" , "SMMA", "", "SMMA");	
	indicator.parameters.addStringAlternative("Method1" , "TMA", "", "TMA");	
	indicator.parameters.addStringAlternative("Method1" , "VIDYA", "", "VIDYA");	
	indicator.parameters.addStringAlternative("Method1" , "WMA", "", "WMA");	
	
	 indicator.parameters.addGroup("D Line Smoothing   Calculation");
    indicator.parameters.addInteger("N2", "Number of periods to smooth", "", 8, 1, 10000);
	indicator.parameters.addString("Method2" , "Method for avegage", "", "EMA");
	indicator.parameters.addStringAlternative("Method2", "EMA", "", "EMA");
    indicator.parameters.addStringAlternative("Method2" , "MVA", "", "MVA");  
    indicator.parameters.addStringAlternative("Method2" , "LWMA", "", "LWMA");	
	indicator.parameters.addStringAlternative("Method2" , "KAMA", "", "KAMA");	
	indicator.parameters.addStringAlternative("Method2" , "SMMA", "", "SMMA");	
	indicator.parameters.addStringAlternative("Method2" , "TMA", "", "TMA");	
	indicator.parameters.addStringAlternative("Method2" , "VIDYA", "", "VIDYA");	
	indicator.parameters.addStringAlternative("Method2" , "WMA", "", "WMA");	

	
   	indicator.parameters.addGroup("K Line Style");
	 indicator.parameters.addColor("K_color", "Color of K", "Color of K", core.rgb(0, 255, 0));
	 indicator.parameters.addInteger("K_width", "Width", "Width", 1, 1, 5);
    indicator.parameters.addInteger("K_style", "Style", "Style", core.LINE_SOLID);
    indicator.parameters.setFlag("K_style", core.FLAG_LINE_STYLE);
	indicator.parameters.addGroup("D Line Style");
    indicator.parameters.addColor("D_color", "Color of D", "Color of D", core.rgb(255, 0, 0));
	 indicator.parameters.addInteger("D_width", "Width", "Width", 1, 1, 5);
    indicator.parameters.addInteger("D_style", "Style", "Style", core.LINE_SOLID);
    indicator.parameters.setFlag("D_style", core.FLAG_LINE_STYLE);
}

var N;
var K;
var KS;
var D;

var firstSKI;
var firstK;
var firstD;
var source = null;

// Streams block
var SKI = null;
var SK = null;
var SD = null;
var RSI = null;
var MVA1 = null;
var MVA2 = null;
var N1, N2, P1,P2,Method1, Method2;
// Routine
function Prepare()
{
    K = instance.parameters.K;
    N = instance.parameters.N;
    N1= instance.parameters.N1;
	P1= instance.parameters.P1;
	N2= instance.parameters.N2;
	P2= instance.parameters.P2;
	Method2= instance.parameters.Method2;
	Method1= instance.parameters.Method1;

    source = instance.source;
    first = source.first();

    RSI = core.indicators.create("RSI", source, N);
    var name = profile.id() + "(" + source.name() + ", " + N + ", " + K + ", " + N1+ ", " + Method1 + ", " + N2 +", " + Method2+ ")";
    instance.name(name);
    firstSKI = RSI.DATA.first() + K;
    SKI = instance.addInternalStream(firstSKI, 0);
	
	
    MVA1 = core.indicators.create(Method1, SKI,  N1  );
    firstK = MVA1.DATA.first();
    SK = instance.addStream("K", core.Line, name + ".K", "K", instance.parameters.K_color, firstK);
	SK.setWidth(instance.parameters.K_width);
    SK.setStyle(instance.parameters.K_style);
    SK.addLevel(20);
    SK.addLevel(50);
    SK.addLevel(80);
    MVA2 = core.indicators.create(Method1, SK,  N2 );
    firstD = MVA2.DATA.first();
    SD = instance.addStream("D", core.Line, name + ".D", "D", instance.parameters.D_color, firstD);
	SD.setWidth(instance.parameters.D_width);
    SD.setStyle(instance.parameters.D_style);
}

// Indicator calculation routine
function Update(period, mode)
{
    RSI.update(mode);

    if (period >= firstSKI) 
    {
        var min, max;
        var range;
        range = core.rangeTo(period, K);
        var tmp = Math.minmax(RSI.DATA, period-K+1, period);
        min=tmp[0];
        max=tmp[1];
        if (min == max) 
        {
            SKI[period] = 100;
        }    
        else
        {
            SKI[period] = (RSI.DATA[period] - min) / (max - min) * 100;
        }
    }

    MVA1.update(mode);

    if (period >= firstK) 
    {
        SK[period] = MVA1.DATA[period];
    }

    MVA2.update(mode);

    if (period >= firstD) 
    {
        SD[period] = MVA2.DATA[period];
    }
}

