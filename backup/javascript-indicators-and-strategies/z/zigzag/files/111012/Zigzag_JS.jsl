//initializes the indicator
function Init()
{
    indicator.name("ZigZag");
    indicator.description("ZigZag");
    indicator.requiredSource(core.Bar);
    indicator.type(core.Indicator);
    indicator.setTag("group", "Swing");

    indicator.parameters.addGroup("Calculation");
    indicator.parameters.addInteger("Depth", "Depth", "Depth", 12, 1, 10000);
    indicator.parameters.addInteger("Deviation", "Deviation", "Deviation", 5, 1, 1000);
    indicator.parameters.addInteger("Backstep", "Backstep", "Backstep", 3, 1, 10000);
    
    indicator.parameters.addGroup("Style");
    indicator.parameters.addColor("Zig_color", "Up swing color", "Up swing color", core.rgb(0, 255, 0));
    indicator.parameters.addColor("Zag_color", "Down swing color", "Down swing color", core.rgb(255, 0, 0));
    indicator.parameters.addInteger("widthZigZag", "Line width","Line width", 1, 1, 5);
    indicator.parameters.addInteger("styleZigZag", "Line style", "Line style", core.LINE_SOLID);
    indicator.parameters.setFlag("styleZigZag", core.FLAG_LEVEL_STYLE);
}

var Depth;
var Deviation;
var Backstep;

var first;
var source = null;

var ZigC;
var ZagC;
var out;
var HighMap = null;
var LowMap = null;

var searchBoth = 0;
var searchPeak = 1;
var searchLawn = -1;
var lastlow = null;
var lashhigh = null;

var peak_count = 0;


var lastperiod = -1;

//initializes the instance of the indicator
function Prepare(onlyName)
{
    Depth = instance.parameters.Depth;
    Deviation = instance.parameters.Deviation;
    Backstep = instance.parameters.Backstep;
    source = instance.source;
    first = source.first();

    var name = profile.id() + "(" + source.name() + ", " + Depth + ", " + Deviation + ", " + Backstep + ")";
    instance.name(name);
    out = instance.addStream("out", core.Line, name, "Up", instance.parameters.Zig_color, first);
    out.setWidth(instance.parameters.widthZigZag);
    out.setStyle(instance.parameters.styleZigZag);
    ZigC = instance.parameters.Zig_color;
    ZagC = instance.parameters.Zag_color;

    HighMap = instance.addInternalStream(0, 0);
    LowMap = instance.addInternalStream(0, 0);
    SearchMode = instance.addInternalStream(0, 0);
    Peak = instance.addInternalStream(0, 0);
}

function GetPeak(offset)
{
    var peak;
    peak = peak_count + offset;
    if (peak < 1)
    {
        return -1;
    }
    
    peak = out.getBookmark(peak);
    if (peak < 0)
    {
        return -1;
    }
    
    return peak;
}

function ReplaceLastPeak(period, mode, peak)
{
    out.setBookmark(peak_count, period);
    SearchMode[period] = mode;
    Peak[period] = peak;
}

function RegisterPeak(period, mode, peak)
{
    peak_count = peak_count + 1;
    out.setBookmark(peak_count, period);
    SearchMode[period] = mode;
    Peak[period] = peak;
}

function Update(period, mode)
{
    period = period - 1;
    var tmp;
    var i;

    if (period == lastperiod)
    {
        return ;
    }

    if (period < lastperiod)
    {
        lastlow = nil;
        lasthigh = nil;
        peak_count = 0;
    }

    lastperiod = period;

    if (period >= Depth)
    {
        var range = period - Depth + 1;
        var val;
        var i;
        tmp = Math.minmax(source.low, range, period);
        val=tmp[0];
        if (val == lastlow)
        {
            val = nil;
        }
        else
        {
            lastlow = val;
            if ((source.low[period] - val) > (source.pipSize() * Deviation))
            {
               val = nil;
            }
            else
            {
                for (i = period - 1; i>=period - Backstep + 1; i--)
                {
                    if ((LowMap[i] != 0) && (LowMap[i] > val))
                    {
                        LowMap[i] = 0;
                    }
                }
            }
        }
                
        if (source.low[period] == val)
        {
            LowMap[period] = val;
        }
        else
        {
            LowMap[period] = 0;
        }
        
        tmp = Math.minmax(source.high, range, period);
        val=tmp[1];
        if (val == lasthigh)
        {
            val = nil;
        }
        else
        {
            lasthigh = val;
            if ((val - source.high[period]) > (source.pipSize() * Deviation))
            {
               val = nil;
            }
            else
            {
                for (i = period - 1; i>=period - Backstep + 1; i--)
                {
                    if ((HighMap[i] != 0) && (HighMap[i] < val))
                    {
                        HighMap[i] = 0;
                    }
                }
            }
        }
        
        if (source.high[period] == val)
        {
            HighMap[period] = val;
        }
        else
        {
            HighMap[period] = 0
        }

        var start;
        var last_peak;
        var last_peak_i;
        var prev_peak;
        var searchMode = searchBoth;

        i = GetPeak(-4);
        if (i == -1)
        {
            prev_peak = nil;
        }
        else
        {
            prev_peak = i;
        }

        start = Depth;
        i = GetPeak(-3);
        if (i == -1)
        {
            last_peak_i = nil;
            last_peak = nil;
        }
        else
        {
            last_peak_i = i;
            last_peak = Peak[i];
            searchMode = SearchMode[i];
            start = i;
        }
        
        peak_count = peak_count - 3;

        for (i = start; i<=period; i++)
        {
            if (searchMode == searchBoth)
            {
                if (HighMap[i] != 0)
                {
                    last_peak_i = i;
                    last_peak = HighMap[i];
                    searchMode = searchLawn;
                    RegisterPeak(i, searchMode, last_peak);
                }
                else
                {
                    if (LowMap[i] != 0)
                    {
                        last_peak_i = i;
                        last_peak = LowMap[i];
                        searchMode = searchPeak;
                        RegisterPeak(i, searchMode, last_peak);
                    }
                }
            }
            else
            {
                if (searchMode == searchPeak)
                {
                    if (LowMap[i] != 0 && LowMap[i] < last_peak)
                    {
                        last_peak = LowMap[i];
                        last_peak_i = i;
                        if (prev_peak != null)
                        {
                            if (Peak[prev_peak] > LowMap[i])
                            {
                                core.drawLine(out, core.range(prev_peak, i), Peak[prev_peak], prev_peak, LowMap[i], i, ZagC);
                                out.setColor(prev_peak, ZigC);
                            }
                            else
                            {
                                core.drawLine(out, core.range(prev_peak, i), Peak[prev_peak], prev_peak, LowMap[i], i, ZigC);
                                out.setColor(prev_peak, ZagC);
                            }
                        }
                        ReplaceLastPeak(i, searchMode, last_peak);
                    }
                    if (HighMap[i] != 0 && LowMap[i] == 0)
                    {
                        core.drawLine(out, core.range(last_peak_i, i), last_peak, last_peak_i, HighMap[i], i, ZigC);
                        out.setColor(last_peak_i, ZagC);
                        prev_peak = last_peak_i;
                        last_peak = HighMap[i];
                        last_peak_i = i;
                        searchMode = searchLawn;
                        RegisterPeak(i, searchMode, last_peak);
                    }
                }
                else
                {
                    if (searchMode == searchLawn)
                    {
                        if (HighMap[i] != 0 && HighMap[i] > last_peak)
                        {
                            last_peak = HighMap[i];
                            last_peak_i = i;
                            if (prev_peak != null)
                            {
                                core.drawLine(out, core.range(prev_peak, i), Peak[prev_peak], prev_peak, HighMap[i], i, ZigC);
                                out.setColor(prev_peak, ZagC);
                            }
                            ReplaceLastPeak(i, searchMode, last_peak);
                        }
                        if (LowMap[i] != 0 && HighMap[i] == 0)
                        {
                            if  (last_peak > LowMap[i])
                            {
                                core.drawLine(out, core.range(last_peak_i, i), last_peak, last_peak_i, LowMap[i], i, ZagC);
                                out.setColor(last_peak_i, ZigC);
                            }
                            else
                            {
                                core.drawLine(out, core.range(last_peak_i, i), last_peak, last_peak_i, LowMap[i], i, ZigC);
                                out.setColor(last_peak_i, ZagC);
                            }
                            prev_peak = last_peak_i;
                            last_peak = LowMap[i];
                            last_peak_i = i;
                            searchMode = searchPeak;
                            RegisterPeak(i, searchMode, last_peak);
                        }
                    }
                }
            }
        }
    }
}
