function Init()
{
    indicator.name("Consecutive Candle Count");
    indicator.description("Consecutive Candle Count");
    indicator.requiredSource(core.Tick);
    indicator.type(core.Indicator);
    indicator.parameters.addGroup("Calculation");
    indicator.parameters.addInteger("Period", "Period", "Period", 0);

    indicator.parameters.addGroup("Style");		
    indicator.parameters.addColor("color", "Label Color", "Color of Label", core.rgb(255, 0, 0));
	indicator.parameters.addInteger("Size", "Font Size", "Size", 15);
}

var first;
var source = null;
var Count;
var Period;
var min, max; 
var Size;

function Prepare(nameOnly)
{
    source = instance.source;
    first = source.first();
    Period=instance.parameters.Period;
	Size=instance.parameters.Size;
	
    var name = profile.id() + "(" + source.name() + ")";
    instance.name(name);
 
    Count = instance.addInternalStream(0, 0);
	
	instance.ownerDrawn(true);

}

function Update(period)
{   
   
   if (source[period]> source[period-1]) 
   {
   
	   if (Count[period-1]<0) 
	   {
	    Count[period]=1;
	   } 
	   else
	   {
	    Count[period]= Count[period-1]+1;
	   }
   }
   else if (source[period]< source[period-1]) 
   {
        if (Count[period-1]>0) 
        {
	     Count[period]=-1;
	    } 
	    else
	    {
	    Count[period]= Count[period-1]-1;
	    }
   } 
   else
   { 
       Count[period]=0;
   }
   
   
     var tmp;
	 if (period == source.size()-1) 
	 {
	   if (Period == 0) 
	   {
	   	tmp=Math.minmax(Count, source.first(), source.size()-1);
	   	min=tmp[0];
	   	max=tmp[1];
	   } 
	   else
	   {
	   	tmp=Math.minmax(Count, Math.max(source.first(), (source.size()-1-Period+1)), source.size()-1);
	   	min=tmp[0];
	   	max=tmp[1];
	   }
	 }
   
   
}

var init = false;
 
function Draw(stage, context)
{
    if (stage != 2) 
    {
	 return;
	}
	
        if (!init) 
        {
             context.createFont (1, "Arial", Size, Size, 0)
            init = true;
        }
   
     text1="Up Trend . " + tostring(max);
	 text2="Down Trend . " + tostring(Math.abs(min));
	 
	
	 var tmp;
	 tmp=context.measureText (1, text1, 0);
	 width1=tmp[0];
	 height1=tmp[1];

	 tmp=context.measureText (1, text2, 0);
	 width2=tmp[0];
	 height2=tmp[1];
	 
	 var MAX= Math.max(width1,width2);
	 
     context.drawText (1, text1, instance.parameters.color, -1,  context.right ()-MAX, context.top (), context.right (), context.top ()+ height1, context.LEFT);
	 context.drawText (1, text2, instance.parameters.color, -1, context.right ()-MAX, context.top ()+height1, context.right (), context.top () +height1*2, context.LEFT);   
	   
}
 

