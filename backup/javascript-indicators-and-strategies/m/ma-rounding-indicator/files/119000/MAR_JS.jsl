function Init()
{
    indicator.name("MA Rounding");
    indicator.description("MA Rounding");
    indicator.requiredSource(core.Tick);
    indicator.type(core.Indicator);
    indicator.parameters.addGroup("Calculation");	 
    indicator.parameters.addInteger("Period", "Period", "Period", 8);
	indicator.parameters.addString("Method", "MA Method", "Method" , "MVA");
    indicator.parameters.addStringAlternative("Method", "MVA", "MVA" , "MVA");
    indicator.parameters.addStringAlternative("Method", "EMA", "EMA" , "EMA");
    indicator.parameters.addStringAlternative("Method", "LWMA", "LWMA" , "LWMA");
    indicator.parameters.addStringAlternative("Method", "TMA", "TMA" , "TMA");
    indicator.parameters.addStringAlternative("Method", "SMMA", "SMMA" , "SMMA");
    indicator.parameters.addStringAlternative("Method", "KAMA", "KAMA" , "KAMA");
    indicator.parameters.addStringAlternative("Method", "VIDYA", "VIDYA" , "VIDYA");
    indicator.parameters.addStringAlternative("Method", "WMA", "WMA" , "WMA");
    indicator.parameters.addDouble("Round", "Round", "Round", 13);
	indicator.parameters.addGroup("Style");
    indicator.parameters.addColor("MAR_color", "Color of MAR", "Color of MAR", core.rgb(255, 0, 0));
	indicator.parameters.addInteger("width", "Line width", "", 1, 1, 5);
    indicator.parameters.addInteger("style", "Line style", "", core.LINE_SOLID);
    indicator.parameters.setFlag("style", core.FLAG_LINE_STYLE);
}

var Period;
var Round;
var Method;
var first;
var source = null;
var MaRo;

var MAR = null;
var MA;
var MovAle;

function Prepare(nameOnly)
{
    Period = instance.parameters.Period;
    Round = instance.parameters.Round;
	Method = instance.parameters.Method;
    source = instance.source;
	MA = core.indicators.create(Method, source, Period);
	MovAle= instance.addInternalStream(0, 0);
    first =MA.DATA.first();
	
	MaRo=Round*source.pipSize();

    var name = profile.id() + "(" + source.name() + ", " + tostring(Period) + ", " + tostring(Round) + ", " + tostring(Method) + ")";
    instance.name(name);

    if (!(nameOnly)) 
    {
        MAR = instance.addStream("MAR", core.Line, name, "MAR", instance.parameters.MAR_color, first);
		MAR.setWidth(instance.parameters.width);
        MAR.setStyle(instance.parameters.style);
    }
}

function Update(period, mode) 
{
    MA.update(mode);
	
	if (period < first) 
  {
	 return;
	}
	
	Rounding (period) ;
      
    
}

function Rounding (period)                                              
{                                                                   
    if (MA.DATA[period]>MA.DATA[period-1]+MaRo || MA.DATA[period]<MA.DATA[period-1]-MaRo || MA.DATA[period]> MAR[period-1]+MaRo || MA.DATA[period]< MAR[period-1]-MaRo || (MA.DATA[period]> MAR[period-1] && MovAle[period-1]==1) || (MA.DATA[period]< MAR[period-1] && MovAle[period-1]==-1))
     {            
          MAR[period] =MA.DATA[period];                                    
     }
     else
     {                                                               
          MAR[period]= MAR[period-1];    
	   }	  
		
      if (MAR[period]< MAR[period-1]) 
      { 
        MovAle[period] =-1; 
      }               
      if (MAR[period]> MAR[period-1]) 
      { 
        MovAle[period] =1; 
      }                 
      if (MAR[period]== MAR[period-1]) 
      { 
        MovAle[period] =MovAle[period-1]; 
      }     
																   
																   
																   
  }

