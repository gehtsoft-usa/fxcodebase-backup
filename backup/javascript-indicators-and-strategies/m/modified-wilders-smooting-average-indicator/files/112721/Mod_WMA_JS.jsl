function Init()
{
    indicator.name("Modified Wilders smooting average indicator");
    indicator.description("Modified Wilders smooting average indicator");
    indicator.requiredSource(core.Tick);
    indicator.type(core.Indicator);

    indicator.parameters.addGroup("Calculation");
    indicator.parameters.addInteger("Period", "Period", "", 10);

    indicator.parameters.addGroup("Style");
    indicator.parameters.addColor("clr", "Color", "Color", core.rgb(255, 255, 0));
    indicator.parameters.addInteger("widthLinReg", "Line width", "Line width", 1, 1, 5);
    indicator.parameters.addInteger("styleLinReg", "Line style", "Line style", core.LINE_SOLID);
    indicator.parameters.setFlag("styleLinReg", core.FLAG_LINE_STYLE);
}

var first;
var source = null;
var Period;
var k;
var Mod_WMA=null

function Prepare()
{
    source = instance.source;
    Period=instance.parameters.Period;
    first = source.first()+2;
    var name = profile.id() + "(" + source.name() + ", " + instance.parameters.Period + ")";
    instance.name(name);
    Mod_WMA = instance.addStream("Mod_WMA", core.Line, name + ".Mod_WMA", "Mod_WMA", instance.parameters.clr, first);
    Mod_WMA.setWidth(instance.parameters.widthLinReg);
    Mod_WMA.setStyle(instance.parameters.styleLinReg);
    k=1/Period;
}

function Update(period, mode)
{
   if (period>first+Period) 
   {
    Mod_WMA[period]=(Math.avg(source, period-Period + 1, period)-Mod_WMA[period-1])*k+Mod_WMA[period-1];
   } 
   else
   {
    if (period==first+Period) 
    {
    Mod_WMA[period]=Math.avg(source, period-Period + 1, period);
    } 
   } 
}

