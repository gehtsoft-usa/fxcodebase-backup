function Init()
{
    indicator.name("Ahoora indicator");
    indicator.description("Ahoora indicator");
    indicator.requiredSource(core.Bar);
    indicator.type(core.Indicator);

    indicator.parameters.addGroup("Calculation");
    indicator.parameters.addInteger("Period", "Period", "", 25);
    indicator.parameters.addString("Method", "Method", "", "MVA");
    indicator.parameters.addStringAlternative("Method", "MVA", "", "MVA");
    indicator.parameters.addStringAlternative("Method", "EMA", "", "EMA");
    indicator.parameters.addStringAlternative("Method", "KAMA", "", "KAMA");
    indicator.parameters.addStringAlternative("Method", "Wilder", "", "Wilder");
    indicator.parameters.addStringAlternative("Method", "LWMA", "", "LWMA");
    indicator.parameters.addStringAlternative("Method", "SineWMA", "", "SineWMA");
    indicator.parameters.addStringAlternative("Method", "TriMA", "", "TriMA");
    indicator.parameters.addStringAlternative("Method", "LSMA", "", "LSMA");
    indicator.parameters.addStringAlternative("Method", "SMMA", "", "SMMA");
    indicator.parameters.addStringAlternative("Method", "HMA", "", "HMA");
    indicator.parameters.addStringAlternative("Method", "ZeroLagEMA", "", "ZeroLagEMA");
    indicator.parameters.addStringAlternative("Method", "DEMA", "", "DEMA");
    indicator.parameters.addStringAlternative("Method", "T3", "", "T3");
    indicator.parameters.addStringAlternative("Method", "ITrend", "", "ITrend");
    indicator.parameters.addStringAlternative("Method", "Median", "", "Median");
    indicator.parameters.addStringAlternative("Method", "GeoMean", "", "GeoMean");
    indicator.parameters.addStringAlternative("Method", "REMA", "", "REMA");
    indicator.parameters.addStringAlternative("Method", "ILRS", "", "ILRS");
    indicator.parameters.addStringAlternative("Method", "IE/2", "", "IE/2");
    indicator.parameters.addStringAlternative("Method", "TriMAgen", "", "TriMAgen");
    indicator.parameters.addStringAlternative("Method", "JSmooth", "", "JSmooth");

    indicator.parameters.addGroup("Style");
    indicator.parameters.addColor("MainClr", "Main Color", "Main Color", core.rgb(0, 255, 0));
    indicator.parameters.addColor("UPclr", "UP Color", "UP Color", core.rgb(255, 0, 0));
    indicator.parameters.addColor("DNclr", "DN Color", "DN Color", core.rgb(0, 0, 255));
    indicator.parameters.addInteger("widthLinMain", "Main line width", "Main line width", 1, 1, 5);
    indicator.parameters.addInteger("styleLinMain", "Main line style", "Main line style", core.LINE_SOLID);
    indicator.parameters.setFlag("styleLinMain", core.FLAG_LINE_STYLE);
    indicator.parameters.addInteger("widthLinUpDn", "UP&DN line width", "UP&DN line width", 3, 1, 5);
    indicator.parameters.addInteger("styleLinUpDn", "UP&DN line style", "UP&DN line style", core.LINE_SOLID);
    indicator.parameters.setFlag("styleLinUpDn", core.FLAG_LINE_STYLE);
}

var first;
var source = null;
var Period;
var Method;
var MA_H;
var MA_L;
var ATR;
var Buff=null;
var BuffUP=null;
var BuffDN=null;

function Prepare()
{
    source = instance.source;
    Period=instance.parameters.Period;
    Method=instance.parameters.Method;
    first = source.first()+2;
    MA_H = core.indicators.create("AVERAGES", source.high, Method, Period, false);
    MA_L = core.indicators.create("AVERAGES", source.low, Method, Period, false);
    ATR = core.indicators.create("ATR", source, Period);
    var name = profile.id() + "(" + source.name() + ", " + instance.parameters.Period + ", " + instance.parameters.Method + ")";
    instance.name(name);
    Buff = instance.addStream("Buff", core.Line, name + ".Main", "Main", instance.parameters.MainClr, first);
    BuffUP = instance.addStream("BuffUP", core.Line, name + ".UP", "UP", instance.parameters.UPclr, first);
    BuffDN = instance.addStream("BuffDN", core.Line, name + ".DN", "DN", instance.parameters.DNclr, first);
    Buff.setWidth(instance.parameters.widthLinMain);
    Buff.setStyle(instance.parameters.styleLinMain);
    BuffUP.setWidth(instance.parameters.widthLinUpDn);
    BuffUP.setStyle(instance.parameters.styleLinUpDn);
    BuffDN.setWidth(instance.parameters.widthLinUpDn);
    BuffDN.setStyle(instance.parameters.styleLinUpDn);
}

function Update(period, mode)
{
   if (period>first) 
   {
    MA_H.update(mode);
    MA_L.update(mode);
    ATR.update(mode);
    var buffer=0;
    if (source.high[period]>MA_H.DATA[period]) 
    { 
     buffer=1
    }
    else if (source.low[period]<MA_L.DATA[period]) 
    {
     buffer=-1;
    } 
    if (buffer<0) 
    {
     Buff[period]=MA_H.DATA[period]-ATR.DATA[period];
     BuffUP[period]=Buff[period];
    }
    else
    {
     Buff[period]=MA_L.DATA[period]+ATR.DATA[period];
     BuffDN[period]=Buff[period];
    }
   } 
}

