function Init()
{
    indicator.name("Hodrick-Prescott Filter");
    indicator.description("Hodrick-Prescott Filter");
    indicator.requiredSource(core.Bar);
    indicator.type(core.Indicator);
	indicator.parameters.addGroup("Calculation");
    indicator.parameters.addInteger("Filter", "HP Filter Period", "", 50);
	
	indicator.parameters.addGroup("Style");
    indicator.parameters.addColor("HPF_color", "Color of HPF", "Color of HPF", core.rgb(255, 0, 0));
	indicator.parameters.addInteger("width", "Line Width", "", 1, 1, 5);
    indicator.parameters.addInteger("style", "DEMA Line Style", "", core.LINE_SOLID);
	indicator.parameters.setFlag("style", core.FLAG_LEVEL_STYLE);	
}

var Filter;
var Smooth;

var first;
var source = null;

     var HPF = null;
     var lambda;

function Prepare()
{
    Filter = instance.parameters.Filter;
    source = instance.source;
    first = source.first();
	
	 lambda=0.0625/Math.pow(Math.sin(3.14159265/Filter), 4);
	 
	a=instance.addInternalStream (first, 0);
	b=instance.addInternalStream (first, 0);
	c=instance.addInternalStream (first, 0);	 

    var name = profile.id() + "(" + source.name() + ", " +Filter + ")";
    instance.name(name);
    HPF = instance.addStream("HPF", core.Line, name, "HPF", instance.parameters.HPF_color, first+Filter);
	HPF.setWidth(instance.parameters.width);
	HPF.setStyle(instance.parameters.style);
}

function Update(period,mode)
{
    if (period >= first +2 && source.hasData(period)) 
    {  
	 
          if (period == source.size()-1) 
          { 

			 HPFF(period);
	      }
	   
    }    
}

function HPFF (N)
 {   
	var i=N;
     var h1=0;
	 var h2=0;
	 var h3=0;
	 var h4=0;
	 var h5=0;
	 var hh1=0;
	 var hh2=0;
	 var hh3=0;
	 var hh5=0;
	 var hb=0;
	 var hc=0;
	 var z=0;
 
  
  a[1]=1+lambda;
   b[1]=-2*lambda;
   c[1]=lambda;
   
    
   for (i= 2; i<=N-2; i++) 
   {   
     a[i]=6*lambda+1;
     b[i]=-4*lambda;
     c[i]=lambda;
   }   
   
  a[2]=5*lambda+1; 
  a[N]=1+lambda;
  a[N-1]=5*lambda+1;  
  b[N-1]=-2*lambda;
  
  b[N]=0;
  c[N-1]=0;
  c[N]=0; 

   for (i=  1; i<=N; i++) 
   {
   
      z=a[i]-h4*h1-hh5*hh2;  
	 
	  
      hb=b[i];
      hh1=h1;
	  if (z!= 0) 
    {
      h1=(hb-h4*h2)/z;
	  }
      b[i]=h1;
      hc=c[i];
      hh2=h2;
	  if (z!= 0) 
    {
      h2=hc/z;
	  }
      c[i]=h2;
	  if (z!= 0) 
    {
     a[i]=(source.open[i]-hh3*hh5-h3*h4)/z;
	  }
      hh3=h3;
      h3=a[i];
      h4=hb-h5*hh1;
      hh5=h5;
      h5=hc;
   }

   h2=0;
   h1=a[1];
   HPF[1]=h1;
   for (i= N; i>=1; i--) 
   {
       if (a[i]!= null && b[i]!= null && c[i]!= null) 
       {
      HPF[i]=a[i]-b[i]*h1-c[i]*h2;
	  }
      h2=h1;
      h1=HPF[i];
   }
   
}
