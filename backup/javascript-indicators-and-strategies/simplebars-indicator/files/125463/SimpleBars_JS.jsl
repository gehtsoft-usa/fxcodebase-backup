function Init()
{
    indicator.name("Simple bars indicator");
    indicator.description("Simple bars indicator");
    indicator.requiredSource(core.Bar);
    indicator.type(core.Indicator);

    indicator.parameters.addGroup("Calculation");
    indicator.parameters.addInteger("Period", "Period", "", 6);
    indicator.parameters.addBoolean("UseClose", "Use close", "", true);

    indicator.parameters.addGroup("Style");
    indicator.parameters.addColor("UPclr", "UP Color", "UP Color", core.rgb(0, 255, 0));
    indicator.parameters.addColor("DNclr", "DN Color", "DN Color", core.rgb(255, 0, 0));
}

var first;
var source = null;
var Period;
var UseClose;
var trend;
var open=null;
var high=null;
var low=null;
var close=null;

function Prepare()
{
    source = instance.source;
    Period=instance.parameters.Period;
    UseClose=instance.parameters.UseClose;
    first = source.first()+2;
    trend=instance.addInternalStream(first, 0);
    var name = profile.id() + "(" + source.name() + ", " + instance.parameters.Period + ")";
    instance.name(name);
    open = instance.addStream("open", core.Line, name, "open", core.rgb(0, 0, 0), first)
    high = instance.addStream("high", core.Line, name, "high", core.rgb(0, 0, 0), first)
    low = instance.addStream("low", core.Line, name, "low", core.rgb(0, 0, 0), first)
    close = instance.addStream("close", core.Line, name, "close", core.rgb(0, 0, 0), first)
    instance.createCandleGroup("SimpleBars", "", open, high, low, close);
}

function Update(period, mode)
{
   if (period>first+Period) 
   {
    open[period]=source.open[period];
    high[period]=source.high[period];
    low[period]=source.low[period];
    close[period]=source.close[period];
    var buyPrice;
    var sellPrice;
    var j;
    if (UseClose) 
    {
     buyPrice=source.close[period];
     sellPrice=source.close[period];
    } 
    else
    {
     buyPrice=source.low[period];
     sellPrice=source.high[period];
    }
    if (trend[period-1]==0 || trend[period-1]==null) 
    {
     if (source.close[period]>source.open[period]) 
     {
      trend[period]=1;
     } 
     else
     {
      trend[period]=-1;
     }
    } 
    else
    {
     if (trend[period-1]==1) 
     {
      if (buyPrice>source.low[period-1]) 
      {
       trend[period]=1;
      } 
      else
      {
       for (j=2; j<=Period; j++) 
       {
        if (buyPrice>source.low[period-j]) 
        {
         trend[period]=1;
         break;
        } 
        else
        {
         trend[period]=-1;
        }
       }
      }
     } 
     else if (trend[period-1]==-1) 
     {
      if (sellPrice<source.high[period-1]) 
      {
       trend[period]=-1;
      } 
      else
      {
       for (j=2; j<=Period; j++) 
       {
        if (sellPrice<source.high[period-j]) 
        {
         trend[period]=-1;
         break;
        } 
        else
        {
         trend[period]=1;
        }
       }
      }
     }
    }
    if (trend[period]==-1) 
    {
     open.setColor(period, instance.parameters.DNclr);
    } 
    else if (trend[period]==1) 
    {
     open.setColor(period, instance.parameters.UPclr);
    }
   } 
}

