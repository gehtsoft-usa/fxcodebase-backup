function Init()
{
    indicator.name("AMA Optimum indicator");
    indicator.description("AMA Optimum indicator");
    indicator.requiredSource(core.Tick);
    indicator.type(core.Indicator);

    indicator.parameters.addGroup("Calculation");
    indicator.parameters.addInteger("Period", "Period", "", 100);
    indicator.parameters.addInteger("Fast_Period", "Fast period", "", 2);
    indicator.parameters.addInteger("Slow_Period", "Slow period", "", 10);

    indicator.parameters.addGroup("Style");
    indicator.parameters.addColor("clr", "Color", "Color", core.rgb(255, 255, 0));
    indicator.parameters.addInteger("widthLinReg", "Line width", "Line width", 1, 1, 5);
    indicator.parameters.addInteger("styleLinReg", "Line style", "Line style", core.LINE_SOLID);
    indicator.parameters.setFlag("styleLinReg", core.FLAG_LINE_STYLE);
}

var first;
var source = null;
var Period;
var Fast_Period;
var Slow_Period;
var NoiseSt;
var Slow_SC, Fast_SC;
var AMA_Opt=null;

function Prepare()
{
    source = instance.source;
    Period=instance.parameters.Period;
    Fast_Period=instance.parameters.Fast_Period;
    Slow_Period=instance.parameters.Slow_Period;
    first = source.first()+2;
    NoiseSt = instance.addInternalStream(first, 0);
    var name = profile.id() + "(" + source.name() + ", " + instance.parameters.Period + ", " + instance.parameters.Fast_Period + ", " + instance.parameters.Slow_Period + ")";
    instance.name(name);
    AMA_Opt = instance.addStream("AMA_Opt", core.Line, name + ".AMA_Opt", "AMA_Opt", instance.parameters.clr, first);
    AMA_Opt.setWidth(instance.parameters.widthLinReg);
    AMA_Opt.setStyle(instance.parameters.styleLinReg);
    Slow_SC=2/(1+Slow_Period);
    Fast_SC=2/(1+Fast_Period);
}

function Update(period, mode)
{
   if (period>first) 
   {
    NoiseSt[period]=Math.abs(source[period]-source[period-1]);
    AMA_Opt[period]=null;
    if (period>first+Period) 
    {
     var Signal=Math.abs(source[period]-source[period-Period]);
     var Noise=Math.sum(NoiseSt, period-Period+1, period);
     var ER=1;
     if (Noise>0) 
     {
      ER=Signal/Noise;
     }
     var SSC=Math.pow(Slow_SC+ER*(Fast_SC-Slow_SC), 2);
     AMA_Opt[period]=SSC*source[period]+(1-SSC)*AMA_Opt[period-1];
    }
    else if (period==first+Period) 
    {
     AMA_Opt[period]=source[period]; 
    }
   } 
}

