//initializes the indicator
function Init()
{
    indicator.name("Stochastic");
    indicator.description("Stochastic");
    indicator.requiredSource(core.Bar);
    indicator.type(core.Oscillator);
    indicator.setTag("group", "Classic Oscillators");

    indicator.parameters.addGroup("Calculation");
    indicator.parameters.addInteger("K", "Number of periods for %K", "Number of periods for %K", 5, 2, 1000);
    indicator.parameters.addInteger("SD", "%D slowing periods", "%D slowing periods", 3, 2, 1000);
    indicator.parameters.addInteger("D", "Number of periods for %D", "Number of periods for %D", 3, 2, 1000);
    indicator.parameters.addString("MVAT_K", "Smoothing type for %K", "Smoothing type for %K", "MVA");
    indicator.parameters.addStringAlternative("MVAT_K", "MVA", "MVA", "MVA");
    indicator.parameters.addStringAlternative("MVAT_K", "EMA", "EMA", "EMA");
    indicator.parameters.addStringAlternative("MVAT_K", "Fast smoothed", "FS", "FS");

    indicator.parameters.addString("MVAT_D", "Smoothing type for %D", "Smoothing type for %D", "MVA");
    indicator.parameters.addStringAlternative("MVAT_D", "MVA", "MVA", "MVA");
    indicator.parameters.addStringAlternative("MVAT_D", "EMA", "EMA", "EMA");
    indicator.parameters.addGroup("Style");
    indicator.parameters.addColor("clr1", "%K Line color", "The color of %K line", core.rgb(0, 255, 0));
    indicator.parameters.addInteger("width1", "%K Line width", "The width of %K line", 1, 1, 5);
    indicator.parameters.addInteger("style1", "%K Line style", "The style of %K line", core.LINE_SOLID);
    indicator.parameters.setFlag("style1", core.FLAG_LEVEL_STYLE);
    indicator.parameters.addColor("clr2", "%D Line color", "The color of %D line", core.rgb(255, 0, 0));
    indicator.parameters.addInteger("width2", "%D Line width", "The width of %D line", 1, 1, 5);
    indicator.parameters.addInteger("style2", "%D Line style", "The style of %D line", core.LINE_SOLID);
    indicator.parameters.setFlag("style2", core.FLAG_LEVEL_STYLE);
}

var first = 0;
var k = 0;
var sd = 0;
var d = 0;
var averageTypeK, averageTypeD;
var source = null;
var K = null;
var D = null;
var mins, maxes, FastK, fastKFirst, mva, isFS, signalLine;
var dFirst, kFirst

//initializes the instance of the indicator
function Prepare(onlyName)
{
    source = instance.source;
    k = instance.parameters.K;
    sd = instance.parameters.SD;
    d = instance.parameters.D;
    averageTypeK = instance.parameters.MVAT_K;
    averageTypeD = instance.parameters.MVAT_D;
    var name = profile.id() + "(" + instance.source.name() + "," + k + ", " + sd + ", " + d + ")";
    instance.name(name);
  
    if (onlyName == true)
        return ;
    mins = instance.addInternalStream(source.first() + k, 0);
    maxes = instance.addInternalStream(source.first() + k, 0);
    FastK = instance.addInternalStream(mins.first(), 0);

    fastkFirst = FastK.first();

    if (averageTypeK != "FS")
    {
        mva = core.indicators.create(averageTypeK, FastK, sd);
        isFS = false;
    }
    else
    {
        isFS = true;
    }

    K = instance.addStream("K", core.Line, name, "K", instance.parameters.clr1,  first)
    K.setWidth(instance.parameters.width1);
    K.setStyle(instance.parameters.style1);
    signalLine = core.indicators.create(averageTypeD, K, d);
    D = instance.addStream("D", core.Line, name, "D", instance.parameters.clr2,  first)
    D.setWidth(instance.parameters.width2);
    D.setStyle(instance.parameters.style2);
    dFirst = D.first();
    kFirst = K.first();
}

// calculate the value
function Update(period, mode)
{
    if (period >= fastkFirst)
    {
        var tmp = Math.minmax(source, period - k + 1, period);
        minLow=tmp[0];
        maxHigh=tmp[1];
        mins[period] = source.close[period] - minLow;
        maxes[period] = maxHigh - minLow;
        if (maxes[period] > 0)
        {
            FastK[period] = mins[period] / maxes[period] * 100;
        }
        else
        {
            FastK[period] = 50;
        }
    }
    if (isFS == false)
    {
        mva.update(mode);
        if (period >= kFirst)
        {
            K[period] = mva.DATA[period];
        }
    }
    else
    {
        if (period >= kFirst)
        {
            var sumMax = Math.sum(maxes, period - sd + 1, period);
            if (sumMax == 0)
            {
                K[period] = 50;
            }
            else
            {
                var sumMin = Math.sum(mins, period - sd + 1, period);
                K[period] = sumMin / sumMax * 100;
            }
        }
    }
    signalLine.update(mode);
    if (period >= dFirst)
    {
        D[period] = signalLine.DATA[period];
    }
}