function Init()
{
    indicator.name("Volatility Ratio");
    indicator.description("Volatility Ratio");
    indicator.requiredSource(core.Bar);
    indicator.type(core.Oscillator);
    indicator.parameters.addGroup("Calculation");
    indicator.parameters.addInteger("Period", "Period", "Period", 14);
   
	
	indicator.parameters.addGroup("Style");
	 indicator.parameters.addColor("VR_color", "Color of VR", "Color of VR", core.rgb(255, 0, 0));
	indicator.parameters.addInteger("width", "Line width", "", 1, 1, 5);
    indicator.parameters.addInteger("style", "Line style", "", core.LINE_SOLID);
    indicator.parameters.setFlag("style", core.FLAG_LINE_STYLE);
}

var Period;

var first;
var source = null;

var VR = null; 

function getTrueRange(period)
{
    var hl = Math.abs(source.high[period] - source.low[period]);
    var hc = Math.abs(source.high[period] - source.close[period - 1]);
    var lc = Math.abs(source.low[period] - source.close[period - 1]);

    var tr = hl;
    if (tr < hc) 
    {
        tr = hc;
    }
    if (tr < lc) 
    {
        tr = lc;
    }
    return (tr);
}

function Prepare(nameOnly)
{
    Period = instance.parameters.Period;
    source = instance.source;
	 
    first = source.first()+1 + Period;

    var name = profile.id() + "(" + source.name() + ", " + tostring(Period) + ")";
    instance.name(name);

    if (!(nameOnly)) 
    {
        VR = instance.addStream("VR", core.Line, name, "VR", instance.parameters.VR_color, first);
		VR.setWidth(instance.parameters.width);
        VR.setStyle(instance.parameters.style);
    }
}

function Update(period)
{ 
     var tr = getTrueRange(period);
    if (period < first || !source.hasData(period)) 
    {
	 return;
	}
	
	var tmp = Math.minmax(source, period-Period+1, period);
    var min=tmp[0];
    var max=tmp[1];
	var pr = Math.max(max,source.open[period-Period+1])-Math.min (min,source.open[period-Period+1] );
	
   VR[period] = tr/pr;
    
}

