//initializes the indicator
function Init()
{
    indicator.name("EWO");
    indicator.description("Elliot Wave Oscillator");
    indicator.requiredSource(core.Bar);
    indicator.type(core.Oscillator);
    indicator.setTag("group", "Waves");

    indicator.parameters.addGroup("Calculation");
    indicator.parameters.addInteger("FastN", "Fast MA periods", "Fast MA periods.", 5);
    indicator.parameters.addInteger("SlowN", "Slow MA periods", "Slow MA periods.", 35);

    indicator.parameters.addString("Source", "Price source", "Price source", "M2");
    indicator.parameters.addStringAlternative("Source", "Typical (H+L+C)/3", "Typical (H+L+C)/3", "M3");
    indicator.parameters.addStringAlternative("Source", "Median (H+L)/2", "Median (H+L)/2", "M2");
    indicator.parameters.addStringAlternative("Source", "Close", "Close", "C");

    indicator.parameters.addString("Method", "Smoothing method", "Smoothing method", "MVA");
    indicator.parameters.addStringAlternative("Method", "MVA", "", "MVA");
    indicator.parameters.addStringAlternative("Method", "EMA", "", "EMA");
    indicator.parameters.addStringAlternative("Method", "LWMA", "", "LWMA");
    indicator.parameters.addStringAlternative("Method", "SMMA", "", "SMMA");
    indicator.parameters.addStringAlternative("Method", "Vidya (1995)", "", "VIDYA");
    indicator.parameters.addStringAlternative("Method", "Vidya (1992)*", "", "VIDYA92");
    indicator.parameters.addStringAlternative("Method", "Wilders", "", "WMA");
    
    indicator.parameters.addGroup("Style");
    indicator.parameters.addColor("UGclr", "Upper growing bar color", "Upper growing bar color", core.rgb(0, 255, 0));
    indicator.parameters.addColor("UFclr", "Upper falling bar color", "Upper falling bar color", core.rgb(0, 127, 0));
    indicator.parameters.addColor("LGclr", "Lower growing bar color", "Lower growing bar color", core.rgb(127, 0, 0));
    indicator.parameters.addColor("LFclr", "Lower falling bar color", "Lower falling bar color", core.rgb(255, 0, 0));
}

var first = 0;
var first1 = 0;
var source = null;
var EWO = null;
var srcmode;
var FMA, SMA;
var UPGROW, UPFALL, DNGROW, DNFALL;

//initializes the instance of the indicator
function Prepare(onlyName)
{
    source = instance.source;
    srcmode = instance.parameters.Source;

    var SRC;
    
    if (srcmode == "M3")
    {
        SRC = source.typical;
    }
    else
    {
        if (srcmode == "M2")
        {
            SRC = source.median;
        }
        else
         {
            SRC = source.close;
        }
    }
    
    FMA = core.indicators.create(instance.parameters.Method, SRC, instance.parameters.FastN);
    SMA = core.indicators.create(instance.parameters.Method, SRC, instance.parameters.SlowN);

    first = Math.max(SMA.DATA.first(), FMA.DATA.first());
    first1 = first + 1;

    var name = profile.id() + "(" + instance.source.name() + "," + n + ")";
    instance.name(name);
  
    if (onlyName == true)
        return ;

    EWO = instance.addStream("EWO", core.Bar, name, "EWO", instance.parameters.UGclr,  first)
    UPGROW = instance.parameters.UGclr;
    UPFALL = instance.parameters.UFclr;
    DNGROW = instance.parameters.LGclr;
    DNFALL = instance.parameters.LFclr;
    EWO.addLevel(0);
}

// calculate the value
function Update(period, mode)
{
    SMA.update(mode);
    FMA.update(mode);

    if (period >= first)
    {
        EWO[period] = FMA.DATA[period] - SMA.DATA[period];
    }

    if (period >= first1)
    {
        var curr = EWO[period];
        var prior = EWO[period - 1];
        if (curr >= 0)
        {
            if (curr > prior)
            {
                EWO.setColor(period, UPGROW);
            }
            else
            {
               if (curr < prior)
               {
                   EWO.setColor(period, UPFALL);
               }
               else
               {
                   EWO.setColor(period, EWO.colorI(period - 1));
               }
            }
        }
        else
        {
            if (curr < 0)
            {
                if (curr > prior)
                {
                    EWO.setColor(period, DNGROW);
                }
                else
                {
                    if (curr < prior)
                    {
                        EWO.setColor(period, DNFALL);
                    }
                    else
                    {
                        EWO.setColor(period, EWO.colorI(period - 1));
                    }
                }
            }
        }

    }
}